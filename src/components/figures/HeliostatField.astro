---
// Home hero: a heliostat field seen from the side, with the page's text in its sky (slot).
// The pointer is the sun; every mirror turns so the light lands on the receiver (the
// geometry of the owner's DLR thesis). Without a pointer the sun drifts slowly along a
// day arc, kept clear of the text and inside the visible slice; on load it first rises at the
// left of the field (the hero's only intro); with prefers-reduced-motion it stays put until
// moved. Without JS the field is the server-rendered picture at the resting sun position.
import {
  FIELD,
  ROWS,
  SUN_START,
  COST_SHEET,
  fieldEfficiency,
  f1,
  poses,
  LINKED_MIRROR,
  RING_R,
  SERVER_UNITS_PER_PX,
  rayOpacity,
  receiverGlow,
} from "../../lib/heliostat";

const front = ROWS.length - 1;
const start = poses(SUN_START.x, SUN_START.y);
const eff0 = fieldEfficiency(start, SUN_START.y);
const glow = receiverGlow(eff0);
// the costing sheet, in px inside its group (origin: its bottom-right corner); the server
// render uses the drawing's units per px at its own size (1.1333), the script refits it
const CS = COST_SHEET;
const U0 = SERVER_UNITS_PER_PX;
const { full: SF, mini: SM } = CS;
const barMax = 130;
const vMax = Math.max(...CS.rows.map((r) => r.v));
const L = LINKED_MIRROR;
const leadY = FIELD.ground - (CS.lift + SF.h / 2) * U0;
const { tower: T, receiver: R, ground } = FIELD;
---

<div class="field-wrap" data-field>
  <svg
    class="field"
    viewBox={`${FIELD.x0} 0 ${FIELD.w - FIELD.x0} ${FIELD.h}`}
    preserveAspectRatio="xMaxYMax slice"
    aria-hidden="true"
    data-field-svg
  >
    <defs>
      <radialGradient id="hf-halo">
        <stop offset="0" stop-color="var(--sun)" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="var(--sun)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <!-- light first, so posts, mirrors and tower sit on top of it.
         Incoming (sun to mirror): thin dashed steel, front row only (all rows made a moiré fan
         at the sun). Reflected (mirror to receiver): sun, for every row. -->
    <g class="rays-in">
      {
        start
          .filter((m) => m.row === front)
          .map((m) => <line x1={SUN_START.x} y1={SUN_START.y} x2={f1(m.px)} y2={f1(m.py)} />)
      }
    </g>
    <g class="rays-out">
      {
        start.map((m) => (
          <line x1={f1(m.px)} y1={f1(m.py)} x2={R.x} y2={R.y} style={`opacity:${rayOpacity(m).toFixed(2)}`} />
        ))
      }
    </g>

    <circle class="halo" cx={SUN_START.x} cy={SUN_START.y} r="70" data-halo></circle>
    <circle class="sun" cx={SUN_START.x} cy={SUN_START.y} r="20" data-sun></circle>

    <!-- Wirtschaft: a costing sheet on the ground, the counterpart to the solar tower -->
    <g class="cost" transform={`translate(${CS.x} ${FIELD.ground - CS.lift * U0}) scale(${U0})`} data-cost>
      <g class="sheet-full" transform="rotate(-1)">
        <rect class="paper" x={-SF.w} y={-SF.h} width={SF.w} height={SF.h}></rect>
        <text class="s-title" x={-SF.w + 20} y={-SF.h + 36}>Kalkulation je Heliostat</text>
        <line class="s-hair" x1={-SF.w + 20} x2={-20} y1={-SF.h + 50} y2={-SF.h + 50}></line>
        {
          CS.rows.map((r, i) => (
            <>
              <text class="s-lbl" x={-SF.w + 20} y={-SF.h + 84 + i * 30}>{r.name}</text>
              <rect class={`s-bar b${i}`} x={-20 - barMax} y={-SF.h + 72 + i * 30} width={(barMax * r.v) / vMax} height="13"></rect>
            </>
          ))
        }
        <line class="s-rule" x1={-SF.w + 20} x2={-20} y1={-SF.h + 166} y2={-SF.h + 166}></line>
        <text class="s-sum" x={-SF.w + 20} y={-SF.h + 196}>= Herstellkosten</text>
        <text class="s-total" x={-20} y={-SF.h + 199} text-anchor="end">≈ {CS.total}</text>
        <line class="s-rule thin" x1={-128} x2={-20} y1={-SF.h + 207} y2={-SF.h + 207}></line>
        <line class="s-rule thin" x1={-128} x2={-20} y1={-SF.h + 211} y2={-SF.h + 211}></line>
        <text class="s-note" x={-SF.w + 20} y={-14}>{CS.perM2}</text>
      </g>
      <g class="sheet-mini" transform="rotate(-1)">
        <rect class="paper" x={-SM.w} y={-SM.h} width={SM.w} height={SM.h}></rect>
        <text class="s-total small" x={-SM.w + 12} y={-SM.h + 30}>≈ {CS.total}</text>
        <text class="s-note" x={-SM.w + 12} y={-12}>je Heliostat</text>
      </g>
    </g>

    <!-- (far past both ends: the scaled-up drawing can show more than x0-w, the line closes the hero) -->
    <line class="ground" x1={FIELD.x0 - 4000} x2={FIELD.w + 4000} y1={ground} y2={ground}></line>
    <g class="posts">
      {start.map((m) => <line class={`r${m.row}`} x1={m.px} x2={m.px} y1={m.base} y2={m.py} />)}
    </g>
    <g class="mirrors">
      {start.map((m) => <line class={`r${m.row}`} x1={f1(m.x1)} y1={f1(m.y1)} x2={f1(m.x2)} y2={f1(m.y2)} />)}
    </g>

    <!-- the link between the two sides: from the sheet to the heliostat it prices -->
    <g class="link">
      <path class="leader" d={`M${CS.x} ${leadY.toFixed(1)} H${L.x} V${L.y - RING_R}`}></path>
      <circle class="ring" cx={L.x} cy={L.y} r={RING_R}></circle>
    </g>

    <rect class="tower" x={T.x} y={T.top} width={T.w} height={ground - T.top}></rect>
    <circle
      class="rec-glow"
      cx={R.x}
      cy={R.y}
      r={f1(glow.r)}
      style={`opacity:${glow.opacity.toFixed(2)}`}
      data-rec
    ></circle>
    <rect class="receiver" x={R.x - 20} y={R.y - 16} width="40" height="32"></rect>
  </svg>

  <div class="field-text" data-field-text>
    <slot />
  </div>
</div>

<script>
  import {
    FIELD,
    ROWS,
    SUN_START,
    COST_SHEET,
    LINKED_MIRROR,
    RING_R,
    SERVER_UNITS_PER_PX,
    clampSun,
    fieldEfficiency,
    poses,
    rayOpacity,
    receiverGlow,
  } from "../../lib/heliostat";

  const FRONT = ROWS.length - 1;
  const CS = COST_SHEET;

  for (const wrap of document.querySelectorAll<HTMLElement>("[data-field]")) {
    const svg = wrap.querySelector<SVGSVGElement>("[data-field-svg]")!;
    const text = wrap.querySelector<HTMLElement>("[data-field-text]")!;
    const inRays = [...svg.querySelectorAll<SVGLineElement>(".rays-in line")];
    const outRays = [...svg.querySelectorAll<SVGLineElement>(".rays-out line")];
    const mirrors = [...svg.querySelectorAll<SVGLineElement>(".mirrors line")];
    const sun = svg.querySelector<SVGCircleElement>("[data-sun]")!;
    const halo = svg.querySelector<SVGCircleElement>("[data-halo]")!;
    const rec = svg.querySelector<SVGCircleElement>("[data-rec]")!;
    const set = (el: Element, a: Record<string, number | string>) => {
      for (const k in a) el.setAttribute(k, typeof a[k] === "number" ? (a[k] as number).toFixed(1) : String(a[k]));
    };

    // The hero fills the first screen (landing page) from 48rem. Phones: text, then the strip under
    // it, showing the scene from x 380 (chart to tower) at its own aspect.
    // Wide screens (owner 2026-10-06: everything sized and lined up, filling the section): the
    // text is the top row, the drawing the bottom row, lined up with the text's column: the
    // costing sheet's left edge on the name's left edge, the receiver's right edge on the
    // column's right edge. If the scene (ground to the top of the sun's arc, 430
    // units) is too tall for the space under the text at that scale, it gets smaller and stays
    // on the right edge. The viewBox matches the SVG's box exactly.
    const wide = matchMedia("(min-width: 48rem)");
    const NARROW_X0 = 380;
    const SCENE_H = 430; // ground (500) to the top of the sun's arc (70)
    const SCENE_R = FIELD.receiver.x + 20; // the receiver's right edge
    const costG = svg.querySelector<SVGGElement>("[data-cost]")!;
    const leader = svg.querySelector<SVGPathElement>(".leader")!;
    const column = text.firstElementChild as HTMLElement | null;
    let skyTop = 0;
    // Where the drawing is narrower than the column (limited by the height), the costing sheet
    // (Wirtschaft) moves left under the name, onto the column's left edge, and the dashed
    // leader to its heliostat (Technik) stretches across: the drawing spans the column at any
    // height (0 where the drawing spans the column anyway).
    // the right edge of the sheet as placed (viewBox units): the sun keeps right of it
    let costR = -Infinity;
    // The sheet keeps one size on screen instead of growing with the scaled-up drawing (as the
    // drawing's labels did): uNow = viewBox units per screen px; k shrinks it where the space
    // under the words is too low for it (short windows) or the phone strip too narrow.
    let uNow = SERVER_UNITS_PER_PX;
    const setLabelScale = (s: number) => {
      uNow = 1 / s;
    };
    const sheetOf = () => (wide.matches ? CS.full : CS.mini);
    let k = 1;
    const shiftCost = (dx: number) => {
      const x = CS.x + dx;
      const g = uNow * k;
      costG.setAttribute("transform", `translate(${x.toFixed(1)} ${(FIELD.ground - CS.lift * g).toFixed(1)}) scale(${g.toFixed(4)})`);
      const ly = FIELD.ground - (CS.lift + sheetOf().h / 2) * g;
      leader.setAttribute("d", `M${x.toFixed(1)} ${ly.toFixed(1)} H${LINKED_MIRROR.x} V${LINKED_MIRROR.y - RING_R}`);
      costR = x;
    };
    // the lowest edge of the words and the portrait, in px from the hero's top
    let textBottomPx = 0;
    const textRects = () =>
      [...text.querySelectorAll("h1, p, img")].map((el) => {
        // (the portrait's frame, not the picture: the intro moves the picture up from below, and
        // measured mid-rise it made a fresh load fit the drawing smaller than a resize did)
        if (el.tagName === "IMG") return (el.parentElement ?? el).getBoundingClientRect();
        const rg = document.createRange();
        rg.selectNodeContents(el);
        return rg.getBoundingClientRect();
      });
    const fit = () => {
      const r = svg.getBoundingClientRect();
      if (!r.width) return;
      let x0 = NARROW_X0;
      let W = FIELD.w - x0;
      let H = Math.max(FIELD.h, (W * r.height) / r.width);
      if (wide.matches && column) {
        const top = wrap.getBoundingClientRect().top;
        textBottomPx = Math.max(0, ...textRects().map((b) => b.bottom - top));
        // the text column's content box, in px from the SVG's left edge
        const cr = column.getBoundingClientRect();
        const cs = getComputedStyle(column);
        const colL = cr.left + parseFloat(cs.paddingLeft) - r.left;
        const colR = cr.right - parseFloat(cs.paddingRight) - r.left;
        // (24: air between the words and the top of the scene)
        const avail = r.height - textBottomPx - 24;
        // The scene's left edge is the sheet's, which keeps its screen width at any scale, so
        // the width that fits the column is solved exactly: s * (SCENE_R - CS.x) + sheet px =
        // column width. The sheet is at most 80 % of the scene's height (k), which changes its
        // width, so solve twice.
        const colW = colR - colL;
        const sh = CS.full;
        // (ends on s, so the sheet's width and the scale it was solved with agree)
        const solveS = () =>
          Math.max(Math.min((colW - (sh.w + 5) * k) / (SCENE_R - CS.x), avail / SCENE_H), r.width / (FIELD.w - FIELD.x0));
        k = 1;
        let s = solveS();
        for (let n = 0; n < 3; n++) {
          k = Math.min(1, (0.8 * SCENE_H * s) / (sh.h + CS.lift));
          s = solveS();
        }
        setLabelScale(s);
        // (+5: the sheet's slight tilt reaches past its left edge)
        const sceneL = CS.x - ((sh.w + 5) * k) / s;
        W = r.width / s;
        H = r.height / s;
        // the receiver's right edge on the column's right edge
        x0 = SCENE_R - colR / s;
        // the column's left edge in viewBox units, minus where the cost column starts: negative
        // = room on the left, so it moves there (only ever left, away from the field)
        shiftCost(Math.min(0, x0 + colL / s - sceneL));
      } else {
        // phones: the small sheet, smaller still where it would reach past the strip's left edge
        setLabelScale(r.width / W);
        // (16px clear of the screen edge)
        k = Math.min(1, ((CS.x - x0) / uNow - 16) / CS.mini.w);
        shiftCost(0);
      }
      skyTop = FIELD.h - H;
      svg.setAttribute("viewBox", `${x0.toFixed(1)} ${skyTop.toFixed(1)} ${W.toFixed(1)} ${H.toFixed(1)}`);
    };
    fit();

    let cur = { ...SUN_START };
    const place = (x: number, y: number) => {
      const c = clampSun(x, y);
      // (clampSun keeps it above the mirrors; the top is the extended sky)
      cur = { x: c.x, y: Math.max(Math.min(y, FIELD.sunMaxY), skyTop + 72) };
      // (72: the halo, r 70, stays whole under the top edge instead of being cut flat)
      const p = poses(cur.x, cur.y);
      let k = 0;
      p.forEach((m, i) => {
        set(mirrors[i], { x1: m.x1, y1: m.y1, x2: m.x2, y2: m.y2 });
        if (m.row === FRONT) set(inRays[k++], { x1: cur.x, y1: cur.y });
        outRays[i].style.opacity = rayOpacity(m).toFixed(2);
      });
      set(sun, { cx: cur.x, cy: cur.y });
      set(halo, { cx: cur.x, cy: cur.y });
      const eff = fieldEfficiency(p, cur.y);
      const g = receiverGlow(eff);
      set(rec, { r: g.r });
      rec.style.opacity = g.opacity.toFixed(2);
    };

    // screen x -> viewBox x (handles the "slice" crop on narrow screens)
    const toFieldX = (clientX: number) => {
      const m = svg.getScreenCTM();
      return m ? new DOMPoint(clientX, 0).matrixTransform(m.inverse()).x : null;
    };

    // pointer -> viewBox coordinates
    const toField = (e: PointerEvent) => {
      const m = svg.getScreenCTM();
      if (!m) return null;
      return new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
    };

    // The drift range: what is visible of the viewBox, minus the text where it overlays the
    // field (>= 48rem; below that the text sits above the field). Recomputed on resize.
    const MARGIN = 80; // the halo (r 70) plus air, in viewBox units: it kept touching the claim at 60
    let lo = 320;
    // the right edge of the name, role and claim (not the portrait): the pointer sun stays right
    // of it, so it never sits in the words with its rays running across them
    let wordsR = -Infinity;
    let hi = FIELD.last + 60;
    // Where the text stands wholly above the sun's sky (wide screens with the scaled-up
    // drawing: "band" layout), the sun drifts over the whole field below it and its arc peaks
    // just under the words; otherwise (the text reaches down beside the field) it keeps right
    // of the words as before.
    let band = false;
    // the right edge of what is visible of the drawing (viewBox units)
    let visRight = Infinity;
    let visLeft = -Infinity;
    // the words' lowest edge in viewBox units, and the peak of the sun's day arc
    let textBottomU = -Infinity;
    let peakY = 70;
    const measure = () => {
      const box = svg.getBoundingClientRect();
      const visL = toFieldX(box.left);
      const visR = toFieldX(box.right);
      if (visR !== null) visRight = visR;
      if (visL !== null) visLeft = visL;
      const m = svg.getScreenCTM();
      if (visL === null || visR === null || !m) return;
      let textR = -Infinity;
      wordsR = -Infinity;
      textBottomU = -Infinity;
      if (wide.matches) {
        // the right edge of the actual words and the portrait, not of the full-width block
        const rects = textRects();
        const imgs = [...text.querySelectorAll("h1, p, img")].map((el) => el.tagName === "IMG");
        rects.forEach((rect, i) => {
          const right = toFieldX(rect.right);
          if (right !== null) textR = Math.max(textR, right);
          if (right !== null && !imgs[i]) wordsR = Math.max(wordsR, right);
          textBottomU = Math.max(textBottomU, new DOMPoint(0, rect.bottom).matrixTransform(m.inverse()).y);
        });
      }
      const climb = 70 + 0.6 * Math.min(0, skyTop);
      // (90: the halo, r 70, plus air under the words)
      // (band while the arc's peak under the words still stands above its ends, 213; fit()
      // leaves the words only 16px above the scene, so the peak lands about 150-160)
      band = wide.matches && textBottomU + 90 <= 200;
      peakY = band ? Math.max(climb, textBottomU + 90) : climb;
      // the drift stops well left of the tower, so the sun's halo and the receiver's glow
      // never merge into one yellow blob
      const top = FIELD.last - 60;
      const right = Math.min(top, visR - MARGIN);
      // (never over the chart: the sun belongs to the field)
      lo = Math.max(visL, band ? -Infinity : textR, FIELD.first - 150, costR) + MARGIN;
      hi = right;
      // too little room beside the text: drift within what is visible
      if (hi - lo < 80) {
        lo = Math.max(visL, FIELD.first - 150, costR) + MARGIN;
        hi = right;
      }
      if (hi < lo) hi = lo;
    };
    const relayout = () => {
      // the hero fills the first screen (landing page): what sits above it (draft note, top bar)
      // comes off the window height (CSS --hero-top; its fallback is the top bar alone)
      wrap.style.setProperty("--hero-top", `${(wrap.getBoundingClientRect().top + scrollY).toFixed(1)}px`);
      fit();
      measure();
    };
    relayout();
    let resizeRaf = 0;
    addEventListener("resize", () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(relayout);
    });
    document.fonts?.ready.then(relayout);
    // the hero's height follows its text (fonts, wrapping)
    new ResizeObserver(() => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(relayout);
    }).observe(wrap);

    let active = false;
    let raf = 0;
    const follow = (e: PointerEvent) => {
      const pt = toField(e);
      if (!pt) return;
      active = true;
      cancelAnimationFrame(raf);
      // the pointer sun sits on the pointer (owner 2026-10-09: "the sun is not on my cursor";
      // keeping it right of / under the words pinned it to the window's edge on laptops), only
      // kept inside the visible drawing; place() keeps it above the mirrors
      let x = Math.min(Math.max(pt.x, visLeft + 30), visRight - 30);
      let y = pt.y;
      // ... except over the costing sheet, which hid the sun under its paper: there the sun and
      // its halo stay just clear of it, above or right of it, whichever is the smaller move
      const top = FIELD.ground - (CS.lift + sheetOf().h) * uNow * k;
      const H = 75; // the halo (r 70) plus air
      if (x < costR + H && y > top - H) {
        if (costR + H - x < y - (top - H)) x = costR + H;
        else y = top - H;
      }
      raf = requestAnimationFrame(() => place(x, y));
    };
    wrap.addEventListener("pointermove", follow);
    wrap.addEventListener("pointerdown", follow);
    wrap.addEventListener("pointerleave", () => {
      active = false;
      lastT = 0;
    });

    // idle: the sun drifts along a flat day arc between lo and hi, starting from wherever it
    // was left (if that is outside the range, it travels back in rather than jumping)
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    let lastT = 0;
    let visible = true;
    new IntersectionObserver(([en]) => (visible = en.isIntersecting)).observe(wrap);
    let dir = 1;
    // the day arc: highest in the middle of the drift range, lower at both ends (213); its peak
    // (measure()) climbs into extra sky where there is some, and stays under the words
    const arcY = (x: number) => {
      const k = hi > lo ? Math.min(Math.max((x - lo) / (hi - lo), 0), 1) : 0.5;
      return peakY + (213 - peakY) * (2 * k - 1) ** 2;
    };

    // Sunrise on load, the hero's only intro (owner 2026-10-06; a critic found the text
    // reveals around it generic, the rise is what belongs to this field): a third into the
    // drift range the sun comes straight up from just above the reflected rays (never inside
    // their fan, where it read as a ball stuck on the beams; where the range reaches the left
    // of the field that is the horizon itself) onto its arc, the mirrors following and the
    // receiver brightening; then the drift carries on from there. Only when the hero is on
    // screen at load and motion is welcome; a pointer takes over at once.
    const RISE_MS = 1500;
    // the top edge of the ray fan at x: the highest of the mirror-to-receiver lines there
    const pivots = poses(SUN_START.x, SUN_START.y);
    const { receiver: REC } = FIELD;
    const fanTop = (x: number) =>
      Math.min(
        ...pivots.filter((m) => m.px < x).map((m) => m.py + ((REC.y - m.py) * (x - m.px)) / (REC.x - m.px)),
        FIELD.ground,
      );
    // (clear of the "je Heliostat" leader on the left, like the pointer sun)
    const riseX = () => Math.max(lo + (hi - lo) * 0.35, FIELD.first + 30);
    // 85: the sun's radius plus most of its halo above the top ray
    const riseY0 = () => Math.min(FIELD.sunMaxY, fanTop(riseX()) - 85);
    let riseT0 = -1;
    // (no rise if the fan reaches up to the arc there: nothing to climb)
    if (!reduce.matches && wrap.getBoundingClientRect().bottom > 0 && riseY0() > arcY(riseX()) + 40) {
      riseT0 = 0;
      place(riseX(), riseY0());
    }
    // the light was held back (CSS) until the sun stands where the script put it, so the
    // server's resting sun doesn't flash before the jump to the sunrise start
    wrap.classList.add("is-lit");
    const drift = (t: number) => {
      // (off screen, e.g. a reload restored further down: no rise, or it would jump to its end)
      if (active || !visible) riseT0 = -1;
      if (!active && visible && !reduce.matches) {
        const dt = lastT ? Math.min(t - lastT, 50) : 0;
        if (riseT0 >= 0) {
          if (riseT0 === 0) riseT0 = t;
          const p = Math.min((t - riseT0) / RISE_MS, 1);
          const e = 1 - (1 - p) ** 3;
          const x = riseX();
          const y0 = riseY0();
          // lands exactly on the arc, so the drift takes over without a step
          place(x, y0 + (arcY(x) - y0) * e);
          if (p === 1) {
            riseT0 = -1;
            dir = 1;
          }
        } else {
          if (cur.x >= hi) dir = -1;
          else if (cur.x <= lo) dir = 1;
          let x = cur.x + dir * dt * 0.02; // ~20 viewBox units per second
          if (cur.x >= lo && cur.x <= hi) x = Math.min(Math.max(x, lo), hi);
          // ease toward the arc, so handing over from the pointer doesn't jump
          place(x, cur.y + (arcY(x) - cur.y) * Math.min(1, dt * 0.004));
        }
      }
      lastT = t;
      requestAnimationFrame(drift);
    };
    requestAnimationFrame(drift);
  }
</script>

<style>
  /* phones: text first, the field in its own strip below (overlaying it made the
     cropped tower collide with the text) */
  .field-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
