---
// The Ringprojekt's part as a rough line drawing (owner liked the sketch from mockup B,
// 2026-10-13): turbine housing (volute) with section hatch, centre lines, a bore dimension,
// the outlet flange, the 3D-printed clamp (Niederhalter) exploded above, measuring points.
// Labels name parts, not people. A stand-in: the owner's real photos replace it later.
// The parts carry position numbers (as on a drawing) and are named in HTML below it: labels
// drawn inside the scaled SVG came out at 6-11px on most screens (2026-10-13 test round).

const parts = [
  { name: "Niederhalter", how: "3D-gedruckt" },
  { name: "Bohrungen", how: "Niederhalter angebohrt" },
  { name: "Flansch", how: "gefräst, gebohrt" },
  { name: "Gehäuse", how: "Aluminiumguss" },
  { name: "Messpunkt", how: "" },
];
// where each number sits on the drawing (at the end of its leader)
const pos = [
  { n: 1, x: 426, y: 50 },
  { n: 2, x: 416, y: 162 },
  { n: 3, x: 452, y: 334 },
  { n: 4, x: 438, y: 418 },
  { n: 5, x: 86, y: 290 },
];
---

<figure class="rs">
  <svg viewBox="66 34 404 476" role="img" aria-label="Skizze: Turboladergehäuse aus Aluminiumguss mit gefrästem und gebohrtem Flansch, darüber der 3D-gedruckte Niederhalter, der an das Gehäuse gebohrt wird">
    <defs>
      <pattern id="rs-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" class="hatch" />
      </pattern>
      <marker id="rs-dim" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 2 L10 5 L0 8" fill="none" stroke="currentColor" stroke-width="1.2" />
      </marker>
    </defs>

    <!-- centre lines -->
    <g class="centre">
      <line x1="90" y1="330" x2="420" y2="330" /><line x1="250" y1="160" x2="250" y2="490" />
    </g>

    <!-- Niederhalter, exploded upwards -->
    <g class="part">
      <path d="M150 62 H350 Q360 62 364 70 L376 92 H124 L136 70 Q140 62 150 62 Z" />
      <rect x="112" y="92" width="276" height="16" rx="2" />
      <rect x="148" y="108" width="20" height="30" /><rect x="332" y="108" width="20" height="30" />
    </g>
    <g class="explode"><line x1="158" y1="142" x2="158" y2="206" /><line x1="342" y1="142" x2="342" y2="206" /></g>

    <!-- volute: outer and inner wall, the wall in section -->
    <path
      class="wall"
      fill-rule="evenodd"
      d="M250 474 C 150 474 92 410 96 336 C 100 262 166 210 240 208 L 430 208 L 430 286 L 384 290 C 392 392 340 474 250 474 Z M250 444 C 168 444 124 392 128 336 C 132 280 184 240 240 238 L 384 238 L 384 262 L 362 264 C 368 372 322 444 250 444 Z"
    />
    <path class="thin" d="M250 412 C 196 412 160 378 162 334 C 164 292 200 268 240 268 L 340 268" />
    <circle class="part" cx="250" cy="330" r="56" />
    <circle class="thin" cx="250" cy="330" r="36" />
    <circle class="part" cx="250" cy="330" r="11" />
    <g class="blade">
      <path d="M250 294 q 16 16 2 36" /><path d="M286 330 q -16 16 -36 2" /><path d="M250 366 q -16 -16 -2 -36" /><path d="M214 330 q 16 -16 36 -2" />
    </g>
    <!-- outlet flange and its holes; the holes drilled for the clamp -->
    <rect class="part" x="430" y="196" width="20" height="104" />
    <g class="hole"><circle cx="440" cy="214" r="4.5" /><circle cx="440" cy="282" r="4.5" /><circle cx="158" cy="223" r="5" /><circle cx="342" cy="223" r="5" /></g>

    <!-- bore diameter -->
    <g class="dim">
      <line x1="194" y1="330" x2="194" y2="500" /><line x1="306" y1="330" x2="306" y2="500" />
      <line x1="194" y1="494" x2="306" y2="494" marker-start="url(#rs-dim)" marker-end="url(#rs-dim)" />
    </g>
    <text x="250" y="487" class="o" text-anchor="middle">Ø</text>

    <!-- measuring points -->
    <g class="dim">
      <g transform="translate(96 336)"><line x1="-8" y1="0" x2="8" y2="0" /><line x1="0" y1="-8" x2="0" y2="8" /><circle r="4.5" /></g>
      <g transform="translate(372 420)"><line x1="-8" y1="0" x2="8" y2="0" /><line x1="0" y1="-8" x2="0" y2="8" /><circle r="4.5" /></g>
    </g>

    <!-- position numbers -->
    <g class="dim">
      <path d="M376 80 L 412 58" /><path d="M342 223 L 404 172" /><path d="M444 300 L 450 318" />
      <path d="M370 380 L 424 410" /><path d="M93 328 L 88 306" />
    </g>
    {pos.map((p) => (
      <g class="pos" transform={`translate(${p.x} ${p.y})`}>
        <circle r="14" />
        <text y="6.5" text-anchor="middle">{p.n}</text>
      </g>
    ))}
  </svg>
  <ol class="parts">
    {parts.map((p, k) => (
      <li>
        <span class="n">{k + 1}</span>
        <span>
          {p.name}
          <span class="how">{p.how}</span>
        </span>
      </li>
    ))}
  </ol>
  <figcaption>Grobe Skizze, kein echtes Bauteil: die Aufgabe liegt nicht mehr vor.</figcaption>
</figure>

<style>
  .rs {
    margin: 0;
    color: var(--ink);
  }
  .rs svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .part,
  .wall,
  .hole {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .wall {
    fill: url(#rs-hatch);
  }
  .hole {
    stroke-width: 1.3;
  }
  .thin {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }
  .hatch {
    stroke: currentColor;
    stroke-width: 0.9;
    stroke-opacity: 0.55;
  }
  .centre line {
    stroke: var(--steel);
    stroke-width: 1;
    stroke-dasharray: 14 4 2 4;
  }
  .explode line {
    stroke: var(--steel);
    stroke-width: 1;
    stroke-dasharray: 5 4;
  }
  .blade path {
    fill: none;
    stroke: var(--steel);
    stroke-width: 1.1;
  }
  .dim,
  .dim line,
  .dim path,
  .dim circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }
  /* 19 units: about 13px where the drawing is narrowest (280px wide at 320) */
  .pos circle {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1.3;
  }
  .o,
  .pos text {
    font-family: var(--sans);
    font-size: 19px;
    font-weight: 600;
    fill: var(--ink);
  }
  .parts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0.75rem 0 0;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .parts li {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
  }
  .n {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transform: translateY(-0.05rem);
  }
  .how {
    color: var(--ink-2);
  }
  .how:not(:empty)::before {
    content: ", ";
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
</style>
