---
// Kernkompetenz "Data & AI": data from several systems through an ETL step into a report,
// with a Copilot question about it. Drawn for the site (AI-generated, marked in the picture).
---

<svg class="kk-art" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="800" height="520" fill="#e9f3f2"></rect>
  <g fill="#d2e6e3">
    {Array.from({ length: 16 }, (_, i) => Array.from({ length: 10 }, (_, j) => <circle cx={25 + i * 50} cy={25 + j * 50} r="2" />))}
  </g>

  <!-- three sources -->
  {
    ([
      ["ERP", 90, "#2f55c7"],
      ["CRM", 220, "#0e9384"],
      ["Excel", 350, "#b4532a"],
    ] as const).map(([name, y, c]) => (
      <g transform={`translate(60 ${y})`}>
        <path d="M0 14 v56 a46 14 0 0 0 92 0 v-56" fill="#ffffff" stroke="#0f1b2d" stroke-width="2.5"></path>
        <ellipse cx="46" cy="14" rx="46" ry="14" fill={c} stroke="#0f1b2d" stroke-width="2.5"></ellipse>
        <path d="M0 42 a46 14 0 0 0 92 0" fill="none" stroke="#7d8b99" stroke-width="1.5"></path>
        <text x="46" y="70" font-size="16" font-weight="700" text-anchor="middle" fill="#0f1b2d" font-family="Schibsted Grotesk, sans-serif">{name}</text>
      </g>
    ))
  }

  <!-- flows into ETL -->
  <g fill="none" stroke="#0f1b2d" stroke-width="2">
    <path d="M152 130 C 210 130, 210 250, 262 250"></path>
    <path d="M152 260 L 262 260"></path>
    <path d="M152 390 C 210 390, 210 270, 262 270"></path>
  </g>
  <g transform="translate(262 214)">
    <rect width="96" height="92" rx="14" fill="#0f1b2d"></rect>
    <!-- a gear -->
    <g transform="translate(48 40)" fill="none" stroke="#ffffff" stroke-width="3">
      <circle r="13"></circle>
      {Array.from({ length: 8 }, (_, i) => <line x1="0" y1="-16" x2="0" y2="-22" transform={`rotate(${i * 45})`} />)}
    </g>
    <text x="48" y="80" font-size="15" font-weight="700" text-anchor="middle" fill="#ffffff" font-family="Schibsted Grotesk, sans-serif">ETL</text>
  </g>
  <path d="M358 260 L 420 260" fill="none" stroke="#0f1b2d" stroke-width="2"></path>
  <path d="M412 252 L 422 260 L 412 268" fill="none" stroke="#0f1b2d" stroke-width="2"></path>

  <!-- the report window -->
  <g transform="translate(428 96)">
    <rect width="320" height="320" rx="10" fill="#ffffff" stroke="#0f1b2d" stroke-width="2.5"></rect>
    <rect width="320" height="34" rx="10" fill="#e7ebf0"></rect>
    <rect y="24" width="320" height="10" fill="#e7ebf0"></rect>
    <circle cx="18" cy="17" r="5" fill="#b4532a"></circle>
    <circle cx="34" cy="17" r="5" fill="#7d8b99"></circle>
    <circle cx="50" cy="17" r="5" fill="#0e9384"></circle>
    <!-- bars -->
    <g transform="translate(24 60)">
      {[56, 84, 70, 112, 98, 130].map((h, i) => <rect x={i * 30} y={140 - h} width="20" height={h} rx="3" fill={i === 5 ? "#2f55c7" : "#b9c8ee"} />)}
      <line x1="0" y1="140" x2="176" y2="140" stroke="#0f1b2d" stroke-width="1.5"></line>
    </g>
    <!-- donut -->
    <g transform="translate(250 120)">
      <circle r="38" fill="none" stroke="#e7ebf0" stroke-width="16"></circle>
      <circle r="38" fill="none" stroke="#0e9384" stroke-width="16" stroke-dasharray="150 239" transform="rotate(-90)"></circle>
      <circle r="38" fill="none" stroke="#b4532a" stroke-width="16" stroke-dasharray="50 239" stroke-dashoffset="-150" transform="rotate(-90)"></circle>
    </g>
    <!-- line -->
    <path d="M24 270 L 80 250 L 136 258 L 192 228 L 248 236 L 296 206" fill="none" stroke="#2f55c7" stroke-width="3" stroke-linejoin="round"></path>
    <line x1="24" y1="290" x2="296" y2="290" stroke="#d3d9e0" stroke-width="1.5"></line>
  </g>

  <!-- a question to Copilot -->
  <g transform="translate(560 410)">
    <rect width="208" height="58" rx="14" fill="#0f1b2d"></rect>
    <path d="M30 58 l-6 16 l20 -16 z" fill="#0f1b2d"></path>
    <text x="18" y="26" font-size="13" fill="#9fb0c3" font-family="Schibsted Grotesk, sans-serif">Copilot</text>
    <text x="18" y="45" font-size="15" fill="#ffffff" font-family="Schibsted Grotesk, sans-serif">Warum steigt der Wert?</text>
  </g>
</svg>
