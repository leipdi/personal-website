---
// Kernkompetenz "Controlling": the monthly close as a calendar with its days ticked off, a
// pivot table and a plan/actual variance chart. Drawn for the site (AI-generated, marked in
// the picture).
---

<svg class="kk-art" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="800" height="520" fill="#eceff8"></rect>

  <!-- the month -->
  <g transform="translate(50 70)">
    <rect width="260" height="250" rx="10" fill="#ffffff" stroke="#0f1b2d" stroke-width="2.5"></rect>
    <rect width="260" height="46" rx="10" fill="#2f55c7"></rect>
    <rect y="34" width="260" height="12" fill="#2f55c7"></rect>
    <text x="18" y="30" font-size="17" font-weight="700" fill="#ffffff" font-family="Schibsted Grotesk, sans-serif">Monatsabschluss</text>
    {
      Array.from({ length: 30 }, (_, d) => {
        const col = d % 7;
        const row = Math.floor(d / 7);
        const x = 22 + col * 33;
        const y = 70 + row * 36;
        const done = d < 23;
        return (
          <g transform={`translate(${x} ${y})`}>
            <rect width="26" height="26" rx="5" fill={done ? "#e6f4f2" : "#f4f6f8"} stroke={done ? "#0e9384" : "#d3d9e0"} stroke-width="1.5"></rect>
            {done && <path d="M7 13 l4 5 l9 -10" fill="none" stroke="#0e9384" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>}
          </g>
        );
      })
    }
  </g>

  <!-- the pivot table -->
  <g transform="translate(350 70)">
    <rect width="400" height="170" rx="10" fill="#ffffff" stroke="#0f1b2d" stroke-width="2.5"></rect>
    <rect width="400" height="38" rx="10" fill="#0f1b2d"></rect>
    <rect y="28" width="400" height="10" fill="#0f1b2d"></rect>
    {["Kostenstelle", "Plan", "Ist", "Abw."].map((h, i) => <text x={18 + i * 96} y="25" font-size="14" font-weight="700" fill="#ffffff" font-family="Schibsted Grotesk, sans-serif">{h}</text>)}
    {
      [0, 1, 2].map((r) => (
        <g transform={`translate(0 ${58 + r * 36})`}>
          <rect x="18" y="-8" width="70" height="12" rx="6" fill="#d3d9e0"></rect>
          <rect x="114" y="-8" width="56" height="12" rx="6" fill="#b9c8ee"></rect>
          <rect x="210" y="-8" width={[60, 44, 66][r]} height="12" rx="6" fill="#2f55c7"></rect>
          <rect x="306" y="-8" width="40" height="12" rx="6" fill={r === 1 ? "#0e9384" : "#b4532a"}></rect>
          <line x1="18" y1="16" x2="382" y2="16" stroke="#eef1f4" stroke-width="1.5"></line>
        </g>
      ))
    }
  </g>

  <!-- plan vs actual -->
  <g transform="translate(350 280)">
    <rect width="400" height="190" rx="10" fill="#ffffff" stroke="#0f1b2d" stroke-width="2.5"></rect>
    {
      [
        [70, 92],
        [96, 84],
        [80, 104],
        [112, 108],
        [100, 124],
      ].map(([plan, ist], i) => (
        <g transform={`translate(${40 + i * 70} 160)`}>
          <rect x="0" y={-plan} width="22" height={plan} rx="3" fill="#d3d9e0"></rect>
          <rect x="26" y={-ist} width="22" height={ist} rx="3" fill={ist >= plan ? "#0e9384" : "#b4532a"}></rect>
        </g>
      ))
    }
    <line x1="24" y1="160" x2="376" y2="160" stroke="#0f1b2d" stroke-width="2"></line>
  </g>

  <!-- a small legend -->
  <g transform="translate(50 360)" font-family="Schibsted Grotesk, sans-serif" font-size="15" fill="#0f1b2d">
    <rect width="18" height="18" rx="3" fill="#d3d9e0"></rect>
    <text x="28" y="14">Plan</text>
    <rect y="32" width="18" height="18" rx="3" fill="#0e9384"></rect>
    <text x="28" y="46">Ist über Plan</text>
    <rect y="64" width="18" height="18" rx="3" fill="#b4532a"></rect>
    <text x="28" y="78">Ist unter Plan</text>
  </g>
</svg>
