---
// Kernkompetenz "Prozesse und Projekte": a process across two lanes, the time recording it
// introduced, and the training that came with it. Drawn for the site (AI-generated, marked in
// the picture).
---

<svg class="kk-art" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="800" height="520" fill="#f3eee9"></rect>

  <!-- two swimlanes -->
  <g transform="translate(40 60)">
    <rect width="720" height="250" rx="10" fill="#ffffff" stroke="#0f1b2d" stroke-width="2"></rect>
    <line x1="0" y1="125" x2="720" y2="125" stroke="#d3d9e0" stroke-width="2"></line>
    <rect width="44" height="250" rx="10" fill="#0f1b2d"></rect>
    <text transform="translate(28 62) rotate(-90)" font-size="14" font-weight="700" text-anchor="middle" fill="#ffffff" font-family="Schibsted Grotesk, sans-serif">Team</text>
    <text transform="translate(28 188) rotate(-90)" font-size="14" font-weight="700" text-anchor="middle" fill="#ffffff" font-family="Schibsted Grotesk, sans-serif">System</text>

    <!-- steps -->
    <circle cx="90" cy="62" r="16" fill="#0e9384"></circle>
    <rect x="140" y="38" width="120" height="48" rx="8" fill="#e7f0ff" stroke="#2f55c7" stroke-width="2"></rect>
    <text x="200" y="68" font-size="14" text-anchor="middle" fill="#0f1b2d" font-family="Schibsted Grotesk, sans-serif">Zeit erfassen</text>
    <rect x="140" y="164" width="120" height="48" rx="8" fill="#e6f4f2" stroke="#0e9384" stroke-width="2"></rect>
    <text x="200" y="194" font-size="14" text-anchor="middle" fill="#0f1b2d" font-family="Schibsted Grotesk, sans-serif">Timebutler</text>
    <path d="M360 38 l26 24 l-26 24 l-26 -24 z" fill="#fbeee6" stroke="#b4532a" stroke-width="2"></path>
    <text x="360" y="67" font-size="15" font-weight="700" text-anchor="middle" fill="#b4532a" font-family="Schibsted Grotesk, sans-serif">?</text>
    <rect x="440" y="38" width="120" height="48" rx="8" fill="#e7f0ff" stroke="#2f55c7" stroke-width="2"></rect>
    <text x="500" y="68" font-size="14" text-anchor="middle" fill="#0f1b2d" font-family="Schibsted Grotesk, sans-serif">Freigeben</text>
    <rect x="440" y="164" width="120" height="48" rx="8" fill="#e6f4f2" stroke="#0e9384" stroke-width="2"></rect>
    <text x="500" y="194" font-size="14" text-anchor="middle" fill="#0f1b2d" font-family="Schibsted Grotesk, sans-serif">Auswertung</text>
    <circle cx="640" cy="188" r="16" fill="#ffffff" stroke="#0f1b2d" stroke-width="5"></circle>

    <!-- flow -->
    <g fill="none" stroke="#0f1b2d" stroke-width="2">
      <path d="M106 62 H140"></path>
      <path d="M200 86 V164"></path>
      <path d="M260 188 H300 V62 H334"></path>
      <path d="M386 62 H440"></path>
      <path d="M500 86 V164"></path>
      <path d="M560 188 H624"></path>
    </g>
  </g>

  <!-- a clock: the time recording -->
  <g transform="translate(150 410)">
    <circle r="62" fill="#ffffff" stroke="#0f1b2d" stroke-width="3"></circle>
    {Array.from({ length: 12 }, (_, i) => <line x1="0" y1="-50" x2="0" y2="-42" stroke="#0f1b2d" stroke-width="2" transform={`rotate(${i * 30})`} />)}
    <line x1="0" y1="0" x2="0" y2="-34" stroke="#0f1b2d" stroke-width="4" stroke-linecap="round"></line>
    <line x1="0" y1="0" x2="28" y2="10" stroke="#b4532a" stroke-width="4" stroke-linecap="round"></line>
    <circle r="5" fill="#0f1b2d"></circle>
  </g>

  <!-- the training: a board and three people -->
  <g transform="translate(420 340)">
    <rect width="190" height="110" rx="6" fill="#ffffff" stroke="#0f1b2d" stroke-width="2.5"></rect>
    <path d="M24 80 L 70 50 L 110 66 L 160 30" fill="none" stroke="#0e9384" stroke-width="3"></path>
    <line x1="95" y1="110" x2="95" y2="150" stroke="#0f1b2d" stroke-width="3"></line>
    {
      ([
        [230, "#2f55c7"],
        [280, "#0e9384"],
        [330, "#b4532a"],
      ] as const).map(([x, c]) => (
        <g transform={`translate(${x} 96)`}>
          <circle r="14" fill={c}></circle>
          <path d="M-22 58 a22 26 0 0 1 44 0 z" fill={c}></path>
        </g>
      ))
    }
  </g>
</svg>
