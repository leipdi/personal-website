---
// Kernkompetenz "Bauteilkostenkalkulation": a heliostat as a technical drawing, its parts led
// out to a calculation sheet. Drawn for the site (AI-generated, marked in the picture).
---

<svg class="kk-art" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="800" height="520" fill="#eaf0f6"></rect>
  <!-- drawing grid -->
  <g stroke="#d3dce6" stroke-width="1">
    {Array.from({ length: 21 }, (_, i) => <line x1={i * 40} y1="0" x2={i * 40} y2="520" />)}
    {Array.from({ length: 14 }, (_, i) => <line x1="0" y1={i * 40} x2="800" y2={i * 40} />)}
  </g>

  <!-- the heliostat: mirror on a torque tube, pylon, foundation -->
  <g transform="translate(70 70)">
    <g transform="rotate(-18 170 120)">
      <rect x="20" y="70" width="300" height="110" fill="#ffffff" stroke="#0f1b2d" stroke-width="3"></rect>
      <g stroke="#7d8b99" stroke-width="1.5">
        <line x1="95" y1="70" x2="95" y2="180"></line>
        <line x1="170" y1="70" x2="170" y2="180"></line>
        <line x1="245" y1="70" x2="245" y2="180"></line>
        <line x1="20" y1="125" x2="320" y2="125"></line>
      </g>
      <!-- the light it catches -->
      <path d="M40 80 L120 80 L60 170 L20 170 Z" fill="#f2a900" opacity="0.18"></path>
      <rect x="20" y="186" width="300" height="12" fill="#2f55c7"></rect>
    </g>
    <rect x="160" y="190" width="22" height="150" fill="#0e9384"></rect>
    <rect x="150" y="176" width="42" height="26" rx="4" fill="#0f1b2d"></rect>
    <rect x="118" y="340" width="106" height="18" fill="#b4532a"></rect>
    <!-- dimension line -->
    <g stroke="#2f55c7" stroke-width="1.5">
      <line x1="10" y1="372" x2="330" y2="372"></line>
      <line x1="10" y1="364" x2="10" y2="380"></line>
      <line x1="330" y1="364" x2="330" y2="380"></line>
    </g>
  </g>

  <!-- the calculation sheet -->
  <g transform="translate(470 92)">
    <rect width="270" height="300" rx="8" fill="#ffffff" stroke="#0f1b2d" stroke-width="2"></rect>
    <rect width="270" height="44" rx="8" fill="#0f1b2d"></rect>
    <rect y="30" width="270" height="14" fill="#0f1b2d"></rect>
    <text x="18" y="29" font-size="17" font-weight="700" fill="#ffffff" font-family="Schibsted Grotesk, sans-serif">Kalkulation</text>
    {
      ([
        ["Material", 150, "#2f55c7"],
        ["Laserschneiden", 96, "#0e9384"],
        ["Schweißen", 70, "#0e9384"],
        ["Montage", 54, "#b4532a"],
      ] as const).map(([name, w, c], i) => (
        <g transform={`translate(18 ${74 + i * 50})`}>
          <text y="0" font-size="14" fill="#4f5d6e" font-family="Schibsted Grotesk, sans-serif">{name}</text>
          <rect y="10" width="234" height="12" rx="6" fill="#e7ebf0"></rect>
          <rect y="10" width={w} height="12" rx="6" fill={c}></rect>
        </g>
      ))
    }
    <line x1="18" y1="268" x2="252" y2="268" stroke="#0f1b2d" stroke-width="2"></line>
    <text x="18" y="290" font-size="15" font-weight="700" fill="#0f1b2d" font-family="Schibsted Grotesk, sans-serif">Herstellkosten</text>
    <rect x="160" y="278" width="92" height="16" rx="8" fill="#0f1b2d"></rect>
  </g>

  <!-- leaders from the parts to their rows -->
  <g fill="none" stroke="#0f1b2d" stroke-width="1.5" stroke-dasharray="5 5">
    <path d="M330 150 C 400 150, 410 166, 488 166"></path>
    <path d="M252 330 C 380 330, 400 216, 488 216"></path>
    <path d="M262 422 C 400 422, 420 316, 488 316"></path>
  </g>
  <g fill="#0f1b2d">
    <circle cx="330" cy="150" r="4"></circle>
    <circle cx="252" cy="330" r="4"></circle>
    <circle cx="262" cy="422" r="4"></circle>
  </g>
</svg>
