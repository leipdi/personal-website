---
// The Ringprojekt's semester in lanes (spec: docs/superpowers/specs/2026-10-13-projekte-ringprojekt-design.md).
// Redrawn 2026-10-14 after the owner found the first version too busy: no arrows between the
// lanes, no Teamleitung lane (the team is described in the text above), two phases. My PPS work
// frames the team lanes: on top a band with the work plan for each production step (one faint
// guide down to its step), at the bottom a band with what came out of the steps (times, machine
// costs, the final presentation). So the guides never cross another box.
// Drawn from the lists below, so corrections from the owner change data, not drawing code.
// Two SVGs at one scale, side by side: the lane names and the chart. In a narrow column the
// pair keeps its natural size (13px text) and scrolls sideways with short names pinned (CSS
// container query below). The legend is HTML below the panel, so it wraps on phones. Ink and
// steel only: sun means light, the category colours mean Werdegang. No JS.

type RowId = "plan" | "kon" | "rp" | "guss" | "span" | "mess" | "eval";
type Kind = "pc" | "sim" | "lab";
type Item = { id: string; row: RowId; t0: number; t1: number; kind: Kind; label: string };

const LW = 180; // names column (SVG units = px at natural size)
const CW = 860; // chart
const H = 412;
const X0 = 16;
const X1 = CW - 16;
/** time 0 (Semesterbeginn) to 100 (Abgabe) to chart x */
const x = (t: number) => X0 + (t / 100) * (X1 - X0);

// short: the names in a narrow column, where they stay pinned beside the scrolling chart.
// mine: my PPS rows, drawn as a tinted band with an ink edge
const rows: { id: RowId; label: string; short: string; y: number; h: number; mine?: boolean }[] = [
  { id: "plan", label: "Planung (ich)", short: "Planung", y: 28, h: 52, mine: true },
  { id: "kon", label: "Konstruktion", short: "Konstruktion", y: 80, h: 48 },
  { id: "rp", label: "Rapid Prototyping", short: "Prototyping", y: 128, h: 48 },
  { id: "guss", label: "Spanlose Fertigung", short: "Guss", y: 176, h: 48 },
  { id: "span", label: "Spanende Fertigung", short: "Spanen", y: 224, h: 48 },
  { id: "mess", label: "Messtechnik", short: "Messtechnik", y: 272, h: 48 },
  { id: "eval", label: "Auswertung (ich)", short: "Auswertung", y: 320, h: 48, mine: true },
];
const LANES_END = 368;
const AXIS = 388;
const row = (id: RowId) => rows.find((r) => r.id === id)!;
const mid = (id: RowId) => row(id).y + row(id).h / 2;

const BOX = 26;
const items: Item[] = [
  { id: "tree", row: "plan", t0: 9, t1: 37, kind: "pc", label: "Stückliste, Arbeitsgangfolge" },
  { id: "entwurf", row: "kon", t0: 0, t1: 16, kind: "pc", label: "Entwurf im Team" },
  { id: "aend", row: "kon", t0: 18, t1: 50, kind: "pc", label: "Änderungen am Entwurf" },
  { id: "gsim", row: "guss", t0: 12, t1: 34, kind: "sim", label: "Gusssimulation" },
  { id: "fsim", row: "span", t0: 8, t1: 37, kind: "sim", label: "Fräs- und Bohrsimulation" },
  { id: "proto", row: "rp", t0: 36, t1: 48, kind: "lab", label: "Prototyp" },
  { id: "guss", row: "guss", t0: 55, t1: 68, kind: "lab", label: "Alu-Guss" },
  { id: "nh", row: "rp", t0: 60, t1: 71, kind: "lab", label: "Niederhalter" },
  { id: "spanen", row: "span", t0: 72, t1: 79, kind: "lab", label: "Spanen" },
  { id: "mont", row: "span", t0: 80, t1: 88, kind: "lab", label: "Montage" },
  { id: "mess", row: "mess", t0: 89, t1: 99, kind: "lab", label: "Messung" },
  { id: "zeiten", row: "eval", t0: 55, t1: 84, kind: "pc", label: "Zeiten erfasst, Kosten berechnet" },
  { id: "praes", row: "eval", t0: 86, t1: 100, kind: "pc", label: "Präsentation" },
];
const byId = (id: string) => items.find((i) => i.id === id)!;
const top = (i: Item) => mid(i.row) - BOX / 2;

// one work plan per production step, printed for its start (task list: Guss, Rapid
// Prototyping, Spanen, Montage, Messtechnik)
const planned = ["guss", "nh", "spanen", "mont", "mess"].map(byId);
const gx = (i: Item) => x(i.t0) + 10; // the sheet's centre
const GY = mid("plan");

// the semester's two stretches, as a reading frame across the top
const phases = [
  { t0: 0, t1: 53, label: "Entwurf und Simulation" },
  { t0: 53, t1: 100, label: "Fertigung und Messung" },
];
---

<figure class="rf" aria-labelledby="rf-note">
  <p class="rf-hint">Die Grafik lässt sich seitlich verschieben.</p>
  <div class="rf-scroll" tabindex="0" role="region" aria-label="Ablauf des Ringprojekts, seitlich verschiebbar">
    <div class="rf-inner">
      <svg class="rf-names" viewBox={`0 0 ${LW} ${H}`} preserveAspectRatio="xMinYMin slice" aria-hidden="true">
        {
          rows.map((r) =>
            r.mine ? (
              <>
                <rect class="band" x="0" y={r.y} width={LW} height={r.h} />
                <rect class="edge" x="0" y={r.y} width="4" height={r.h} />
              </>
            ) : (
              <line class="rule" x1="0" y1={r.y} x2={LW} y2={r.y} />
            ),
          )
        }
        {
          rows.map((r) => (
            <text class:list={["t", r.mine && "b2"]} x={r.mine ? 14 : 0} y={r.y + r.h / 2 + 5}>
              <tspan class="long">{r.label}</tspan>
              <tspan class="short">{r.short}</tspan>
            </text>
          ))
        }
      </svg>

      <svg class="rf-chart" viewBox={`0 0 ${CW} ${H}`} aria-hidden="true">
        <!-- my bands, the lane rules -->
        {rows.map((r) => (r.mine ? <rect class="band" x="0" y={r.y} width={CW} height={r.h} /> : <line class="rule" x1="0" y1={r.y} x2={CW} y2={r.y} />))}

        <!-- phases: a label each across the top, a light rule between them -->
        {
          phases.map((p, k) => (
            <>
              {k > 0 && <line class="phase" x1={x(p.t0)} y1="2" x2={x(p.t0)} y2={LANES_END} />}
              <text class="t ph" x={(x(p.t0) + x(p.t1)) / 2} y="17" text-anchor="middle">
                {p.label}
              </text>
            </>
          ))
        }

        <!-- each work plan's guide down to its step -->
        {planned.map((i) => <line class="guide" x1={gx(i)} y1={GY + 12} x2={gx(i)} y2={top(i)} />)}
        <line class="plan" x1={x(byId("tree").t1)} y1={GY} x2={gx(planned.at(-1)!)} y2={GY} />

        <!-- the steps -->
        {
          items.map((i) => (
            <>
              <rect class:list={["box", i.kind]} x={x(i.t0)} y={top(i)} width={x(i.t1) - x(i.t0)} height={BOX} />
              <text class:list={["t", i.kind === "lab" && "inv"]} x={(x(i.t0) + x(i.t1)) / 2} y={mid(i.row) + 4.5} text-anchor="middle">
                {i.label}
              </text>
            </>
          ))
        }

        <!-- a work plan sheet per production step -->
        {
          planned.map((i) => (
            <g class="sheet" transform={`translate(${gx(i) - 9} ${GY - 11})`}>
              <path class="paper" d="M0 0 h13 l5 5 v17 h-18 z" />
              <path class="lines" d="M4 10 h10 M4 14 h10 M4 18 h6" />
            </g>
          ))
        }

        <!-- time axis -->
        <line class="axis" x1={x(0)} y1={AXIS} x2={x(100)} y2={AXIS} />
        <text class="t m" x={x(0)} y={AXIS + 20}>Semesterbeginn</text>
        <text class="t m" x={x(100)} y={AXIS + 20} text-anchor="end">Abgabe</text>
      </svg>
    </div>
  </div>
  <ul class="legend" aria-hidden="true">
    <li><svg viewBox="0 0 16 12" width="16" height="12"><rect class="box pc" x="1" y="1" width="14" height="10" /></svg>am Rechner</li>
    <li><svg viewBox="0 0 16 12" width="16" height="12"><rect class="box sim" x="1" y="1" width="14" height="10" /></svg>Simulation</li>
    <li><svg viewBox="0 0 16 12" width="16" height="12"><rect class="box lab" x="1" y="1" width="14" height="10" /></svg>im Labor</li>
    <li>
      <svg viewBox="0 0 16 20" width="16" height="20"><g class="sheet" transform="translate(1.5 1) scale(0.75)"><path class="paper" d="M0 0 h13 l5 5 v17 h-18 z" /></g></svg>Arbeitsplan
    </li>
    <li><svg viewBox="0 0 16 12" width="16" height="12"><rect class="band" x="0" y="0" width="16" height="12" /><rect class="edge" x="0" y="0" width="3" height="12" /></svg>meine Arbeit (PPS)</li>
  </ul>
  <figcaption id="rf-note">Vereinfacht: Reihenfolge und Abhängigkeiten stimmen, die Abstände sind nicht maßstäblich.</figcaption>
  <div class="sr-only">
    <p>Ablauf des Ringprojekts über das Semester, in zwei Abschnitten: Entwurf und Simulation, dann Fertigung und Messung.</p>
    <p>Die Konstruktion entwirft die Halterung im Team. Guss- sowie Fräs- und Bohrsimulation führen zu Änderungen am Entwurf, dazwischen wird ein Prototyp gedruckt.</p>
    <p>Als PPS baue ich aus dem Entwurf Stückliste und Arbeitsgangfolge in Infor auf. Zu jedem Fertigungsschritt geht ein Arbeitsplan: Aluminiumguss, Niederhalter, Spanen, Montage des Niederhalters, Messung. Während gefertigt wird, erfasse ich die Zeiten, daraus berechne ich die Maschinenkosten; am Ende halte ich die Präsentation.</p>
  </div>
</figure>

<style>
  .rf {
    margin: 0;
    container-type: inline-size;
  }
  .rf-scroll {
    background: var(--paper);
    border: 1px solid var(--line);
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  /* the two SVGs at one scale: widths in the ratio of their viewBox widths (180 : 860). Flex,
     not grid: a sticky grid item can't leave its own grid area, so the names wouldn't pin */
  .rf-inner {
    display: flex;
    align-items: flex-start;
    padding: 1rem 1rem 0.75rem 0.9rem;
  }
  .rf-inner svg {
    display: block;
    min-width: 0;
    height: auto;
  }
  .rf-names {
    flex: 180 1 0;
  }
  .rf-chart {
    flex: 860 1 0;
  }
  .rf-names {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--paper);
  }
  .rf-scroll:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .rf-hint {
    display: none;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 0.6rem 0 0;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  /* the swatches also carry width/height attributes, so they stay small even without this CSS
     (without them an SVG falls back to 300x150 and a swatch fills a big field) */
  .legend svg {
    flex: none;
    width: 1rem;
    height: auto;
    overflow: visible;
  }
  figcaption {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  /* SVG parts */
  .t {
    font-family: var(--sans);
    font-size: 13px;
    fill: var(--ink);
  }
  .rf-names .t {
    font-size: 14px;
  }
  .short {
    display: none;
  }
  .t.b2 {
    font-weight: 600;
  }
  .t.m {
    fill: var(--ink-2);
  }
  .t.ph {
    font-weight: 600;
    fill: var(--ink-2);
  }
  .t.inv {
    fill: var(--paper);
  }
  .band {
    fill: var(--ink);
    fill-opacity: 0.06;
  }
  .edge {
    fill: var(--ink);
  }
  .rule {
    stroke: var(--ink);
    stroke-opacity: 0.17;
  }
  .phase {
    stroke: var(--ink);
    stroke-opacity: 0.22;
  }
  .box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .box.sim {
    stroke-dasharray: 5 3;
  }
  .box.lab {
    fill: var(--ink);
    stroke: none;
  }
  .plan {
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  /* a work plan's way down to its step: faint, it only ties the sheet to the box */
  .guide {
    stroke: var(--steel);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .sheet .paper {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .sheet .lines {
    stroke: var(--ink);
    stroke-opacity: 0.55;
  }
  .axis {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  /* a narrow column: natural size (the SVG units become px, 13px text), scrolling sideways
     inside the panel, the lane names pinned at its left edge. 63rem: scaled to fit any
     narrower, the chart text would drop under 12px */
  @container (max-width: 63rem) {
    .rf-inner {
      width: calc(104px + 860px + 1.9rem); /* short names 104 + chart 860 */
      padding-left: 0;
    }
    /* the inner's left padding moves into the names, so they pin where they start; short
       names in a narrow column (the SVG keeps 1:1 and is cropped, preserveAspectRatio slice) */
    .rf-inner .rf-names {
      flex: 0 0 calc(104px + 0.9rem);
      height: 412px; /* H: with the width cut, slice keeps the scale 1:1 (beats `.rf-inner svg`) */
      padding-left: 0.9rem;
    }
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .rf-chart {
      flex: 0 0 860px;
    }
    .rf-names {
      box-shadow: 1px 0 0 var(--line);
    }
    .rf-hint {
      display: block;
    }
  }
</style>
