---
// Projekte, Masterarbeit (back in use 2026-10-14). Result of the Master thesis' industry case (Diehl Aviation): cumulative energy demand of an
// FDM-printed air guide vane (Ultem 9085) over 10 years in an A350, per life-cycle phase.
// Source: Masterarbeit, Tabellen 25 und 26 (MJ pro Stück). Published with the owner's clearance.
// Plain bars on one shared scale (owner: "just a clear bar"): the point is that the use phase
// is almost the whole bar, so the four other phases are shown together and named in the text.
const variants = [
  { id: "voll", name: "Massiv gedruckt", phases: { material: 4.08, produktion: 5.36, transport: 6.13, nutzung: 1566.28, entsorgung: 0.48 } },
  { id: "hohl", name: "Hohl gedruckt", phases: { material: 1.63, produktion: 2.16, transport: 1.97, nutzung: 503.45, entsorgung: 0.15 } },
];

const rows = variants.map((v) => {
  const p = v.phases;
  const rest = p.material + p.produktion + p.transport + p.entsorgung;
  const total = rest + p.nutzung;
  return { ...v, rest, use: p.nutzung, total, useShare: p.nutzung / total };
});
const max = Math.max(...rows.map((r) => r.total));
const fmt = (n: number, d = 0) => n.toLocaleString("de-DE", { maximumFractionDigits: d, minimumFractionDigits: d });
const pct = (n: number) => `${((n / max) * 100).toFixed(2)}%`;
const saving = 1 - rows[1].total / rows[0].total;
---

<figure class="lc">
  <div class="panel">
  <p class="lc-head">
    Kumulierter Energieaufwand einer Luftleitschaufel über 10 Jahre im A350, in Megajoule pro Stück
  </p>
  <ul class="lc-rows">
    {
      rows.map((r) => (
        <li class="lc-row">
          <span class="lc-name">{r.name}</span>
          <span class="lc-track" aria-hidden="true">
            <span class="lc-use" style={`width:${pct(r.use)}`} />
            <span class="lc-rest" style={`width:${pct(r.rest)}`} />
          </span>
          <span class="lc-total">{fmt(r.total)}&nbsp;MJ</span>
          <span class="lc-read">
            davon Nutzung {fmt(r.use)}&nbsp;MJ ({fmt(r.useShare * 100, 1)}&nbsp;%), Material, Produktion, Transport und
            Entsorgung zusammen {fmt(r.rest, 1)}&nbsp;MJ
          </span>
        </li>
      ))
    }
  </ul>
  <p class="lc-key">
    <span><i class="sw sw-use"></i>Nutzung im Flugzeug</span>
    <span><i class="sw sw-rest"></i>Material, Produktion, Transport, Entsorgung</span>
  </p>
  </div>
  <figcaption>
    Die hohle Variante braucht rund {fmt(saving * 100)}&nbsp;% weniger Energie, fast ausschließlich, weil sie leichter ist
    und deshalb im Flug weniger Kerosin kostet. Quelle: eigene Masterarbeit, Anwendungsbeispiel mit Diehl Aviation;
    ohne die konventionell gefertigte Referenz, für die keine Daten vorlagen.
  </figcaption>
</figure>

<style>
  /* the same white panel with a hairline edge as the other project figures (2026-10-14; it used
     to open with an ink rule when it stood alone) */
  .lc {
    margin: 0;
    max-width: 50rem;
  }
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 1rem clamp(0.75rem, 3vw, 1.5rem) 1rem;
  }

  .lc-head {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
    max-width: 40rem;
  }

  .lc-rows {
    margin-top: 1.25rem;
    display: grid;
    gap: 1.1rem;
  }

  /* name | total above, the bar, then the readout */
  .lc-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name total"
      "track track"
      "read read";
    gap: 0.35rem 1rem;
  }

  .lc-name {
    grid-area: name;
    font-weight: 600;
  }

  .lc-total {
    grid-area: total;
    font-weight: 600;
  }

  .lc-track {
    grid-area: track;
    display: flex;
    height: 1rem;
  }

  /* ink for the flight, steel for the rest (2026-10-14: was a white outlined box, which vanished
     on the white panel), with the 2px paper gap the heliostat chart uses */
  .lc-use,
  .lc-rest {
    display: block;
    height: 100%;
    box-sizing: border-box;
  }

  .lc-use {
    background: var(--ink);
    border-radius: 3px 0 0 3px;
  }

  /* about 1 % of the bar: kept visible as a 3px steel sliver after the gap */
  .lc-rest {
    min-width: 5px;
    background: var(--steel);
    border-left: 2px solid var(--paper);
    border-radius: 0 3px 3px 0;
  }

  .lc-read {
    grid-area: read;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .lc-key {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .lc-key span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .sw {
    display: inline-block;
    width: 1.25rem;
    height: 0.625rem;
    border-radius: 3px;
  }

  .sw-use {
    background: var(--ink);
  }

  .sw-rest {
    background: var(--steel);
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
  }
</style>
