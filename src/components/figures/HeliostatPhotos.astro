---
import { url } from "../../lib/url";

// The Bachelorarbeit's pictures (2026-10-14): the object first (the critic: lead with the work, not
// a press photo), then the place. DLR's photo
// of the Jülich towers from the heliostat field (CC BY-NC-ND 3.0: shown whole, only resized, never
// cropped, with the credit; original in assets-src/projekte/juelich-solartuerme.jpg, page
// dlr.de/de/ff/medien/bilder/solartuerme-juelich/die-angestrahlten-juelicher-solartuerme-fotografiert-aus-dem-heliostat-feld).
// On top the new design from the thesis (Abbildung 6, split in two, black frames trimmed): the CAD
// model the costs were calculated for, and the earlier prototype. The pair shares one height:
// the columns follow the two pictures' widths.
const src = (id: string) => url(`/img/projekte/${id}.webp`);
---

<div class="hp">
  <div class="pair">
    <figure class="shot">
      <img
        class="cad"
        src={src("heliostat-cad")}
        alt="CAD-Modell des neuen Heliostaten: ein schwarzes Rohr als Säule, darauf ein Ausleger und ein schräg gestellter Spiegel mit Rahmen"
        width="335"
        height="391"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Der Entwurf im CAD: für ihn habe ich die Kosten berechnet</figcaption>
    </figure>
    <figure class="shot">
      <img
        class="proto"
        src={src("heliostat-prototyp")}
        alt="Früherer Prototyp im Freien: eine Säule aus Aluminium auf einer Bodenplatte, darauf der schräg gestellte Spiegel"
        width="387"
        height="391"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Der frühere Prototyp, eine Einzelfertigung</figcaption>
    </figure>
  </div>
  <figure class="shot big">
    <img
      class="dlr"
      src={src("juelich")}
      srcset={`${url("/img/projekte/juelich-640.webp")} 640w, ${src("juelich")} 1200w`}
      sizes="(min-width: 56rem) 45vw, 100vw"
      alt="Blick aus dem Heliostatfeld: schräg gestellte Spiegel im Vordergrund, dahinter die beiden Solartürme, über ihnen die Sonne"
      width="1200"
      height="675"
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      Die beiden Solartürme in Jülich, fotografiert aus dem Heliostatfeld.
      <span class="credit">
        Foto: DLR, <a class="prose-link" href="https://creativecommons.org/licenses/by-nc-nd/3.0/" rel="license noopener">CC BY-NC-ND 3.0</a>
      </span>
    </figcaption>
  </figure>
</div>

<style>
  /* capped like RingPhotos on narrower screens */
  .hp {
    max-width: 36rem;
    display: grid;
    gap: 1rem;
  }
  .shot {
    margin: 0;
  }
  .pair {
    display: grid;
    grid-template-columns: 335fr 387fr;
    gap: 0.75rem;
    align-items: start;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  /* the ratio set in CSS as well: from the width/height attributes alone it applies to the
     content box, so the 1px border left the narrower pictures of a row ~1px shorter */
  .cad {
    aspect-ratio: 335 / 391;
  }
  .proto {
    aspect-ratio: 387 / 391;
  }
  .dlr {
    aspect-ratio: 1200 / 675;
  }
  figcaption {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-3);
  }
  .credit {
    display: block;
  }
  /* wide screens: one row under the project text on 1:1:2 columns (critic 2026-10-15: the old
     columns by aspect left the DLR picture 156px off the facts' edge; now it starts half a column
     early, a deliberate step). All three at one height: the DLR picture keeps its 16:9 (never
     cropped), so CAD and prototype take 8:9 (2 x 9/16 = 9/8 of a column), a mild crop: 4% of the
     CAD's height, 10% of the prototype photo's width */
  @media (min-width: 56rem) {
    .hp {
      max-width: none;
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2fr);
      column-gap: 0.75rem;
      align-items: start;
    }
    .pair {
      display: contents;
    }
    img.cad,
    img.proto {
      aspect-ratio: 8 / 9;
      object-fit: cover;
    }
  }
</style>
