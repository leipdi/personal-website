---
import Placeholder from "../Placeholder.astro";

// Hobbys (owner 2026-10-03): a desk of widgets, after the desktop idea of a portfolio on
// Awwwards (elenagonci.com). Facts from the owner: plays football and coaches, follows
// football and basketball, likes going out and sport, but also games and is a bit of a
// nerd; from LinkedIn: 3D printing, own projects automated with Claude. A switch picks out
// the outdoor or the indoor side. All copy here is an AI draft (Placeholder).
const tactic = {
  // players of the attacking side (petrol) and where the move takes them
  team: [
    { from: [70, 150], to: [150, 92] },
    { from: [120, 220], to: [210, 175] },
    { from: [180, 120], to: [260, 70] },
  ],
  // the ball: from the first player to where the second has run, then into the box to
  // where the third has run
  ball: [
    [70, 150],
    [210, 175],
    [260, 70],
  ],
  rivals: [
    [200, 160],
    [240, 110],
    [150, 60],
  ],
};
---

<section id="hobbys" class="sec" aria-labelledby="h-hobbys">
  <div class="wrap page">
    <div class="head">
      <h2 id="h-hobbys" class="display page-title">Hobbys</h2>
      <div class="switch" role="radiogroup" aria-label="Welche Seite zeigen" data-switch>
        <button type="button" role="radio" aria-checked="false" data-mode="out">Draußen</button>
        <button type="button" role="radio" aria-checked="true" data-mode="all">Beides</button>
        <button type="button" role="radio" aria-checked="false" data-mode="in">Drinnen</button>
      </div>
    </div>

    <Placeholder note="Texte der Widgets: KI-Entwurf aus Daniels Angaben">
      <ul class="desk" data-desk data-mode="all">
        <!-- football: playing and coaching, a tactics board with a move to play -->
        <li class="w w-tactic" data-side="out">
          <div class="w-head">
            <h3>Fußball</h3>
            <p>Ich spiele selbst und stehe als Trainer an der Seitenlinie.</p>
          </div>
          <svg class="tactic" viewBox="0 0 320 260" aria-hidden="true" data-tactic>
            <rect width="320" height="260" rx="10" fill="#1f7a4d"></rect>
            <g fill="none" stroke="#ffffff" stroke-opacity="0.75" stroke-width="2">
              <rect x="14" y="14" width="292" height="232"></rect>
              <rect x="226" y="70" width="80" height="120"></rect>
              <rect x="276" y="104" width="30" height="52"></rect>
              <circle cx="14" cy="130" r="44"></circle>
            </g>
            <!-- the move, as the coach draws it -->
            <g fill="none" stroke="#ffffff" stroke-width="2" stroke-dasharray="6 5" opacity="0.9">
              {tactic.team.map((p) => <line x1={p.from[0]} y1={p.from[1]} x2={p.to[0]} y2={p.to[1]} data-move />)}
            </g>
            <path d={`M${tactic.ball.map((b) => b.join(" ")).join(" L")}`} fill="none" stroke="#ffffff" stroke-width="2.5" data-pass></path>
            {tactic.rivals.map(([x, y]) => <g transform={`translate(${x} ${y})`} stroke="#ffffff" stroke-width="3"><line x1="-7" y1="-7" x2="7" y2="7" /><line x1="7" y1="-7" x2="-7" y2="7" /></g>)}
            {
              tactic.team.map((p, i) => (
                <circle cx={p.from[0]} cy={p.from[1]} r="10" fill="#0f1b2d" stroke="#ffffff" stroke-width="2.5" data-player={i}></circle>
              ))
            }
            <circle cx={tactic.ball[0][0]} cy={tactic.ball[0][1]} r="6" fill="#ffffff" stroke="#0f1b2d" stroke-width="2" data-ball></circle>
          </svg>
          <button type="button" class="play" data-play>Spielzug abspielen</button>
        </li>

        <!-- basketball -->
        <li class="w w-ball" data-side="out">
          <svg class="art" viewBox="0 0 200 140" aria-hidden="true">
            <rect x="120" y="18" width="62" height="42" rx="3" fill="#ffffff" stroke="#0f1b2d" stroke-width="2.5"></rect>
            <rect x="139" y="34" width="24" height="16" fill="none" stroke="#b4532a" stroke-width="2"></rect>
            <line x1="126" y1="60" x2="176" y2="60" stroke="#b4532a" stroke-width="4"></line>
            <path d="M130 60 l8 26 l8 -26 l8 26 l8 -26 l8 26" fill="none" stroke="#0f1b2d" stroke-width="1.5"></path>
            <g transform="translate(62 84)">
              <circle r="38" fill="#e07a2e" stroke="#0f1b2d" stroke-width="2.5"></circle>
              <path d="M-38 0 H38 M0 -38 V38 M-27 -27 C -10 -10, -10 10, -27 27 M27 -27 C 10 -10, 10 10, 27 27" fill="none" stroke="#0f1b2d" stroke-width="2"></path>
            </g>
            <path d="M100 50 C 110 30, 118 26, 124 30" fill="none" stroke="#0f1b2d" stroke-width="1.5" stroke-dasharray="3 4"></path>
          </svg>
          <h3>Basketball</h3>
          <p>Neben Fußball der Sport, den ich am liebsten verfolge.</p>
        </li>

        <!-- going out -->
        <li class="w w-night" data-side="out">
          <svg class="art" viewBox="0 0 200 140" aria-hidden="true">
            <rect width="200" height="140" rx="8" fill="#1c2a4a"></rect>
            <circle cx="160" cy="30" r="14" fill="#f4f6f8"></circle>
            <circle cx="166" cy="25" r="12" fill="#1c2a4a"></circle>
            {[[20, 22], [60, 14], [100, 30], [130, 12], [40, 44]].map(([x, y]) => <circle cx={x} cy={y} r="1.6" fill="#ffffff" />)}
            <g fill="#0f1b2d">
              <rect x="10" y="70" width="34" height="70"></rect>
              <rect x="48" y="50" width="28" height="90"></rect>
              <rect x="80" y="82" width="40" height="58"></rect>
              <rect x="124" y="60" width="30" height="80"></rect>
              <rect x="158" y="88" width="34" height="52"></rect>
            </g>
            <g fill="#f2c94c">
              {[[16, 80], [28, 96], [54, 62], [64, 84], [88, 92], [104, 108], [130, 72], [140, 96], [166, 100], [178, 116]].map(([x, y]) => <rect x={x} y={y} width="6" height="8" />)}
            </g>
          </svg>
          <h3>Ausgehen</h3>
          <p>Freunde treffen, raus in die Stadt, gern auch spontan.</p>
        </li>

        <!-- gaming -->
        <li class="w w-game" data-side="in">
          <svg class="art" viewBox="0 0 200 140" aria-hidden="true">
            <rect width="200" height="140" rx="8" fill="#141a2e"></rect>
            <g transform="translate(40 40)">
              <path d="M24 0 h72 a24 24 0 0 1 24 24 v6 a30 30 0 0 1 -52 20 h-16 a30 30 0 0 1 -52 -20 v-6 a24 24 0 0 1 24 -24 z" fill="#2f55c7" stroke="#ffffff" stroke-width="2.5"></path>
              <rect x="18" y="20" width="22" height="7" rx="1" fill="#ffffff"></rect>
              <rect x="25.5" y="12.5" width="7" height="22" rx="1" fill="#ffffff"></rect>
              <circle cx="88" cy="16" r="5" fill="#0e9384"></circle>
              <circle cx="100" cy="28" r="5" fill="#b4532a"></circle>
              <circle cx="76" cy="28" r="5" fill="#f2c94c"></circle>
              <circle cx="88" cy="40" r="5" fill="#ffffff"></circle>
            </g>
            <g fill="#0e9384">
              {[0, 1, 2, 3, 4].map((i) => <rect x={14 + i * 8} y="114" width="6" height="6" opacity={0.4 + i * 0.15} />)}
            </g>
            <text x="186" y="122" text-anchor="end" font-size="11" fill="#9fb0c3" font-family="Schibsted Grotesk, sans-serif">Level up</text>
          </svg>
          <h3>Gaming</h3>
          <p>Zocken gehört für mich genauso dazu wie der Platz.</p>
        </li>

        <!-- the nerd corner: 3D printing and own projects with Claude -->
        <li class="w w-nerd" data-side="in">
          <div class="nerd">
            <svg class="art printer" viewBox="0 0 120 120" aria-hidden="true">
              <rect x="10" y="10" width="100" height="100" rx="6" fill="#ffffff" stroke="#0f1b2d" stroke-width="2.5"></rect>
              <line x1="18" y1="34" x2="102" y2="34" stroke="#7d8b99" stroke-width="3"></line>
              <g class="nozzle"><rect x="48" y="30" width="22" height="14" rx="2" fill="#0f1b2d"></rect><path d="M55 44 h8 l-4 7 z" fill="#0f1b2d"></path></g>
              <rect x="30" y="96" width="60" height="6" fill="#7d8b99"></rect>
              <g class="layers">
                {[0, 1, 2, 3, 4, 5].map((i) => <rect x={42 - i * 0} y={90 - i * 6} width="36" height="5" rx="1" fill="#0e9384" style={`--l:${i}`} />)}
              </g>
            </svg>
            <pre class="term" aria-hidden="true"><span class="p">$</span> claude "Report bauen"
<span class="ok">✓</span> fertig<span class="cur">_</span></pre>
          </div>
          <h3>Ein bisschen Nerd</h3>
          <p>Drucke Teile mit dem 3D-Drucker und automatisiere eigene Projekte mit Claude.</p>
        </li>
      </ul>
    </Placeholder>
  </div>
</section>

<script>
  // the switch: picks out the outdoor or the indoor widgets (the others step back)
  const sw = document.querySelector<HTMLElement>("[data-switch]");
  const desk = document.querySelector<HTMLElement>("[data-desk]");
  if (sw && desk) {
    const btns = [...sw.querySelectorAll<HTMLButtonElement>("[data-mode]")];
    // a radiogroup: only the checked button is in the Tab order, the arrow keys (and
    // Home/End) move the choice
    const set = (mode: string) => {
      desk.dataset.mode = mode;
      for (const b of btns) {
        const on = b.dataset.mode === mode;
        b.setAttribute("aria-checked", String(on));
        b.tabIndex = on ? 0 : -1;
      }
    };
    set(desk.dataset.mode || "all");
    btns.forEach((b, i) => {
      b.addEventListener("click", () => set(b.dataset.mode!));
      b.addEventListener("keydown", (e) => {
        const k = e.key;
        let n = -1;
        if (k === "ArrowRight" || k === "ArrowDown") n = (i + 1) % btns.length;
        else if (k === "ArrowLeft" || k === "ArrowUp") n = (i - 1 + btns.length) % btns.length;
        else if (k === "Home") n = 0;
        else if (k === "End") n = btns.length - 1;
        if (n < 0) return;
        e.preventDefault();
        btns[n].focus();
        set(btns[n].dataset.mode!);
      });
    });
  }

  // the tactics board: the move plays out (players run their lines, the ball goes along its
  // passes); instant with reduced motion
  const board = document.querySelector<SVGSVGElement>("[data-tactic]");
  const play = document.querySelector<HTMLButtonElement>("[data-play]");
  if (board && play) {
    const players = [...board.querySelectorAll<SVGCircleElement>("[data-player]")];
    const ball = board.querySelector<SVGCircleElement>("[data-ball]")!;
    const lines = [...board.querySelectorAll<SVGLineElement>("[data-move]")];
    const start = players.map((p) => [Number(p.getAttribute("cx")), Number(p.getAttribute("cy"))]);
    const goal = lines.map((l) => [Number(l.getAttribute("x2")), Number(l.getAttribute("y2"))]);
    const path = board.querySelector<SVGPathElement>("[data-pass]")!;
    const ballPts = path
      .getAttribute("d")!
      .replace("M", "")
      .split(" L")
      .map((s) => s.split(" ").map(Number));
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    // first half: the players run their lines; second half: the ball follows its passes
    const place = (t: number) => {
      players.forEach((p, i) => {
        const k = ease(Math.min(Math.max(t * 2.2 - i * 0.1, 0), 1));
        p.setAttribute("cx", String(start[i][0] + (goal[i][0] - start[i][0]) * k));
        p.setAttribute("cy", String(start[i][1] + (goal[i][1] - start[i][1]) * k));
      });
      // the ball along its passes, one leg after the other
      const legs = ballPts.length - 1;
      const pos = Math.min(Math.max((t - 0.5) * 2, 0), 0.999) * legs;
      const j = Math.floor(pos);
      const f = ease(pos - j);
      ball.setAttribute("cx", String(ballPts[j][0] + (ballPts[j + 1][0] - ballPts[j][0]) * f));
      ball.setAttribute("cy", String(ballPts[j][1] + (ballPts[j + 1][1] - ballPts[j][1]) * f));
    };
    let raf = 0;
    play.addEventListener("click", () => {
      cancelAnimationFrame(raf);
      if (reduce.matches) return place(1);
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - t0) / 2200, 1);
        place(t);
        if (t < 1) raf = requestAnimationFrame(step);
      };
      place(0);
      raf = requestAnimationFrame(step);
    });
  }
</script>

<style>
  .page {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-block);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: var(--sp-gap);
  }

  /* Draußen | Beides | Drinnen */
  .switch {
    display: inline-flex;
    padding: 4px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
  }

  .switch button {
    padding: 0.45rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
  }

  .switch button[aria-checked="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  /* ---------- the desk: widgets on a grid ---------- */
  .desk {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .desk {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .w-tactic {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .desk {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(12rem, auto);
    }
    /* the board takes 2x2, the four others fill the two rows beside it */
    .w-tactic {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .w {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.1rem 1.15rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 1px 0 rgb(15 27 45 / 0.04);
    transition: opacity 0.3s, transform 0.3s;
  }

  .w h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .w p {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .w .art {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 0.4rem;
    border-radius: 8px;
  }

  /* the switch: the other side steps back */
  .desk[data-mode="out"] .w[data-side="in"],
  .desk[data-mode="in"] .w[data-side="out"] {
    opacity: 0.28;
    transform: scale(0.97);
  }

  /* the tactics board widget */
  .w-head {
    display: grid;
    gap: 0.25rem;
  }

  .tactic {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 0.4rem;
    border-radius: 10px;
  }

  .play {
    align-self: flex-start;
    margin-top: 0.4rem;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }

  .play:hover {
    background: var(--ink-2);
    border-color: var(--ink-2);
  }

  /* dark widgets */
  .w-game {
    background: #141a2e;
    border-color: #141a2e;
  }
  .w-game h3 {
    color: #ffffff;
  }
  .w-game p {
    color: #b8c4d4;
  }

  /* the nerd corner: printer beside a terminal */
  .nerd {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.4rem;
  }

  .printer {
    margin: 0;
  }

  .term {
    margin: 0;
    padding: 0.8rem 0.9rem;
    border-radius: 8px;
    background: #0f1b2d;
    color: #e6edf5;
    font: 0.75rem/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    white-space: pre;
    overflow-x: auto;
  }

  /* from 64rem the widget is narrow (a quarter of the desk): the printer above the terminal
     (after the base rules, or they win) */
  @media (min-width: 64rem) {
    .nerd {
      grid-template-columns: minmax(0, 1fr);
    }
    .w .printer {
      width: 6rem;
    }
  }

  .term .p {
    color: #9fb0c3;
  }
  .term .ok {
    color: #3fc1a7;
  }
  .term .cur {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* the print grows layer by layer */
  .layers rect {
    animation: layer 4.8s infinite;
    animation-delay: calc(var(--l) * 0.6s);
    opacity: 0;
  }

  @keyframes layer {
    0% {
      opacity: 0;
    }
    10%,
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .nozzle {
    animation: nozzle 1.2s ease-in-out infinite alternate;
  }

  @keyframes nozzle {
    from {
      transform: translateX(-14px);
    }
    to {
      transform: translateX(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layers rect,
    .nozzle,
    .term .cur {
      animation: none;
      opacity: 1;
    }
  }
</style>
