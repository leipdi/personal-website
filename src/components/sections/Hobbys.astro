---
// Hobbys (owner 2026-10-10): a shelf of six compartments as a real-time three.js scene, after
// devanshuchauhan.in (a shelf of favourite things that come alive when pointed at). Picked by
// the owner over a photo collage and a drawn shelf; history in docs/decisions.md
// (mockups in git history). The scene (src/scripts/hobby-shelf) loads only when the section comes near the
// screen; without JS or WebGL the list carries the content alone. Facts from the owner: plays
// football and coaches, follows football and basketball, goes out, games and is a bit of a
// nerd; from LinkedIn: 3D printing, own projects automated with Claude. The copy started as an
// AI draft (accepted by the owner 2026-10-09).
const hobbies = [
  { id: "fussball", title: "Fußball", text: "Ich spiele selbst." },
  { id: "trainer", title: "Trainer", text: "Und ich stehe als Trainer an der Seitenlinie." },
  { id: "basketball", title: "Basketball", text: "Neben Fußball der Sport, den ich am liebsten verfolge." },
  { id: "ausgehen", title: "Ausgehen", text: "Freunde treffen, raus in die Stadt, gern auch spontan." },
  { id: "gaming", title: "Gaming", text: "Abwechslung zum Alltag." },
  { id: "nerd", title: "Ein bisschen Nerd", text: "Drucke Teile mit dem 3D-Drucker und automatisiere eigene Projekte mit Claude." },
];
---

<section id="hobbys" class="sec" aria-labelledby="h-hobbys" data-hobbys>
  <div class="wrap page">
    <div class="head">
      <h2 id="h-hobbys" class="display page-title">Hobbys</h2>
    </div>

    <div class="room">
      <div class="stage" data-stage>
        <p class="loading">Regal wird aufgebaut …</p>
        <button type="button" class="back" data-back>Zurück zum Regal</button>
        <button type="button" class="step prev" data-prev aria-label="Voriges Fach">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <button type="button" class="step next" data-next aria-label="Nächstes Fach">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
      <!-- (the Draußen | Beides | Drinnen switch was removed 2026-10-16: a filter for six items) -->
      <ul class="list" data-list>
        {
          hobbies.map((h) => (
            <li>
              <button type="button" class="row" data-id={h.id}>
                <span class="t">{h.title}</span>
                <span class="d">{h.text}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-hobbys]");
  if (root) {
    // the 3D shelf: three.js is fetched when the section comes near the screen, but the scene
    // (about a second of main-thread work) is only built once the stage is on screen, so it
    // never stalls the scroll through the sections above
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    let mod: Promise<typeof import("../../scripts/hobby-shelf")> | null = null;
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        mod = import("../../scripts/hobby-shelf");
        mod.catch(() => root.classList.add("no-3d"));
      },
      { rootMargin: "800px 0px" },
    );
    const seen = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      seen.disconnect();
      (mod ??= import("../../scripts/hobby-shelf"))
        .then((m) => m.initShelf(root))
        .catch(() => root.classList.add("no-3d"));
    });
    near.observe(root);
    if (stage) seen.observe(stage);
  }
</script>

<style>
  .page {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-block);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: var(--sp-gap);
  }

  .row:focus-visible,
  .back:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* ---------- the shelf beside its list ---------- */
  .room {
    display: grid;
    gap: var(--sp-gap);
    align-items: start;
  }

  /* the list stands at the shelf's middle, not hugging its top (a critic found the shelf
     floating beside a short list on wide screens, 2026-10-10); from 100rem the shelf takes
     three quarters of the column */
  @media (min-width: 64rem) {
    .room {
      grid-template-columns: 8fr 4fr;
      grid-template-rows: 1fr auto 1fr;
      row-gap: 0;
    }
    .stage {
      grid-column: 1;
      grid-row: 1 / -1;
      align-self: center;
    }
    .list {
      grid-column: 2;
      grid-row: 2;
    }
  }

  @media (min-width: 100rem) {
    .room {
      grid-template-columns: 3fr 1fr;
    }
  }

  /* the stage only exists with JS; without it (or without WebGL) the list stands alone */
  .stage {
    display: none;
    position: relative;
    aspect-ratio: 16 / 10;
    touch-action: pan-y;
  }

  :global(html.js) .stage {
    display: block;
  }

  :global(html.js) .no-3d .stage {
    display: none;
  }

  .no-3d .room,
  :global(html:not(.js)) .room {
    grid-template-columns: none;
    grid-template-rows: none;
    row-gap: 1.25rem;
  }
  .no-3d .room > *,
  :global(html:not(.js)) .room > * {
    grid-column: auto;
    grid-row: auto;
  }
  /* the list alone: in columns, so six short rows don't leave the right half of the page empty */
  @media (min-width: 48rem) {
    .no-3d .list,
    :global(html:not(.js)) .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-gap);
      row-gap: 0.75rem;
    }
  }
  @media (min-width: 64rem) {
    .no-3d .list,
    :global(html:not(.js)) .list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* soft edges, so a zoomed-in view fades out instead of ending on a hard line */
  .stage :global(canvas) {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent), linear-gradient(transparent, #000 3%, #000 97%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent), linear-gradient(transparent, #000 3%, #000 97%, transparent);
    mask-composite: intersect;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s;
  }

  .stage:global(.is-ready) :global(canvas) {
    opacity: 1;
  }

  .stage:global(.is-hover) {
    cursor: pointer;
  }

  .stage:global(.is-focus) {
    cursor: zoom-out;
  }

  .loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink-2);
    font-size: 0.9375rem;
    transition: opacity 0.4s;
  }

  .stage:global(.is-ready) .loading {
    opacity: 0;
    pointer-events: none;
  }

  /* the name tag over the compartment in focus (added by the script) */
  .stage :global(.tag) {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    pointer-events: none;
    padding: 0.2rem 0.75rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .stage :global(.tag.is-on) {
    opacity: 1;
  }

  .back {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 3;
    padding: 0.4rem 0.9rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    opacity: 0;
    translate: 0 -6px;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.3s, translate 0.3s, visibility 0s 0.3s;
  }

  /* zoomed in: one control bar at the bottom, ‹ name › (the name tag sits between) */
  .step {
    position: absolute;
    bottom: 0.75rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0s 0.3s;
  }

  .step.prev {
    left: calc(50% - 9rem);
  }

  .step.next {
    right: calc(50% - 9rem);
  }

  .step:hover,
  .back:hover {
    background: var(--wash);
  }

  .step:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .stage:global(.is-focus) .step {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition: opacity 0.3s;
  }

  .stage:global(.is-focus) .back {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
    visibility: visible;
    transition: opacity 0.3s, translate 0.3s;
  }

  /* ---------- the list: traces the shelf both ways ---------- */
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .row {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    color: inherit;
    background: none;
    cursor: pointer;
    padding: 0.55rem 0 0.55rem 1rem;
    border: 0;
    border-left: 3px solid transparent;
    transition: opacity 0.25s, border-color 0.25s;
  }

  .row .t {
    display: block;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .row .d {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
    margin-top: 0.15rem;
  }

  /* beside the larger shelf (from 100rem) the list grows with it, or it read as a footnote */
  @media (min-width: 100rem) {
    .row {
      padding-block: 0.8rem;
    }
    .row .t {
      font-size: 1.5rem;
    }
    .row .d {
      font-size: 1.0625rem;
    }
  }

  .row:hover {
    border-left-color: var(--line);
  }

  .row:global(.is-on) {
    border-left-color: var(--ink);
  }

  /* the rows not in play step back in colour only (--ink-3 keeps 4.5:1 on every day colour) */
  .list:global(.has-on) .row:not(:global(.is-on)) .t,
  .list:global(.has-on) .row:not(:global(.is-on)) .d {
    color: var(--ink-3);
    font-weight: 400;
  }

  .list:global(.has-on) .row:not(:global(.is-on)) .t {
    font-weight: 500;
  }

  /* phones: the shelf takes the full width (every pixel counts), the list sits close under it
     as compact rows */
  @media (max-width: 47.99rem) {
    .stage {
      margin-inline: calc(-1 * var(--gutter));
    }
    .room {
      gap: 0.75rem;
    }
    .list {
      gap: 0;
    }
    .row {
      padding: 0.45rem 0 0.45rem 0.75rem;
    }
    .row .t {
      font-size: 1.125rem;
    }
    .row .d {
      font-size: 0.875rem;
      margin-top: 0.05rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step,
    .stage :global(canvas),
    .stage :global(.tag),
    .back,
    .row {
      transition: none;
    }
  }
</style>
