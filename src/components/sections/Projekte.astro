---
import { projects } from "../../data/cv";
import RingPhotos from "../figures/RingPhotos.astro";
import RingFlow from "../figures/RingFlow.astro";

// Projekte, rebuilt one project at a time in chronological order (owner 2026-10-13), each a
// full-width block: what the project was and how the team worked first, then the owner's role
// (lead, tasks with sub-lines like the Kernkompetenzen sheets, the facts); its figures beside
// and below. Mockups and picks:
// docs/decisions.md (Projekte). No card grid, no JS.
---

<section id="projekte" class="sec" aria-labelledby="h-projekte">
  <div class="wrap page">
    <h2 id="h-projekte" class="display page-title">Projekte</h2>

    {
      projects.map((p) => (
        <article id={p.id} class="proj" data-project aria-labelledby={`${p.id}-h`}>
          <header class="proj-head">
            <h3 id={`${p.id}-h`}>{p.title}</h3>
            <p class="where">{[p.org, p.period, p.team].filter(Boolean).join(", ")}</p>
          </header>

          <div class="top">
            <div class="prose">
              <p class="intro">{p.intro}</p>
              <dl class="brief">
                {p.brief.map((b) => (
                  <div>
                    <dt>{b.label}</dt>
                    <dd>{b.text}</dd>
                  </div>
                ))}
              </dl>
              <div class="role">
              <h4>{p.role}</h4>
              <p class="lead">{p.lead}</p>
              <ul class="tasks">
                {p.tasks.map((t) => (
                  <li>
                    {t.text}
                    {t.sub && <span class="sub">{t.sub}</span>}
                  </li>
                ))}
              </ul>
              <dl class="facts">
                {p.facts.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
                {p.tools.length > 0 && (
                  <div>
                    <dt>Software</dt>
                    <dd>{p.tools.join(", ")}</dd>
                  </div>
                )}
              </dl>
              </div>
            </div>
            {p.figure === "ringprojekt" && (
              <div class="side">
                <RingPhotos />
              </div>
            )}
          </div>

          {p.figure === "ringprojekt" && (
            <div class="flow">
              <h4>So lief das Semester</h4>
              <p class="cap">
                Oben und unten meine Arbeit als PPS, dazwischen das Team: zu jedem Fertigungsschritt ein Arbeitsplan von mir, während der Fertigung habe ich die Zeiten erfasst.
              </p>
              <RingFlow />
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .page {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-block);
  }
  .proj {
    margin-top: var(--sp-gap);
  }
  .proj + .proj {
    margin-top: var(--sp-block);
    padding-top: var(--sp-block);
    border-top: 1px solid var(--line);
  }
  .proj-head h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 40ch;
    text-wrap: balance;
  }
  .where {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .top {
    display: grid;
    gap: var(--sp-gap);
    margin-top: var(--sp-gap);
  }
  .prose h4,
  .flow h4 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .lead {
    margin-top: 0.5rem;
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .tasks {
    list-style: none;
    margin: 1rem 0 1.25rem;
    padding: 0;
  }
  .tasks > li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: 0.7rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.1875rem;
    line-height: 1.4;
  }
  .tasks > li::before {
    content: "";
    position: absolute;
    left: 0.1rem;
    top: 0.58em;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--ink);
  }
  .sub {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin: 0;
    font-size: 0.9375rem;
  }
  .facts dt {
    font-weight: 600;
    color: var(--ink);
  }
  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }
  /* the project first: a short intro, then the task and the team as two labelled points, then
     my role (owner 2026-10-13/14) */
  .intro {
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .brief {
    margin: 1.1rem 0 0;
    max-width: var(--measure);
  }
  .brief > div + div {
    margin-top: 0.85rem;
  }
  .brief dt {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .brief dd {
    margin: 0.15rem 0 0;
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .role {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .side {
    max-width: 34rem;
  }

  .flow {
    margin-top: var(--sp-block);
  }
  .cap {
    margin: 0.2rem 0 0.9rem;
    max-width: 52rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  /* wide: text | photos side by side */
  @media (min-width: 56rem) {
    .top {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }
    .side {
      max-width: none;
    }
  }
</style>
