---
import { projects } from "../../data/cv";
import RingPhotos from "../figures/RingPhotos.astro";
import RingFlow from "../figures/RingFlow.astro";
import HeliostatPhotos from "../figures/HeliostatPhotos.astro";
import HeliostatCost from "../figures/HeliostatCost.astro";
import ImpactScreen from "../figures/ImpactScreen.astro";
import LifeCycle from "../figures/LifeCycle.astro";

// Projekte, rebuilt one project at a time in chronological order (owner 2026-10-13), each a
// full-width block: what the project was and how the team worked first, then the owner's role
// (lead, tasks with sub-lines like the Kernkompetenzen sheets, the facts); its figures beside
// and below. Mockups and picks:
// docs/decisions.md (Projekte). No card grid. JS only marks the project in view in the bar.
---

<section id="projekte" class="sec" aria-labelledby="h-projekte">
  <div class="wrap head">
    <h2 id="h-projekte" class="display page-title">Projekte</h2>
  </div>

  <!-- the project bar (owner 2026-10-14: jump between the projects without scrolling through
       them): pinned under the top bar while Projekte is on screen, gone after it; the project in
       view gets an ink bar from the script below (plain anchors without JS) -->
  <nav class="pnav frost" aria-label="Projekte" data-pnav>
    <div class="wrap">
      <ul>
        {
          projects.map((p) => (
            <li>
              <a href={`#${p.id}`} data-pnav-link={p.id}>
                {p.tab}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="wrap page">

    {
      projects.map((p) => (
        <article id={p.id} class="proj" data-project aria-labelledby={`${p.id}-h`}>
          <header class="proj-head">
            <h3 id={`${p.id}-h`}>{p.title}</h3>
            <p class="where">{[p.org, p.period, p.team].filter(Boolean).join(", ")}</p>
          </header>

          <div class="top">
            <div class="prose">
              <p class="intro">{p.intro}</p>
              <dl class="brief">
                {p.brief.map((b) => (
                  <div>
                    <dt>{b.label}</dt>
                    <dd>{b.text}</dd>
                  </div>
                ))}
              </dl>
              <div class="role">
              <h4>{p.role}</h4>
              <p class="lead">{p.lead}</p>
              <ul class="tasks">
                {p.tasks.map((t) => (
                  <li>
                    {t.text}
                    {t.sub && <span class="sub">{t.sub}</span>}
                  </li>
                ))}
              </ul>
              <dl class="facts">
                {p.facts.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
                {p.tools.length > 0 && (
                  <div>
                    <dt>Software</dt>
                    <dd>{p.tools.join(", ")}</dd>
                  </div>
                )}
              </dl>
              {p.link && (
                <p class="link">
                  <a class="prose-link" href={p.link.href}>{p.link.label}</a>
                </p>
              )}
              </div>
            </div>
            {p.figure && (
              <div class="side">
                {p.figure === "ringprojekt" && <RingPhotos />}
                {p.figure === "heliostat" && <HeliostatPhotos />}
                {p.figure === "luftfahrt" && <ImpactScreen />}
              </div>
            )}
          </div>

          {p.figure === "ringprojekt" && (
            <div class="flow">
              <h4>So lief das Semester</h4>
              <p class="cap">
                Oben und unten meine Arbeit als PPS, dazwischen das Team: zu jedem Fertigungsschritt ein Arbeitsplan von mir, während der Fertigung habe ich die Zeiten erfasst.
              </p>
              <RingFlow />
            </div>
          )}

          {p.figure === "heliostat" && (
            <div class="flow">
              <h4>Vom Blechteil zum Heliostaten</h4>
              <p class="cap">
                Meine Endkalkulation, nach Baugruppen in der Reihenfolge, in der der Heliostat gebaut wird. Rund vier Fünftel der Kosten sind Material und Zukaufteile; am teuersten ist der Konzentrator mit dem Spiegelglas.
              </p>
              <HeliostatCost />
            </div>
          )}

          {p.figure === "luftfahrt" && (
            <div class="flow">
              <h4>Quantitativ: was der Praxischeck mit Diehl zeigt</h4>
              <p class="cap">
                Der rechnende Teil der Metrik, angewendet auf die Luftleitschaufel. Fast die ganze Energie fällt im Flug an: Jedes Kilogramm Bauteil kostet zehn Jahre lang Kerosin. Herstellung und Material sind dagegen Nebensache, deshalb spart die leichtere, hohle Variante so viel. Den einordnenden Teil zeigt die Relevanztabelle oben.
              </p>
              <LifeCycle />
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<script>
  import { onScrollFrame } from "../../scripts/page";

  // The project in view: the last one whose top has passed the bar's bottom plus 3rem (in rem,
  // so a jump that lands just under the bar counts at any root size). Only while the bar is pinned
  // under the top bar; before that (Projekte's head still scrolling in) nothing is marked.
  const bar = document.querySelector<HTMLElement>("[data-pnav]");
  const top = document.querySelector<HTMLElement>(".top");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-pnav-link]")];
  const arts = links.map((a) => document.getElementById(a.dataset.pnavLink!)).filter((el): el is HTMLElement => !!el);
  if (bar && arts.length) {
    let cur = "";
    const mark = () => {
      const b = bar.getBoundingClientRect();
      const pinned = b.top <= (top?.getBoundingClientRect().bottom ?? 0) + 1;
      const edge = b.bottom + 3 * parseFloat(getComputedStyle(document.documentElement).fontSize);
      let id = "";
      if (pinned) for (const el of arts) if (el.getBoundingClientRect().top <= edge) id = el.id;
      if (id === cur) return;
      cur = id;
      for (const a of links) {
        if (a.dataset.pnavLink === id) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };
    onScrollFrame(mark);
    addEventListener("resize", mark, { passive: true });
    mark();
  }
</script>

<style>
  .head {
    padding-top: var(--sp-section);
  }
  .page {
    padding-bottom: var(--sp-block);
  }

  /* pinned under the top bar (its height is measured by Werdegang's script; the fallbacks are
     its CSS heights), a hairline below: structure lines inside a section are hairlines */
  .pnav {
    position: sticky;
    top: var(--top-bar-h, calc(var(--top-h) + 1.5px));
    z-index: 30;
    margin-top: var(--sp-gap);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 64rem) {
    .pnav {
      top: var(--top-bar-h, calc(3.75rem + 1.5px));
    }
  }
  .pnav ul {
    display: flex;
    gap: clamp(1rem, 4vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .pnav a {
    display: block;
    padding: 0.55rem 0 0.4rem;
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .pnav a:hover {
    color: var(--ink);
    border-bottom-color: var(--line);
  }
  /* the project in view: ink and an ink bar (the spectrum stays on the top bar's bar) */
  .pnav a[aria-current="true"] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  /* 320: the three names fit without scrolling */
  @media (max-width: 22rem) {
    .pnav ul {
      gap: 0.625rem;
    }
    .pnav a {
      font-size: 0.875rem;
    }
  }

  /* a jump lands the project below both bars */
  .proj {
    margin-top: var(--sp-gap);
    scroll-margin-top: 2.75rem;
  }
  .proj + .proj {
    margin-top: var(--sp-block);
    padding-top: var(--sp-block);
    border-top: 1px solid var(--line);
    /* skip the gap above the title, so a jump puts the title right under the bar */
    scroll-margin-top: calc(2.75rem - var(--sp-block));
  }
  .proj-head h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 40ch;
    text-wrap: balance;
  }
  .where {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .top {
    display: grid;
    gap: var(--sp-gap);
    margin-top: var(--sp-gap);
  }
  .prose h4,
  .flow h4 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .lead {
    margin-top: 0.5rem;
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .tasks {
    list-style: none;
    margin: 1rem 0 1.25rem;
    padding: 0;
  }
  .tasks > li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: 0.7rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.1875rem;
    line-height: 1.4;
  }
  .tasks > li::before {
    content: "";
    position: absolute;
    left: 0.1rem;
    top: 0.58em;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--ink);
  }
  .sub {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin: 0;
    font-size: 0.9375rem;
  }
  .facts dt {
    font-weight: 600;
    color: var(--ink);
  }
  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }
  /* the project first: a short intro, then the task and the team as two labelled points, then
     my role (owner 2026-10-13/14) */
  .intro {
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .brief {
    margin: 1.1rem 0 0;
    max-width: var(--measure);
  }
  .brief > div + div {
    margin-top: 0.85rem;
  }
  .brief dt {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .brief dd {
    margin: 0.15rem 0 0;
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .role {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .link {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  .side {
    max-width: 34rem;
  }

  .flow {
    margin-top: var(--sp-block);
  }
  .cap {
    margin: 0.2rem 0 0.9rem;
    max-width: 52rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  /* wide: text | photos side by side */
  @media (min-width: 56rem) {
    .top {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }
    .side {
      max-width: none;
    }
  }
</style>
