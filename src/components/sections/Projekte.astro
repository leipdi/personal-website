---
import { projects } from "../../data/cv";
import RingPhotos from "../figures/RingPhotos.astro";
import RingFlow from "../figures/RingFlow.astro";
import HeliostatPhotos from "../figures/HeliostatPhotos.astro";
import HeliostatCost from "../figures/HeliostatCost.astro";
import ImpactScreen from "../figures/ImpactScreen.astro";
import LifeCycle from "../figures/LifeCycle.astro";
import ProjectMethod from "../ProjectMethod.astro";
import type { Project } from "../../data/cv";

// projects with a visual under the text (photo groups, the Masterarbeit's relevance table): on
// wide screens it runs as one row on the project's column grid (see the style block)
const photos = (p: Project) => p.figure === "ringprojekt" || p.figure === "heliostat" || p.figure === "luftfahrt";

// Projekte, rebuilt one project at a time in chronological order (owner 2026-10-13), each a
// full-width block: purpose, contribution and outcome first; methodology in native
// disclosures, with photos and result charts always visible. Mockups and picks:
// docs/decisions.md (Projekte). No card grid. JS only marks the project in view and runs the pill.
---

<section id="projekte" class="sec" aria-labelledby="h-projekte">
  <div class="wrap head">
    <h2 id="h-projekte" class="display page-title">Projekte</h2>
  </div>

  <div class="wrap page">
    <div class="layout">
      <!-- the project list (owner 2026-10-14, after top tabs he didn't like): a rail beside the
           projects on wide screens, pinned under the top bar; the project in view gets an ink
           bar that grows while it is read (script below; plain anchors without JS) -->
      <nav class="prail" aria-label="Projekte">
        <ol>
          {
            projects.map((p) => (
              <li>
                <a href={`#${p.id}`} data-pnav-link={p.id}>
                  <span class="yr tnum">{p.year}</span>
                  <span class="nm">{p.tab}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="projs">
    {
      projects.map((p) => (
        <article id={p.id} class="proj" data-project aria-labelledby={`${p.id}-h`}>
          <header class="proj-head">
            <h3 id={`${p.id}-h`}>{p.title}</h3>
            <p class="where">{[p.org, p.period, p.team].filter(Boolean).join(", ")}</p>
          </header>

          <div class="project-body grid">
            <div class="prose">
              <dl class="overview">
                <div>
                  <dt>Aufgabe</dt>
                  <dd>{p.intro}</dd>
                </div>
                <div>
                  <dt>Mein Beitrag</dt>
                  <dd>{p.contribution}</dd>
                </div>
                <div>
                  <dt>Ergebnis</dt>
                  <dd>{p.outcome}</dd>
                </div>
              </dl>
              <dl class="facts">
                {p.facts.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
                {p.tools.length > 0 && (
                  <div>
                    <dt>Software</dt>
                    <dd>{p.tools.join(", ")}</dd>
                  </div>
                )}
              </dl>
              {p.link && (
                <p class="link">
                  <a class="prose-link" href={p.link.href}>{p.link.label}</a>
                </p>
              )}
            </div>
            {photos(p) && (
              <div class="photos">
                {p.figure === "ringprojekt" && <RingPhotos />}
                {p.figure === "heliostat" && <HeliostatPhotos />}
                {p.figure === "luftfahrt" && <ImpactScreen />}
              </div>
            )}
          </div>

          <ProjectMethod project={p} />

          {p.figure === "ringprojekt" && (
            <div class="flow">
              <h4>So lief das Semester</h4>
              <p class="cap">
                Oben und unten meine Arbeit als PPS, dazwischen das Team: zu jedem Fertigungsschritt ein Arbeitsplan von mir, während der Fertigung habe ich die Zeiten erfasst.
              </p>
              <RingFlow />
            </div>
          )}

          {p.figure === "heliostat" && (
            <div class="flow">
              <h4>Vom Blechteil zum Heliostaten</h4>
              <p class="cap">
                Meine Endkalkulation, nach Baugruppen in der Reihenfolge, in der der Heliostat gebaut wird. Rund vier Fünftel der Kosten sind Material und Zukaufteile; am teuersten ist der Konzentrator mit dem Spiegelglas.
              </p>
              <HeliostatCost />
            </div>
          )}

          {p.figure === "luftfahrt" && (
            <div class="flow">
              <h4>Quantitativ: was der Praxischeck mit Diehl zeigt</h4>
              <p class="cap">
                Der rechnende Teil der Metrik, angewendet auf die Luftleitschaufel. Fast die ganze Energie fällt im Flug an: Jedes Kilogramm Bauteil kostet zehn Jahre lang Kerosin. Herstellung und Material sind dagegen Nebensache, deshalb spart die leichtere, hohle Variante so viel. Den einordnenden Teil zeigt die Relevanztabelle oben.
              </p>
              <LifeCycle />
            </div>
          )}
        </article>
      ))
    }
      </div>
    </div>
  </div>

  <!-- narrower screens: a small pill at the bottom while a project is in view; it opens the same
       list (JS only: without it the pill stays hidden and the page reads top to bottom) -->
  <nav class="ppill" aria-label="Projekte" data-ppill>
    <details>
      <summary class="frost">
        <span class="pos tnum" data-ppill-pos></span>
        <span class="nm" data-ppill-name></span>
      </summary>
      <ol>
        {
          projects.map((p) => (
            <li>
              <a href={`#${p.id}`} data-pnav-link={p.id}>
                <span class="yr tnum">{p.year}</span>
                <span class="nm">{p.tab}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </details>
  </nav>
</section>

<script>
  import { onScrollFrame, requestFrame } from "../../scripts/page";

  // The project in view: the last one whose top has passed the top bar plus 3rem (rem, so it holds
  // at any root size); it stays marked across the gap to the next one, until Projekte has left
  // under the top bar. Marks its links in the rail and the pill (aria-current), grows the rail's
  // ink bar with the share read (--p), and shows the pill only while a project is in view and
  // Projekte still fills the window (so it never sits over the Kenntnisse heading).
  const top = document.querySelector<HTMLElement>(".top");
  const section = document.getElementById("projekte");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-pnav-link]")];
  const ids = [...new Set(links.map((a) => a.dataset.pnavLink!))];
  const arts = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  const pill = document.querySelector<HTMLElement>("[data-ppill]");
  const details = pill?.querySelector("details");
  const pos = pill?.querySelector("[data-ppill-pos]");
  const name = pill?.querySelector("[data-ppill-name]");

  if (arts.length) {
    let cur = "";
    const mark = () => {
      const barBottom = top?.getBoundingClientRect().bottom ?? 0;
      const edge = barBottom + 3 * parseFloat(getComputedStyle(document.documentElement).fontSize);
      const secBottom = section?.getBoundingClientRect().bottom ?? Infinity;
      let id = "";
      // every project's share read (only the current one shows its bar), so none goes stale
      // when a resize moves the current project on
      const share = new Map<string, number>();
      for (const el of arts) {
        const r = el.getBoundingClientRect();
        share.set(el.id, Math.min(1, Math.max(0, (edge - r.top) / r.height)));
        if (secBottom > barBottom && r.top <= edge) id = el.id;
      }
      const showPill = !!id && secBottom >= innerHeight;
      if (pill && pill.classList.contains("on") !== showPill) {
        pill.classList.toggle("on", showPill);
        if (!showPill && details) details.open = false;
      }
      for (const a of links) a.style.setProperty("--p", (share.get(a.dataset.pnavLink!) ?? 0).toFixed(3));
      if (id === cur) return;
      cur = id;
      for (const a of links) {
        if (a.dataset.pnavLink === id) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
      const i = ids.indexOf(id);
      if (pos && name && i >= 0) {
        pos.textContent = `${i + 1}/${ids.length}`;
        name.textContent = links.find((a) => a.dataset.pnavLink === id)?.querySelector(".nm")?.textContent ?? "";
      }
    };
    onScrollFrame(mark);
    // Expanding a method changes project height without necessarily scrolling.
    section?.querySelectorAll<HTMLDetailsElement>("details.method").forEach((el) => {
      el.addEventListener("toggle", () => requestFrame(mark));
    });
    addEventListener("resize", mark, { passive: true });
    // Heights that settle a frame after a resize (wrapped text, the pile and Werdegang above)
    // move the projects without a scroll: mark again once the section's size changes.
    if (section) new ResizeObserver(() => requestFrame(mark)).observe(section);
    mark();
  }

  // the pill's list closes on a pick, Escape, a tap outside or focus leaving it
  if (details) {
    details.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) details.open = false;
    });
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && details.open) {
        details.open = false;
        details.querySelector("summary")?.focus();
      }
    });
    // keyboard focus moving on past the last link closes the list too
    details.addEventListener("focusout", (e) => {
      if (!details.contains(e.relatedTarget as Node)) details.open = false;
    });
    addEventListener("pointerdown", (e) => {
      if (details.open && !details.contains(e.target as Node)) details.open = false;
    });
  }
</script>

<style>
  .head {
    padding-top: var(--sp-section);
  }
  .page {
    padding-bottom: var(--sp-block);
  }

  /* wide screens: the rail beside the projects, pinned under the top bar (its height is measured
     by Werdegang's script; the fallback is its CSS height) */
  .prail {
    display: none;
  }
  @media (min-width: 75rem) {
    .layout {
      display: grid;
      grid-template-columns: 9.5rem minmax(0, 1fr);
      column-gap: clamp(2rem, 3vw, 3.5rem);
      align-items: start;
    }
    .prail {
      display: block;
      position: sticky;
      top: calc(var(--top-bar-h, calc(3.75rem + 1.5px)) + 1.75rem);
      margin-top: var(--sp-gap);
    }
  }
  .prail ol,
  .ppill ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* a hairline down the list; the project in view gets an ink bar on it that grows while read */
  .prail ol {
    border-left: 1px solid var(--line);
  }
  .prail li + li {
    margin-top: 0.9rem;
  }
  .prail a,
  .ppill ol a {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--ink-2);
  }
  .prail a {
    padding: 0.1rem 0 0.1rem 0.9rem;
  }
  .prail a::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--ink);
    transform-origin: top;
    transform: scaleY(0);
  }
  .prail a[aria-current="true"]::before {
    transform: scaleY(max(0.12, var(--p, 0)));
  }
  .yr {
    display: block;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .nm {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .prail a:hover,
  .prail a[aria-current="true"],
  .ppill ol a:hover,
  .ppill ol a[aria-current="true"] {
    color: var(--ink);
  }

  /* narrower screens: the pill, bottom centre, only while a project is in view (.on from the
     script); its list opens upward */
  .ppill {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 35;
    transform: translate(-50%, 0.5rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s,
      transform 0.2s,
      visibility 0s 0.2s;
  }
  .ppill.on {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  @media (min-width: 75rem) {
    .ppill {
      display: none;
    }
  }
  .ppill summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: 0 6px 20px rgb(15 27 45 / 0.12);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .ppill summary::-webkit-details-marker {
    display: none;
  }
  /* the chevron: points up while closed (the list opens upward), down while open */
  .ppill summary::after {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.15rem;
    border-left: 1.5px solid var(--ink);
    border-top: 1.5px solid var(--ink);
    transform: translateY(0.12rem) rotate(45deg);
  }
  .ppill details[open] summary::after {
    transform: translateY(-0.12rem) rotate(225deg);
  }
  .ppill .pos {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .ppill summary .nm {
    display: inline;
    color: var(--ink);
  }
  .ppill ol {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
    min-width: 13rem;
    padding: 0.4rem 0;
    /* solid: frosted, the text behind showed through the list */
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    box-shadow: 0 6px 20px rgb(15 27 45 / 0.12);
  }
  .ppill ol a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 1rem;
  }
  .ppill ol .yr {
    display: inline;
  }
  .ppill ol a[aria-current="true"] .nm {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .proj {
    margin-top: var(--sp-gap);
  }
  .proj + .proj {
    margin-top: var(--sp-block);
    padding-top: var(--sp-block);
    border-top: 1px solid var(--line);
    /* skip the gap above the title, so a jump puts the title right under the top bar */
    scroll-margin-top: calc(-1px - var(--sp-block)); /* the title lands as high as the first one's */
  }
  .proj-head h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 40ch;
    text-wrap: balance;
  }
  .where {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .project-body {
    display: grid;
    gap: var(--sp-gap);
    margin-top: var(--sp-gap);
  }
  .flow h4 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .overview {
    margin: 0;
  }
  .overview > div {
    display: flow-root;
  }
  .overview > div + div {
    margin-top: 1.1rem;
  }
  .overview dt {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .overview dd {
    margin: 0.25rem 0 0;
    max-width: 68ch;
    font-family: var(--serif);
    font-size: 1.1875rem;
    line-height: 1.5;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
  }
  .facts dt {
    font-weight: 600;
    color: var(--ink);
  }
  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }
  .link {
    margin-top: 1rem;
    font-size: 0.9375rem;
    max-width: 75ch;
  }
  .photos {
    max-width: 36rem;
  }

  .flow {
    margin-top: var(--sp-block);
  }
  .cap {
    margin: 0.2rem 0 0.9rem;
    max-width: 52rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  /* Wide screens: one column grid for the projects, as on the project pages of nendo,
     Pentagram and Jasper Morrison (docs/decisions.md, 2026-10-15): three equal columns, the
     text over the first two, the facts in the third, at its bottom, so they sit right above the
     visual and next to "Ergebnis" (grade, costs, the paper are results); the empty corner
     above them continues the space right of the title. The visual runs as one row under the
     text: the Ringprojekt's three photos and the Masterarbeit's three relevance levels on the
     same three columns (subgrid), so the facts start on the edge of the third; the
     Bachelorarbeit's pictures on 1:1:2 columns (the uncropped DLR picture starts half a column
     early, a deliberate step). The website has no visual and the same text and facts columns. */
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 0.75rem;
      /* on very large displays the columns stop growing (only above ~2000px): the text keeps its
         68ch line, so wider columns only pushed the facts away from it */
      max-width: 80rem;
    }
    .grid .prose,
    .grid .photos {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
    }
    .grid .prose {
      grid-template-rows: 1fr auto;
    }
    .grid .overview {
      grid-column: 1 / -2;
      grid-row: 1 / span 2;
      /* the gutter to the facts (the column gap is the photos' 0.75rem) */
      padding-right: var(--sp-gap);
    }
    .grid .facts {
      grid-column: -2 / -1;
      grid-row: 1;
      align-self: end;
      flex-direction: column;
      gap: 1rem;
      margin: 0;
    }
    .grid .link {
      grid-column: -2 / -1;
      grid-row: 2;
      margin-top: 1rem;
    }
    .photos {
      max-width: none;
    }
    /* more air above the pictures than below them: text, then pictures, read as two rows,
       and the pictures stay with the Details line under them */
    .grid .photos {
      margin-top: calc(var(--sp-block) - var(--sp-gap));
    }
  }
</style>
