---
import { projects } from "../../data/cv";
import type { Project } from "../../data/cv";
import { tool, uniqueSvg } from "../../data/tools";
import RingFlow from "../figures/RingFlow.astro";
import HeliostatCost from "../figures/HeliostatCost.astro";
import ImpactScreen from "../figures/ImpactScreen.astro";
import LifeCycle from "../figures/LifeCycle.astro";
import ProjectMethod from "../ProjectMethod.astro";
import ProjectSteps from "../ProjectSteps.astro";
import { url } from "../../lib/url";

// Projekte, rebuilt one project at a time in chronological order (owner 2026-10-13). Since
// 2026-10-15 mockup D (projekte-d-animiert.html, in git history): the short name large with the full title
// under it, year and place in a margin column; Aufgabe, Mein Beitrag and Ergebnis as headings
// hanging in that column, each with a line icon; the Ergebnis with its chart right after them
// (owner: the strongest part early), then from design to finished part scrolled through
// (ProjectSteps); the result charts build up when they come into view; software with logos.
// Methodology stays in native disclosures (ProjectMethod). No card grid. Mockups and picks:
// docs/decisions.md (Projekte). JS marks the project in view, runs the pill and the charts.

// the full title under the short name: the official title without the "Ringprojekt: " prefix
const subtitle = (p: Project) => {
  if (p.title === p.tab) return "";
  const rest = p.title.startsWith(`${p.tab}: `) ? p.title.slice(p.tab.length + 2) : p.title;
  return rest.charAt(0).toUpperCase() + rest.slice(1);
};

// line icons for the hanging headings, drawn like the site's figures (ink, 1.5 stroke, no fill)
const icons = {
  aufgabe: '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 12h7M9 15.5h7M9 19h4"/>',
  beitrag: '<path d="M4 20l1-4L16 5l3 3L8 19z"/><path d="M14 7l3 3"/><path d="M4 20h16"/>',
  ergebnis: '<path d="M6 21V3"/><path d="M6 4h11l-2.5 4L17 12H6"/>',
};
---

<section id="projekte" class="sec" aria-labelledby="h-projekte">
  <div class="wrap head">
    <h2 id="h-projekte" class="display page-title">Projekte</h2>
  </div>

  <div class="wrap page">
    <div class="layout">
      <!-- the project list (owner 2026-10-14, after top tabs he didn't like): a rail beside the
           projects on wide screens, pinned under the top bar; the project in view gets an ink
           bar that grows while it is read (script below; plain anchors without JS) -->
      <nav class="prail" aria-label="Projekte">
        <ol>
          {
            projects.map((p) => (
              <li>
                <a href={`#${p.id}`} data-pnav-link={p.id}>
                  <span class="yr tnum">{p.year}</span>
                  <span class="nm">{p.tab}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="projs">
    {
      projects.map((p) => (
        <article id={p.id} class="proj" data-project aria-labelledby={`${p.id}-h`}>
          <header class="row proj-head">
            <p class="lab">
              <span class="tnum">{p.year}</span>
              <small>{p.org}</small>
            </p>
            <h3 id={`${p.id}-h`}>
              <span class="name">{p.tab}</span>
              {subtitle(p) && <span class="full">{subtitle(p)}</span>}
            </h3>
          </header>

          <div class:list={["ov-wrap", p.beside && "has-beside"]}>
          <dl class="ov">
            <div class="row">
              <dt class="lab"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.aufgabe} />Aufgabe</dt>
              <dd class="body">{p.intro}</dd>
            </div>
            <div class="row">
              <dt class="lab"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.beitrag} />Mein Beitrag</dt>
              <dd class="body">{p.contribution}</dd>
            </div>
          </dl>
          {p.beside && (
            <figure class="beside">
              <img
                src={url(`/img/projekte/${p.beside.id}.webp`)}
                srcset={p.beside.small ? `${url(`/img/projekte/${p.beside.id}-640.webp`)} 640w, ${url(`/img/projekte/${p.beside.id}.webp`)} ${p.beside.width}w` : undefined}
                sizes="(min-width: 56rem) 30vw, 100vw"
                alt={p.beside.alt}
                width={p.beside.width}
                height={p.beside.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {p.beside.cap}
                {p.beside.dlr && (
                  <span class="credit">
                    Foto: DLR,{" "}
                    <a class="prose-link" href="https://creativecommons.org/licenses/by-nc-nd/3.0/" rel="license noopener">
                      CC BY-NC-ND 3.0
                    </a>
                  </span>
                )}
              </figcaption>
            </figure>
          )}
          </div>

          <dl class="ov">
            <div class="row">
              <dt class="lab"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.ergebnis} />Ergebnis</dt>
              <dd>
                <p class="body">{p.outcome}</p>
                {p.figure === "heliostat" && (
                  <div class="chart">
                    <h4>Vom Blechteil zum Heliostaten</h4>
                    <p class="cap">
                      Meine Endkalkulation, nach Baugruppen in der Reihenfolge, in der der Heliostat gebaut wird. Rund vier Fünftel der Kosten sind Material und Zukaufteile; am teuersten ist der Konzentrator mit dem Spiegelglas.
                    </p>
                    <HeliostatCost />
                  </div>
                )}
                {p.figure === "luftfahrt" && (
                  <div class="chart">
                    <h4>Quantitativ: was der Praxischeck mit Diehl zeigt</h4>
                    <p class="cap">
                      Der rechnende Teil der Metrik, angewendet auf die Luftleitschaufel. Fast die ganze Energie fällt im Flug an: Jedes Kilogramm Bauteil kostet zehn Jahre lang Kerosin. Herstellung und Material sind dagegen Nebensache, deshalb spart die leichtere, hohle Variante so viel. Den einordnenden Teil zeigt die Relevanztabelle darunter.
                    </p>
                    <LifeCycle />
                  </div>
                )}
              </dd>
            </div>
          </dl>

          {p.figure === "luftfahrt" && (
            <div class="row visual">
              <ImpactScreen />
            </div>
          )}

          {p.steps && <ProjectSteps steps={p.steps} />}

          <div class="row">
            <div>
            <dl class="facts">
              {p.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
              <div>
                <dt>Zeitraum</dt>
                <dd>{p.period}</dd>
              </div>
              {p.team && (
                <div>
                  <dt>Team</dt>
                  <dd>{p.team}</dd>
                </div>
              )}
              {p.tools.length > 0 && (
                <div class="sw-row">
                  <dt>Software</dt>
                  <dd>
                    <ul class="sw" role="list">
                      {p.tools.map((key) => {
                        const t = tool(key);
                        return (
                          <li>
                            {t.svg ? (
                              <span class="logo" aria-hidden="true" set:html={uniqueSvg(t.svg, `${p.id}-${key.replace(/\W+/g, "")}`)} />
                            ) : (
                              <span class="mono" aria-hidden="true" data-placeholder="logo">{t.mono}</span>
                            )}
                            {t.name}
                          </li>
                        );
                      })}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
            {p.link && (
              <p class="link">
                <a class="prose-link" href={p.link.href}>{p.link.label}</a>
              </p>
            )}
            </div>
          </div>

          <div class="row">
            <ProjectMethod project={p} />
          </div>

          {p.figure === "ringprojekt" && (
            <div class="flow">
              <h4>So lief das Semester</h4>
              <p class="cap">
                Oben und unten meine Arbeit als PPS, dazwischen das Team: zu jedem Fertigungsschritt ein Arbeitsplan von mir, während der Fertigung habe ich die Zeiten erfasst.
              </p>
              <RingFlow />
            </div>
          )}
        </article>
      ))
    }
      </div>
    </div>
  </div>

  <!-- narrower screens: a small pill at the bottom while a project is in view; it opens the same
       list (JS only: without it the pill stays hidden and the page reads top to bottom) -->
  <nav class="ppill" aria-label="Projekte" data-ppill>
    <details>
      <summary class="frost">
        <span class="pos tnum" data-ppill-pos></span>
        <span class="nm" data-ppill-name></span>
      </summary>
      <ol>
        {
          projects.map((p) => (
            <li>
              <a href={`#${p.id}`} data-pnav-link={p.id}>
                <span class="yr tnum">{p.year}</span>
                <span class="nm">{p.tab}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </details>
  </nav>
</section>

<script>
  import { onScrollFrame, reduceMotion, requestFrame } from "../../scripts/page";

  // The result charts build up once they are well in view (their CSS waits for .go under html.js).
  // A [data-count] value counts up from 0 meanwhile (euros with a decimal comma), following the
  // [data-count-bar] bars as they are drawn; with reduced motion everything stands complete at once.
  const eur = (v: number) => `${v.toFixed(2).replace(".", ",")} €`;
  const build = new IntersectionObserver(
    (entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        const chart = en.target as HTMLElement;
        build.unobserve(chart);
        chart.classList.add("go");
        const out = chart.querySelector<HTMLElement>("[data-count]");
        if (!out || reduceMotion.matches) continue;
        const total = Number(out.dataset.count);
        const bars = [...chart.querySelectorAll<HTMLElement>("[data-count-bar]")];
        const t0 = performance.now();
        // the running total = how far the bars are drawn right now (each starts at its group's
        // `from` and grows to `sum`), read from their transforms each frame, so the number and
        // the bars can't drift apart
        const tick = (t: number) => {
          let v = 0;
          for (const b of bars) {
            const k = new DOMMatrixReadOnly(getComputedStyle(b).transform).a;
            if (k > 0.001) v = Math.max(v, Number(b.dataset.from) + k * Number(b.dataset.sum));
          }
          const done = bars.every((b) => new DOMMatrixReadOnly(getComputedStyle(b).transform).a >= 0.999);
          out.textContent = eur(done ? total : Math.min(v, total));
          if (!done && t - t0 < 6000) requestAnimationFrame(tick);
          else out.textContent = eur(total);
        };
        out.textContent = eur(0);
        requestAnimationFrame(tick);
      }
    },
    { threshold: 0.4 },
  );
  document.querySelectorAll("#projekte [data-build]").forEach((el) => build.observe(el));

  // The project in view: the last one whose top has passed the top bar plus 3rem (rem, so it holds
  // at any root size); it stays marked across the gap to the next one, until Projekte has left
  // under the top bar. Marks its links in the rail and the pill (aria-current), grows the rail's
  // ink bar with the share read (--p), and shows the pill only while a project is in view and
  // Projekte still fills the window (so it never sits over the Kenntnisse heading).
  const top = document.querySelector<HTMLElement>(".top");
  const section = document.getElementById("projekte");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-pnav-link]")];
  const ids = [...new Set(links.map((a) => a.dataset.pnavLink!))];
  const arts = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  const pill = document.querySelector<HTMLElement>("[data-ppill]");
  const details = pill?.querySelector("details");
  const pos = pill?.querySelector("[data-ppill-pos]");
  const name = pill?.querySelector("[data-ppill-name]");

  if (arts.length) {
    let cur = "";
    const shown: string[] = [];
    const mark = () => {
      const barBottom = top?.getBoundingClientRect().bottom ?? 0;
      const edge = barBottom + 3 * parseFloat(getComputedStyle(document.documentElement).fontSize);
      const secBottom = section?.getBoundingClientRect().bottom ?? Infinity;
      let id = "";
      // every project's share read (only the current one shows its bar), so none goes stale
      // when a resize moves the current project on
      const share = new Map<string, number>();
      for (const el of arts) {
        const r = el.getBoundingClientRect();
        share.set(el.id, Math.min(1, Math.max(0, (edge - r.top) / r.height)));
        if (secBottom > barBottom && r.top <= edge) id = el.id;
      }
      const showPill = !!id && secBottom >= innerHeight;
      if (pill && pill.classList.contains("on") !== showPill) {
        pill.classList.toggle("on", showPill);
        if (!showPill && details) details.open = false;
      }
      // (written only when it changed: every write restyles the link, and far from Projekte
      // the shares stand still)
      links.forEach((a, i) => {
        const p = (share.get(a.dataset.pnavLink!) ?? 0).toFixed(3);
        if (p !== shown[i]) a.style.setProperty("--p", (shown[i] = p));
      });
      if (id === cur) return;
      cur = id;
      for (const a of links) {
        if (a.dataset.pnavLink === id) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
      const i = ids.indexOf(id);
      if (pos && name && i >= 0) {
        pos.textContent = `${i + 1}/${ids.length}`;
        name.textContent = links.find((a) => a.dataset.pnavLink === id)?.querySelector(".nm")?.textContent ?? "";
      }
    };
    onScrollFrame(mark);
    // Expanding a method changes project height without necessarily scrolling.
    section?.querySelectorAll<HTMLDetailsElement>("details.method").forEach((el) => {
      el.addEventListener("toggle", () => requestFrame(mark));
    });
    addEventListener("resize", mark, { passive: true });
    // Heights that settle a frame after a resize (wrapped text, the pile and Werdegang above)
    // move the projects without a scroll: mark again once the section's size changes.
    if (section) new ResizeObserver(() => requestFrame(mark)).observe(section);
    mark();
  }

  // the pill's list closes on a pick, Escape, a tap outside or focus leaving it
  if (details) {
    details.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) details.open = false;
    });
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && details.open) {
        details.open = false;
        details.querySelector("summary")?.focus();
      }
    });
    // keyboard focus moving on past the last link closes the list too
    details.addEventListener("focusout", (e) => {
      if (!details.contains(e.relatedTarget as Node)) details.open = false;
    });
    addEventListener("pointerdown", (e) => {
      if (details.open && !details.contains(e.target as Node)) details.open = false;
    });
  }
</script>

<style>
  .head {
    padding-top: var(--sp-section);
  }
  .page {
    padding-bottom: var(--sp-block);
  }

  /* wide screens: the rail beside the projects, pinned under the top bar (its height is measured
     by Werdegang's script; the fallback is its CSS height) */
  .prail {
    display: none;
  }
  @media (min-width: 75rem) {
    .layout {
      display: grid;
      grid-template-columns: 9.5rem minmax(0, 1fr);
      column-gap: clamp(2rem, 3vw, 3.5rem);
      align-items: start;
    }
    .prail {
      display: block;
      position: sticky;
      top: calc(var(--top-bar-h, calc(3.75rem + 1.5px)) + 1.75rem);
      margin-top: var(--sp-gap);
    }
  }
  .prail ol,
  .ppill ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* a hairline down the list; the project in view gets an ink bar on it that grows while read */
  .prail ol {
    border-left: 1px solid var(--line);
  }
  .prail li + li {
    margin-top: 0.9rem;
  }
  .prail a,
  .ppill ol a {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--ink-2);
  }
  .prail a {
    padding: 0.1rem 0 0.1rem 0.9rem;
  }
  .prail a::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--ink);
    transform-origin: top;
    transform: scaleY(0);
  }
  .prail a[aria-current="true"]::before {
    transform: scaleY(max(0.12, var(--p, 0)));
  }
  .yr {
    display: block;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .nm {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .prail a:hover,
  .prail a[aria-current="true"],
  .ppill ol a:hover,
  .ppill ol a[aria-current="true"] {
    color: var(--ink);
  }

  /* narrower screens: the pill, bottom centre, only while a project is in view (.on from the
     script); its list opens upward */
  .ppill {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 35;
    transform: translate(-50%, 0.5rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s,
      transform 0.2s,
      visibility 0s 0.2s;
  }
  .ppill.on {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  @media (min-width: 75rem) {
    .ppill {
      display: none;
    }
  }
  .ppill summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: 0 6px 20px rgb(15 27 45 / 0.12);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .ppill summary::-webkit-details-marker {
    display: none;
  }
  /* the chevron: points up while closed (the list opens upward), down while open */
  .ppill summary::after {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.15rem;
    border-left: 1.5px solid var(--ink);
    border-top: 1.5px solid var(--ink);
    transform: translateY(0.12rem) rotate(45deg);
  }
  .ppill details[open] summary::after {
    transform: translateY(-0.12rem) rotate(225deg);
  }
  .ppill .pos {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .ppill summary .nm {
    display: inline;
    color: var(--ink);
  }
  .ppill ol {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
    min-width: 13rem;
    padding: 0.4rem 0;
    /* solid: frosted, the text behind showed through the list */
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    box-shadow: 0 6px 20px rgb(15 27 45 / 0.12);
  }
  .ppill ol a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 1rem;
  }
  .ppill ol .yr {
    display: inline;
  }
  .ppill ol a[aria-current="true"] .nm {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .proj {
    margin-top: var(--sp-gap);
  }
  .proj + .proj {
    margin-top: var(--sp-block);
    padding-top: var(--sp-block);
    border-top: 1px solid var(--line);
    /* skip the gap above the title, so a jump puts the title right under the top bar */
    scroll-margin-top: calc(-1px - var(--sp-block)); /* the title lands as high as the first one's */
  }

  /* rows: a margin column for year/place and the headings, the content beside it (from 56rem);
     below that the heading sits above its text */
  .row {
    display: grid;
    gap: 0.3rem var(--sp-gap);
  }
  .row + .row,
  .ov + .ov,
  .ov + .row,
  .row + .ov {
    margin-top: 1.5rem;
  }
  .ov {
    margin: 0;
  }
  .lab {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .lab small {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-3);
  }
  .ic {
    display: inline-block;
    width: 1.15rem;
    height: 1.15rem;
    margin-right: 0.45rem;
    vertical-align: -0.2rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .ov dd {
    margin: 0;
  }
  .body {
    max-width: 62ch;
    font-family: var(--serif);
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  /* the head: the short name large (Newsreader 600, not the section titles' .display), the full
     title under it */
  .proj-head h3 {
    font-weight: 400;
  }
  .name {
    display: block;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .full {
    display: block;
    margin-top: 0.5rem;
    max-width: 44ch;
    font-family: var(--serif);
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.3125rem);
    line-height: 1.3;
    color: var(--ink-2);
    text-wrap: balance;
  }
  .proj-head + .ov-wrap {
    margin-top: var(--sp-gap);
  }
  .ov-wrap + .ov {
    margin-top: 1.5rem;
  }
  .beside {
    margin: 1.5rem 0 0;
    max-width: 36rem;
  }
  .beside img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 675;
    border: 1px solid var(--line);
  }
  .beside figcaption {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-3);
  }
  .credit {
    display: block;
  }

  .visual {
    margin-top: var(--sp-gap);
  }
  .chart {
    margin-top: var(--sp-gap);
  }
  .chart h4,
  .flow h4 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .cap {
    margin: 0.2rem 0 0.9rem;
    max-width: 52rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  /* facts as one quiet line under a hairline; software with logos, no boxes */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .facts > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.6rem;
  }
  .facts dt {
