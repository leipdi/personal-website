---
import ImagePlaceholder from "../ImagePlaceholder.astro";
import Heliostat from "../figures/Heliostat.astro";
import { career } from "../../data/cv";
import { toFrac, todayFrac } from "../../lib/dates";

// Werdegang as a project plan (owner, 2026-09-28): a Gantt chart pinned under the top bar with
// the categories as swimlanes on the left (Ausbildung, Abschlussarbeiten, Praxis), one colour
// per category, a flag on the bar for each milestone (degrees, thesis submissions). The
// stations follow below as text, oldest first; a playhead in the chart follows the reader.
// Without JS the chart is a static overview above the same text.
type Row = (typeof career)[number] & { start: number; end: number; cat: Cat };
type Cat = "ausbildung" | "arbeiten" | "praxis";

const catOf = (e: (typeof career)[number]): Cat =>
  e.kind === "ausbildung" ? "ausbildung" : /^(Bachelor|Master)arbeit/.test(e.title) ? "arbeiten" : "praxis";

const cats: { id: Cat; name: string; sub: string }[] = [
  { id: "ausbildung", name: "Ausbildung", sub: "Schule und Studium" },
  { id: "arbeiten", name: "Abschlussarbeiten", sub: "Bachelor und Master" },
  { id: "praxis", name: "Praxis", sub: "Neben dem Studium" },
];
const catName = (c: Cat) => cats.find((k) => k.id === c)!.name;

const rows: Row[] = career
  .map((e) => ({ ...e, start: toFrac(e.from, "start"), end: toFrac(e.to, "end"), cat: catOf(e) }))
  .sort((a, b) => a.start - b.start || a.end - b.end);

// Axis from 2020 (the Bachelor) to just past today. The Abitur started in 2013: its bar
// simply starts at the axis edge.
const t0 = 2020;
const t1 = todayFrac + 0.2;
const span = t1 - t0;
const pct = (v: number) => ((Math.min(Math.max(v, t0), t1) - t0) / span) * 100;
const years: number[] = [];
for (let y = t0; y <= Math.floor(todayFrac); y++) years.push(y);

const msAt = (r: Row) => (r.milestone ? toFrac(r.milestone.at, "end") : null);
// A milestone in the bar's last ~1.5 months ends the bar, so the flag stands at its end
// (display only; the dates in the text stay as they are).
const barEnd = (r: Row) => {
  const ms = msAt(r);
  return ms !== null && ms <= r.end && r.end - ms <= 0.125 ? ms : r.end;
};

const name = (r: Row) => r.short ?? r.title;

// Lanes: each category is one lane, its stations in date order (DOM and Tab order), each on a
// line (--line) where neither its bar, its label (above the bar) nor its flag label (below the
// bar) collides with another. This server-side packing is the no-JS fallback and estimates
// label widths (~0.65% of the track per character, 12px type on a ~950px track; cut off with
// an ellipsis at the next bar where the guess is short). With JS the script measures the real
// labels and packs the lines again for the actual track width.
const labelW = (r: Row) => name(r).length * 0.65 + 1; // % of the track
const flagW = (r: Row) => (r.milestone ? r.milestone.tag.length * 0.7 + 2.5 : 0);
type Seg = {
  r: Row;
  k: number; // line
  fb: number; // lines with flags above this one
  l: number;
  w: number;
  lblMax: number;
  right: boolean;
  from: number;
  to: number;
  ms: number | null;
  flagLeft: boolean;
  f0: number;
  f1: number;
};
const free = (a0: number, a1: number, b0: number, b1: number) => a1 <= b0 - 0.5 || a0 >= b1 + 0.5;
const lanes = cats.map((c) => {
  const lines: Seg[][] = [];
  const items: Seg[] = [];
  for (const r of rows.filter((x) => x.cat === c.id)) {
    const l = pct(r.start);
    const w = Math.max(pct(barEnd(r)) - l, 0.6);
    // labels that would run past the chart's right edge hang left from the bar's end
    const right = l + labelW(r) > 100;
    const from = right ? l + w - labelW(r) : l;
    const to = right ? l + w : Math.max(l + w, l + labelW(r));
    const m = msAt(r);
    const ms = m === null ? null : pct(m);
    const flagLeft = ms !== null && ms + flagW(r) > 100;
    const f0 = ms === null ? 0 : flagLeft ? ms - flagW(r) : ms;
    const f1 = ms === null ? 0 : flagLeft ? ms + 1 : ms + flagW(r);
    const seg: Seg = { r, k: 0, fb: 0, l, w, lblMax: 0, right, from, to, ms, flagLeft, f0, f1 };
    let k = lines.findIndex((ln) =>
      ln.every(
        (s) =>
          free(l, l + w, s.l, s.l + s.w) &&
          free(from, to, s.from, s.to) &&
          (ms === null || s.ms === null || free(f0, f1, s.f0, s.f1)),
      ),
    );
    if (k < 0) k = lines.push([]) - 1;
    seg.k = k;
    lines[k].push(seg);
    items.push(seg);
  }
  // each label may run up to the next bar on its line (or the chart's end)
  for (const ln of lines) {
    const byX = [...ln].sort((a, b) => a.l - b.l);
    byX.forEach((s, k) => {
      const next = byX[k + 1]?.l ?? 100;
      s.lblMax = s.right ? s.l + s.w - (byX[k - 1] ? byX[k - 1].to + 0.5 : 0) : next - s.l - 0.5;
    });
  }
  // a flag name right of its pole must not sit under the next bar on its line: it hangs left
  for (const ln of lines) {
    for (const s of ln) {
      if (s.ms === null || s.flagLeft) continue;
      if (ln.some((o) => o !== s && o.l < s.f1 && o.l + o.w > s.ms! + 0.5)) {
        s.flagLeft = true;
        s.f0 = s.ms - flagW(s.r);
        s.f1 = s.ms + 1;
      }
    }
  }
  const flagLine = lines.map((ln) => ln.some((s) => s.ms !== null));
  for (const s of items) s.fb = flagLine.slice(0, s.k).filter(Boolean).length;
  return { ...c, items, nLines: lines.length, nFlag: flagLine.filter(Boolean).length };
});

// how long a job or thesis ran (months, counted inclusively), or since when it runs
const duration = (r: Row) => {
  if (r.kind === "ausbildung") return null;
  if (r.to === "heute") return `seit ${r.from}`;
  const m = Math.round((r.end - r.start) * 12);
  return m >= 1 ? `${m} ${m === 1 ? "Monat" : "Monate"}` : null;
};

const restCap = "Alle Stationen bis heute";
const capOf = (r: Row) => `${name(r)}, ${r.from} bis ${r.to}`;
// the milestone's date as the CV/thesis gives it: a day ("18.06.2024") or a year ("2024")
const msDate = (r: Row) => r.milestone?.at ?? null;
---

<section id="werdegang" class="sec" aria-labelledby="h-werdegang">
  <div class="wrap page-head">
    <h2 id="h-werdegang" class="display page-title">Werdegang</h2>
    <p class="lede">Mein Werdegang als Gantt-Diagramm</p>
    <p class="key" aria-hidden="true">
      <span><i class="k-flag"></i>Meilenstein</span>
      <span class="js-key"><i class="k-cur"></i>gerade im Blick</span>
    </p>
  </div>

  <!-- the chart stays pinned up to the last station's top, then scrolls away above it (script) -->
  <div class="scope" data-scope>
    <nav
      class="plan-wrap"
      aria-label="Projektplan: alle Stationen"
      data-plan
      data-t0={t0}
      data-t1={t1}
      data-today={todayFrac}
    >
      <div class="wrap">
        <div class="plan">
          <div class="axis" aria-hidden="true">
            <span class="axis-track">
              {years.map((y) => <span class="year" style={`left:${pct(y)}%`}>{y}</span>)}
            </span>
          </div>

          <div class="body">
            <span class="grid" aria-hidden="true" data-grid>
              {years.slice(1).map((y) => <i style={`left:${pct(y)}%`} />)}
              <span class="today" style={`left:${pct(todayFrac)}%`}></span>
              <span class="today-lbl" style={`left:${pct(todayFrac)}%`} data-today-lbl>heute</span>
              <span class="playhead" data-head></span>
              <span class="head-tag" data-tag></span>
            </span>

            {
              lanes.map((lane) => (
                <div class="lane" data-cat={lane.id}>
                  <p class="lane-lbl" aria-hidden="true">
                    <i />
                    <span>
                      {lane.name}
                      <small>{lane.sub}</small>
                    </span>
                  </p>
                  <div class="lane-track" style={`--lines:${lane.nLines};--flag-lines:${lane.nFlag}`} data-track>
                    {lane.items.map(({ r, k, fb, l, w, lblMax, right, ms, flagLeft }) => (
                      <>
                        <a
                          class:list={["seg", right && "seg-right"]}
                          href={`#${r.id}`}
                          style={`left:${l}%;width:${w}%;--line:${k};--fb:${fb};--lbl-max:${((lblMax / w) * 100).toFixed(1)}%`}
                          data-row={r.id}
                          data-start={r.start}
                          data-end={r.end}
                          data-bar-end={barEnd(r)}
                          data-now={r.to === "heute" ? "" : undefined}
                          data-cap={capOf(r)}
                          data-name={name(r)}
                          aria-label={`${catName(r.cat)}: ${r.title}, ${r.from} bis ${r.to}`}
                        >
                          <span class="seg-lbl">{name(r)}</span>
                          <span class="bar" />
                        </a>
                        {ms !== null && (
                          <span
                            class:list={["flag", flagLeft && "flag-left"]}
                            data-flag-of={r.id}
                            data-ms={msAt(r)}
                            style={`left:${ms}%;--line:${k};--fb:${fb}`}
                            aria-hidden="true"
                          >
                            <span class="flag-lbl">{r.milestone!.tag}</span>
                          </span>
                        )}
                      </>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <p class="plan-cap" aria-hidden="true" data-caption>{restCap}</p>
      </div>
    </nav>

    <ol class="wrap stations" data-stations>
      {
        rows.map((r) => {
          const dur = duration(r);
          // a thesis' submission date is one more fact (the chart's flag shows every milestone)
          const ms = r.milestone && msDate(r) && /^Abgabe/.test(r.milestone.label) ? [{ label: "Abgabe", value: msDate(r)! }] : [];
          const facts = [...(dur ? [{ label: "Dauer", value: dur }] : []), ...(r.facts ?? []), ...ms];
          const side = facts.length > 0 || (r.visual && r.visual !== "heliostat");
          return (
            <li id={r.id} class="st" data-st={r.id} data-cat={r.cat}>
              <p class="meta">
                <span class="cat">
                  <i aria-hidden="true" />
                  {catName(r.cat)}
                </span>
                <span class="when">
                  {r.from} bis {r.to}
                </span>
                <span class="org">
                  {r.org}, {r.place}
                </span>
              </p>

              <div class="main">
                <h3 class="title">{r.title}</h3>
                  <p class="text story">{r.story}</p>
                  {r.tasks && (
                    <ul class="text tasks">
                      {r.tasks.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  )}
                {r.visual === "heliostat" && (
                  <div class="visual">
                      <Heliostat />
                  </div>
                )}
              </div>

              {side && (
                <div class="side">
                  {facts.length > 0 && (
                    <dl class="facts">
                      {facts.map((f) => (
                        <div>
                          <dt>{f.label}</dt>
                          <dd>{f.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  {r.visual && r.visual !== "heliostat" && (
                    <ImagePlaceholder label={r.visual.image} note={r.visual.note} ratio="4 / 3" />
                  )}
                </div>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>

</section>

<script>
  // Playhead: each station gets its own stretch of scrolling (sequential, for reading); the
  // playhead moves in real time between the stations' start dates (chronological, for the
  // eye). The station crossing the reading line (a third of the way down the space left
  // under the pinned chart) is current: its bar is sun, later rows fade. Before the chart
  // pins (page top) it is a plain full-strength plan: nothing current, no playhead.
  const root = document.documentElement;
  const planWrap = document.querySelector<HTMLElement>("[data-plan]")!;
  const grid = document.querySelector<HTMLElement>("[data-grid]")!;
  const list = document.querySelector<HTMLElement>("[data-stations]")!;
  const scope = document.querySelector<HTMLElement>("[data-scope]")!;
  const rows = [...document.querySelectorAll<HTMLElement>("[data-row]")];
  const sts = [...document.querySelectorAll<HTMLElement>("[data-st]")];
  const head = document.querySelector<HTMLElement>("[data-head]")!;
  const tag = document.querySelector<HTMLElement>("[data-tag]")!;
  const todayLbl = document.querySelector<HTMLElement>("[data-today-lbl]")!;
  const caption = document.querySelector<HTMLElement>("[data-caption]")!;
  const tracks = [...document.querySelectorAll<HTMLElement>("[data-track]")];
  const lanes = [...document.querySelectorAll<HTMLElement>(".lane[data-cat]")];
  const topBar = document.querySelector<HTMLElement>(".top");
  const tabbar = document.querySelector<HTMLElement>(".tabbar");
  const rowOf = new Map(rows.map((r) => [r.dataset.row!, r]));
  const rowAt = sts.map((s) => rowOf.get(s.dataset.st!)!);
  // the chart's scale as it was built (a static site: the visitor's clock would drift from the
  // server-rendered bars, year lines and "heute" line)
  const t0 = Number(planWrap.dataset.t0);
  const t1 = Number(planWrap.dataset.t1);
  const todayFrac = Number(planWrap.dataset.today);
  const phone = matchMedia("(max-width: 47.99rem)");
  const frac = (v: number) => (Math.min(Math.max(v, t0), t1) - t0) / (t1 - t0);
  const starts = rowAt.map((r) => Math.max(Number(r.dataset.start), t0));
  // a station that starts before the axis (the Abitur) has no start date on the chart: while it
  // is current the playhead stands at its end, and the tag says "bis ..."
  const early = rowAt.map((r) => Number(r.dataset.start) < t0);
  const ends = rowAt.map((r) => Number(r.dataset.end));
  // stations still running today: all of them are current at the page end
  const ongoing = rowAt.flatMap((r, j) => (r.dataset.now !== undefined ? [j] : []));
  const restCap = caption.textContent ?? "";
  const endCap =
    ongoing.length > 1
      ? `${ongoing.map((j) => rowAt[j].dataset.name).join(" und ")}, beide bis heute`
      : rowAt[rowAt.length - 1].dataset.cap!;
  const months = ["Jan", "Feb", "Mär", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dez"];
  const smooth = (x: number) => {
    const k = Math.min(Math.max(x, 0), 1);
    return k * k * (3 - 2 * k);
  };

  const tabH = () => (tabbar && getComputedStyle(tabbar).display !== "none" ? tabbar.offsetHeight : 0);
  const stickyTop = () => parseFloat(getComputedStyle(planWrap).top) || 0;
  // where the chart's bottom edge sits while it is pinned
  const pinnedBottom = () => stickyTop() + planWrap.offsetHeight;
  const readingLine = (planBottom: number) => planBottom + (innerHeight - tabH() - planBottom) * 0.33;
  // "the end" is the end of this section, not of the page (Kenntnisse and Kontakt follow):
  // the scroll position where the last station has reached its end place and the list has
  // scrolled fully into view (layout). The end state (today) holds from there on.
  let endY = Infinity;
  const atEnd = () => scrollY >= endY - 2;

  // ---- pin: a station reached by a click in the chart, a link/hash or keyboard focus stays
  // current until the reader scrolls on their own. Any scroll away from where the pin's own
  // scroll came to rest releases it (wheel, keys, scrollbar, find-in-page, autoscroll).
  let pinned = -1;
  let pinBy: "focus" | "nav" | null = null;
  let restY: number | null = null;
  let settleT = 0;
  let ready = false;
  let settlePending = false;
  const settle = () => {
    restY = null;
    clearTimeout(settleT);
    settlePending = false;
    if (!ready || pinned < 0) return;
    settlePending = true;
    settleT = window.setTimeout(() => {
      settlePending = false;
      if (pinned >= 0) restY = scrollY;
    }, 250);
  };
  const pin = (j: number, by: "focus" | "nav") => {
    pinned = j;
    pinBy = by;
    scope.dataset.pinned = sts[j].dataset.st;
    settle();
    schedule();
  };
  const unpin = () => {
    clearTimeout(settleT);
    restY = null;
    if (pinned < 0) return;
    pinned = -1;
    pinBy = null;
    delete scope.dataset.pinned;
    schedule();
  };

  // Layout numbers: the top bar's real height (the pinned chart tucks 1px under its rule, so
  // no slit shows), the chart's height for scroll-padding, and the list's bottom padding: just
  // enough that at the very end the last station's top reaches the reading line.
  // ---- lane packing: the server guessed the label widths; here the real ones are measured
  // (at the bold weight of the current station, so nothing moves when it turns current) along
  // with the flag names, and each station, in date order, goes on the first line of its lane
  // where its bar, its label and its flag name collide with nothing. A narrow track just gets
  // more lines. Labels show in full; only one longer than the whole track is cut off.
  const LBL_GAP = 8; // px between two labels (or two flag names) on a line
  const BAR_GAP = 3; // px between two bars on a line
  const PENNANT = 10; // px from a pole to its flag name (0.75rem minus the 2px backing)
  const FLAG_IN = 3.3; // px a left-hanging flag name stays clear of its pole
  type Box = {
    b0: number;
    b1: number;
    l0: number;
    l1: number;
    f0: number;
    f1: number;
    lbl: boolean;
    flag: boolean;
    fx: number; // the flag pole's x
    fw: number; // the flag name's width
    fel: HTMLElement | null;
  };
  const clear = (a0: number, a1: number, b0: number, b1: number, gap: number) => a1 + gap <= b0 || b1 + gap <= a0;
  const pack = () => {
    const W = tracks.find((t) => t.clientWidth)?.clientWidth ?? 0;
    if (!W) return;
    const segsOf = (t: HTMLElement) => [...t.querySelectorAll<HTMLElement>(".seg")];
    const lblOf = (s: HTMLElement) => s.querySelector<HTMLElement>(".seg-lbl")!;
    const flagOf = (t: HTMLElement, s: HTMLElement) =>
      t.querySelector<HTMLElement>(`[data-flag-of="${s.dataset.row}"]`);
    // measure (all writes, then all reads)
    const all = tracks.flatMap(segsOf);
    for (const s of all) {
      const l = lblOf(s);
      l.style.maxWidth = "none";
      l.style.fontWeight = "800";
    }
    const lw = new Map(all.map((s) => [s, lblOf(s).getBoundingClientRect().width]));
    for (const s of all) lblOf(s).style.fontWeight = "";

    for (const t of tracks) {
      if (!t.clientWidth) continue;
      const lines: Box[][] = [];
      const placed: { s: HTMLElement; f: HTMLElement | null; k: number }[] = [];
      for (const s of segsOf(t)) {
        const bl = s.offsetLeft;
        const bw = s.offsetWidth;
        const w = lw.get(s)!; // label box incl. its 2px backing on each side
        const lbl = lblOf(s);
        // the label starts at the bar; if it would run past the chart's end it moves left
        // until it ends there; only a label longer than the track is cut off
        let l0 = Math.max(bl - 2, 0);
        if (l0 + w > W + 2) l0 = Math.max(0, W + 2 - w);
        const l1 = Math.min(l0 + w, W + 2);
        lbl.style.left = `${l0 - bl}px`;
        lbl.style.right = "auto";
        lbl.style.maxWidth = w > W + 4 ? `${W + 4}px` : "none";
        s.classList.remove("seg-right");

        const f = flagOf(t, s);
        let f0 = 0;
        let f1 = 0;
        let fx = 0;
        let fw = 0;
        if (f) {
          fx = f.offsetLeft;
          fw = f.querySelector<HTMLElement>(".flag-lbl")!.getBoundingClientRect().width;
          const left = fw > 0 && fx + PENNANT + fw > W + 2;
          f.classList.toggle("flag-left", left);
          f0 = left ? fx - FLAG_IN - fw : fx;
          f1 = left ? fx + PENNANT : fx + PENNANT + fw;
        }
        const box: Box = { b0: bl, b1: bl + bw, l0, l1, f0, f1, lbl: w > 0, flag: !!f, fx, fw, fel: f };
        let k = lines.findIndex((ln) =>
          ln.every(
            (o) =>
              clear(box.b0, box.b1, o.b0, o.b1, BAR_GAP) &&
              (!box.lbl || !o.lbl || clear(box.l0, box.l1, o.l0, o.l1, LBL_GAP)) &&
              (!box.flag || !o.flag || clear(box.f0, box.f1, o.f0, o.f1, LBL_GAP)),
          ),
        );
        if (k < 0) k = lines.push([]) - 1;
        lines[k].push(box);
        placed.push({ s, f, k });
      }
      // A flag name hanging right of its pole must not sit under the next station's bar on
      // the same line (the grade at the end of the Abitur ran under the B.Eng. bar): it then
      // hangs left, under its own bar.
      for (const ln of lines) {
        for (const o of ln) {
          if (!o.fel || !o.fw || o.fel.classList.contains("flag-left")) continue;
          const n0 = o.fx + PENNANT;
          const underBar = ln.some((p) => p !== o && p.b0 < o.f1 && p.b1 > n0);
          if (underBar) {
            o.fel.classList.add("flag-left");
            o.f0 = o.fx - FLAG_IN - o.fw;
            o.f1 = o.fx + PENNANT;
          }
        }
      }
      const flagLine = lines.map((ln) => ln.some((o) => o.flag));
      for (const { s, f, k } of placed) {
        const fb = flagLine.slice(0, k).filter(Boolean).length;
        for (const el of [s, f]) {
          el?.style.setProperty("--line", String(k));
          el?.style.setProperty("--fb", String(fb));
        }
      }
      t.style.setProperty("--lines", String(lines.length));
      t.style.setProperty("--flag-lines", String(flagLine.filter(Boolean).length));
    }
  };

  let spTop = 0;
  let spBottom = 0;
  const layout = () => {
    pack();
    settle(); // a pin re-settles after layout moves things
    if (topBar) root.style.setProperty("--top-bar-h", `${topBar.getBoundingClientRect().height}px`);
    root.style.setProperty("--plan-h", `${planWrap.offsetHeight}px`);
    if (laneKey === "") fullH = planWrap.offsetHeight;
    // a lane that has just become visible gets its final height only here (packing): the
    // padding that keeps the text in place follows it in the same frame
    laneGap = laneKey === "" ? 0 : Math.max(0, fullH - planWrap.offsetHeight);
    list.style.paddingTop = laneGap ? `calc(1rem + ${laneGap}px)` : "";
    const rs = getComputedStyle(root);
    // the page's scroll padding covers the top bar; the pinned chart comes on top of it
    spTop = (parseFloat(rs.scrollPaddingTop) || 0) + planWrap.offsetHeight;
    spBottom = parseFloat(rs.scrollPaddingBottom) || 0;
    // (measured around the current padding rather than resetting it, so the scroll position
    // at the page end isn't clamped on resize)
    const pad = parseFloat(getComputedStyle(list).paddingBottom) || 0;
    const last = sts[sts.length - 1];
    const lastTop = last.getBoundingClientRect().top + scrollY;
    // At the very end the last station's top stands a little above the reading line (so it is
    // current on its own before the end state).
    // (from the full chart height, not the current lanes: otherwise every lane switch would
    // change the room under the last station and shift everything below it)
    const pb = stickyTop() + (fullH || planWrap.offsetHeight);
    const line = readingLine(pb);
    const endTop = line - Math.min(64, (line - pb) / 2);
    const need = lastTop - endTop + root.clientHeight - (root.scrollHeight - pad);
    const padNew = Math.max(0, Math.ceil(need));
    list.style.paddingBottom = `${padNew}px`;
    const listBottom = list.getBoundingClientRect().bottom + scrollY;
    endY = Math.min(
      Math.max(lastTop - endTop, listBottom - (innerHeight - tabH())),
      root.scrollHeight - root.clientHeight,
    );
    // The chart's sticky scope can end early (negative margin on the list, given back to the
    // scope), so the chart scrolls away above the last station rather than covering it.
    // Phones: the scope ends at the last station's top (the chart fades out, see update).
    // Wider screens: where the last station and the closing band are taller than the room
    // under the pinned chart, the chart gives way just enough that at the very end the last
    // station's title stands fully visible below it, clear of the fade under the chart.
    let tail = 0;
    if (phone.matches) tail = last.offsetHeight + padNew;
    else {
      const title = last.querySelector<HTMLElement>(".title") ?? last;
      const maxScroll = root.scrollHeight - root.clientHeight;
      const titleAtEnd = title.getBoundingClientRect().top + scrollY - maxScroll;
      const push = pb + 32 - titleAtEnd;
      if (push > 0) tail = Math.ceil(list.getBoundingClientRect().bottom + scrollY - maxScroll - (pb - push));
    }
    list.style.marginBottom = `${-tail}px`;
    scope.style.marginBottom = `${tail}px`;
    schedule();
  };

  let key = "";
  let laneKey = "";
  let laneGap = 0;
  // the chart's height with every lane shown (measured at rest)
  let fullH = planWrap.offsetHeight;
  const update = () => {
    // where the page is too short to keep the chart pinned over the last station (phones, and
    // tablets/small laptops at the very end), the last station pushes the chart off: it fades
    // out within its first 32px of travel, so a half-cut chart never shows.
    const pushed = stickyTop() - planWrap.getBoundingClientRect().top;
    const fade = pushed > 0.5 ? Math.max(0, 1 - pushed / 32) : 1;
    planWrap.style.opacity = fade < 1 ? String(fade) : "";
    planWrap.classList.toggle("is-gone", fade === 0);
    const planBottom = planWrap.getBoundingClientRect().bottom;
    const end = atEnd();
    // how far the page has scrolled since the chart pinned (negative before)
    const since = stickyTop() - scope.getBoundingClientRect().top;
    // at rest: the chart hasn't pinned yet, nothing is pinned, and this isn't the page end
    const rest = pinned < 0 && !end && since < -0.5;
    // When the chart pins, the first station(s) may already have passed the reading line (tall
    // screens, a short first station). The line then starts at the first station's top and
    // sinks to its usual place at half the scroll speed, so each station still gets its turn.
    // (from the whole plan's bottom, not the current lanes': a smaller chart would move the line
    // up, pick another station, show other lanes and flip back and forth)
    let line = readingLine(planBottom + laneGap);
    const firstAtPin = sts[0].getBoundingClientRect().top + Math.max(since, 0);
    if (firstAtPin < line) line = Math.min(line, firstAtPin + 1 + Math.max(since, 0) * 0.5);

    let i = 0;
    let t = t0;
    let cur: number[] = [];
    if (pinned >= 0) {
      i = pinned;
      t = early[i] ? ends[i] : starts[i];
      cur = [i];
    } else if (!rest) {
      sts.forEach((s, j) => {
        if (s.getBoundingClientRect().top <= line) i = j;
      });
      if (end) {
        // the end is today
        i = sts.length - 1;
        t = todayFrac;
        cur = ongoing.includes(i) ? ongoing : [i];
      } else if (early[i]) {
        t = ends[i];
        cur = [i];
      } else {
        const box = sts[i].getBoundingClientRect();
        const last = i === sts.length - 1;
        if (last) {
          // the last station runs up to today over the scroll left to the page end
          const topAtEnd = box.top - (endY - scrollY);
          const k = (line - box.top) / Math.max(line - topAtEnd, 1);
          t = starts[i] + (todayFrac - starts[i]) * smooth(k);
        } else {
          const k = (line - box.top) / Math.max(box.height, 1);
          t = starts[i] + (starts[i + 1] - starts[i]) * smooth((k - 0.55) / 0.45);
        }
        cur = [i];
      }
    }

    // line unclamped, the tag clamped so it always stays fully inside the track
    const w = grid.clientWidth;
    const x = frac(t) * w;
    head.style.left = `${x}px`;
    if (cur.length === 1 && early[cur[0]]) {
      // the end month of a station that ends at t (an end counts up to the end of its month)
      const e = Math.round(ends[cur[0]] * 12) - 1;
      tag.textContent = `bis ${months[((e % 12) + 12) % 12]} ${Math.floor(e / 12)}`;
    } else {
      const m = Math.min(Math.floor((t - Math.floor(t)) * 12 + 1e-6), 11);
      tag.textContent = `${months[m]} ${Math.floor(t)}`;
    }
    const tw = tag.offsetWidth;
    const tx = Math.min(Math.max(x, tw / 2), w - tw / 2);
    tag.style.left = `${tx}px`;
    // "heute" steps aside while the tag is within ~60px of it
    const g = grid.getBoundingClientRect();
    const hb = todayLbl.getBoundingClientRect();
    todayLbl.classList.toggle(
      "is-hidden",
      !rest && tx + tw / 2 + 60 > hb.left - g.left && tx - tw / 2 - 60 < hb.right - g.left,
    );

    // A focused chart row must never scroll the page (the root scroll-padding reserves the
    // pinned chart, so a row inside it would count as hidden). Each row's scroll area is moved
    // into the middle of the free space below the chart, wherever the row is right now.
    const mid = (spTop + innerHeight - spBottom) / 2;
    for (const r of rows) {
      const b = r.getBoundingClientRect();
      r.style.scrollMarginTop = `${b.top - (mid - b.height / 2)}px`;
      r.style.scrollMarginBottom = `${mid + b.height / 2 - b.bottom}px`;
    }

    // The chart shows only the lane(s) of what is being read (owner 2026-10-02); at rest
    // (before the chart pins) the whole plan. The chart sits in the flow above the stations,
    // so its height change would make the text jump: the height it loses goes on as padding
    // above the stations, so the text keeps its place on the page (moving the scroll position
    // instead unpinned the chart and flipped back and forth). Scroll anchoring is off.
    const show = rest ? "" : [...new Set(cur.map((j) => sts[j].dataset.cat))].join(" ");
    if (show !== laneKey) {
      laneKey = show;
      for (const l of lanes) l.classList.toggle("is-off", show !== "" && !show.split(" ").includes(l.dataset.cat!));
      const h = planWrap.offsetHeight;
      if (show === "") fullH = h;
      // (from the whole plan's height, not step by step: a step measured mid-change drifted)
      laneGap = show === "" ? 0 : Math.max(0, fullH - h);
      // (padding, on top of the list's own 1rem)
      list.style.paddingTop = laneGap ? `calc(1rem + ${laneGap}px)` : "";
      // anchors under the chart use its new height at once (layout runs a frame later), and a
      // station reached by a link or a bar click goes back to its place under the smaller chart
      // once the layout has settled
      root.style.setProperty("--plan-h", `${h}px`);
      if (pinned >= 0 && pinBy === "nav") {
        // (the new padding reached the layout only a frame later in Chrome: wait until it has)
        const j = pinned;
        const want = laneGap + 16;
        let tries = 0;
        const again = () => {
          if (pinned !== j) return;
          const now = parseFloat(getComputedStyle(list).paddingTop) || 0;
          if (Math.abs(now - want) > 1 && ++tries < 5) return void requestAnimationFrame(again);
          sts[j].scrollIntoView({ block: "start" });
        };
        requestAnimationFrame(again);
      }
    }

    const k = `${rest}|${cur.join(",")}`;
    if (k !== key) {
      key = k;
      scope.classList.toggle("is-rest", rest);
      sts.forEach((s, j) => s.classList.toggle("is-cur", cur.includes(j)));
      caption.textContent = rest ? restCap : cur.length > 1 ? endCap : rowAt[cur[0]].dataset.cap!;
    }
    const curIds = new Set(cur.map((j) => sts[j].dataset.st));
    for (const r of rows) {
      const isCur = curIds.has(r.dataset.row);
      r.classList.toggle("is-cur", isCur);
      r.classList.toggle("is-future", !rest && !isCur && Number(r.dataset.start) > t + 0.005);
    }
  };

  let raf = 0;
  function schedule() {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(update);
  }
  addEventListener(
    "scroll",
    () => {
      schedule();
      if (pinned < 0) return;
      // (the timer is not restarted by every scroll: continuous scrolling without a pause
      // would otherwise never release the pin)
      if (restY === null) {
        if (!settlePending) settle();
      } else if (Math.abs(scrollY - restY) > 4) unpin();
    },
    { passive: true },
  );
  addEventListener("resize", layout);
  new ResizeObserver(layout).observe(planWrap);
  const loaded =
    document.readyState === "complete" ? Promise.resolve() : new Promise((r) => addEventListener("load", r, { once: true }));
  Promise.all([document.fonts?.ready, loaded]).then(() => {
    ready = true;
    layout();
  });
  // a late web font changes the label widths
  document.fonts?.addEventListener?.("loadingdone", layout);
  layout();
  update();

  // the reader's own scrolling releases a pin at once (Tab's scroll-into-view does not)
  const scrollKeys = new Set(["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "]);
  addEventListener("wheel", unpin, { passive: true });
  addEventListener("touchmove", unpin, { passive: true });
  addEventListener("keydown", (e) => {
    if (scrollKeys.has(e.key) && !(e.target as HTMLElement).closest?.("input, textarea, select")) unpin();
  });

  sts.forEach((s, j) => s.addEventListener("focusin", () => pin(j, "focus")));
  // focus leaving the stations (e.g. wrapping round to the skip link) ends a focus pin
  list.addEventListener("focusout", (e) => {
    const to = e.relatedTarget as Node | null;
    if (pinBy === "focus" && !(to && list.contains(to))) unpin();
  });

  const pinById = (id: string) => {
    const j = sts.findIndex((s) => s.dataset.st === id);
    if (j >= 0) pin(j, "nav");
    else unpin();
  };
  const fromHash = () => pinById(decodeURIComponent(location.hash.slice(1)));
  for (const r of rows) r.addEventListener("click", () => pinById(r.dataset.row!));
  // Back/Forward: the browser would restore a scroll position saved before layout, the pin
  // and the list's bottom space moved things; instead the station is scrolled into place
  // exactly as a click in the chart puts it (scroll-padding under the pinned chart). History
  // entries without a station get their own saved position back.
  if ("scrollRestoration" in history) history.scrollRestoration = "manual";
  let saveT = 0;
  addEventListener(
    "scroll",
    () => {
      clearTimeout(saveT);
      saveT = window.setTimeout(() => history.replaceState({ ...(history.state ?? {}), wdY: scrollY }, ""), 200);
    },
    { passive: true },
  );
  const toStation = (e?: PopStateEvent) => {
    const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (el && sts.includes(el)) el.scrollIntoView({ block: "start" });
    else if (typeof e?.state?.wdY === "number") scrollTo(0, e.state.wdY);
    fromHash();
  };
  // typed hashes, in-page links, Back/Forward: the same as a fresh load with that hash
  addEventListener("hashchange", () => toStation());
  addEventListener("popstate", toStation);
  if (location.hash) fromHash();
  // manual restoration now covers the whole page: a reload or Back from another site returns
  // to the position this entry last saved (with or without a hash; with manual restoration
  // the browser doesn't even scroll to the hash then). A fresh visit has no saved state and
  // the browser scrolls to the hash itself.
  if (typeof history.state?.wdY === "number") {
    const y = history.state.wdY as number;
    Promise.all([document.fonts?.ready, loaded]).then(() => scrollTo(0, y));
  }

  // pointing at a row picks out its station (marked in the gutter only if it is actually in
  // view below the chart)
  const peek = (els: Iterable<Element | null>, on: boolean) => {
    for (const el of els) el?.classList.toggle("is-peek", on);
  };
  const inView = (el: HTMLElement) => {
    const b = el.getBoundingClientRect();
    const top = planWrap.getBoundingClientRect().bottom;
    return b.bottom > top + 24 && b.top < innerHeight - tabH() - 24;
  };
  for (const r of rows) {
    const st = document.getElementById(r.dataset.row!);
    const on = () => peek([r, st && inView(st) ? st : null], true);
    const off = () => peek([r, st], false);
    r.addEventListener("pointerenter", on);
    r.addEventListener("pointerleave", off);
    r.addEventListener("focus", on);
    // a bar reached by Tab while the chart is still below the fold (or above it): the rows
    // never scroll the page themselves (scroll margins above), so bring the chart in here
    // (two frames later: the browser's own focus scroll, held in place by the margins above,
    // would otherwise undo it)
    r.addEventListener("focus", () =>
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          const b = r.getBoundingClientRect();
          const barH = topBar?.getBoundingClientRect().height ?? 0;
          if (b.top < barH || b.bottom > innerHeight) {
            scrollTo({ top: planWrap.getBoundingClientRect().top + scrollY - barH, behavior: "auto" });
          }
        }),
      ),
    );
    r.addEventListener("blur", off);
  }
</script>

<style>
  /* ---------- page head ---------- */
  .page-head {
    padding-top: var(--sp-section);
    padding-bottom: 1.25rem;
  }

  .lede {
    margin-top: 1rem;
    max-width: 38rem;
    color: var(--ink-2);
  }

  .key {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .key span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* the same pennant as on the chart */
  .k-flag {
    display: inline-block;
    width: 0.75rem;
    height: 0.9rem;
    border-left: 1.5px solid var(--ink);
    position: relative;
  }
  .k-flag::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 0.6rem;
    height: 0.5rem;
    background: var(--ink);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .k-cur {
    display: inline-block;
    width: 1.5rem;
    height: 0.5rem;
    background: var(--c-edu);
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 3.5px var(--ink);
    margin: 0 0.2rem;
  }
  :global(html:not(.js)) .js-key {
    display: none;
  }

  /* category colours (tokens in global.css): lanes, bars, station tags */
  [data-cat="ausbildung"] {
    --c: var(--c-edu);
  }
  [data-cat="arbeiten"] {
    --c: var(--c-thesis);
  }
  [data-cat="praxis"] {
    --c: var(--c-work);
  }

  /* ---------- the plan: pinned under the top bar (with JS) ---------- */
  .plan-wrap {
    --lbl: 0rem; /* lane label column; phones have none */
    --bar: 6px;
    /* one line of a lane: label zone, bar, gap; --fx extra below a line with a flag, --drop how
       far a flag pole reaches below the bar top */
    --lz: 0.3rem;
    --gap: 0.15rem;
    --drop: 0.6rem;
    --fx: 0.5rem;
    --pitch: calc(var(--lz) + var(--bar) + var(--gap));
    /* the day and its light spots show through, blurred (opaque, it read as a pasted box over
       a spot); 92 % keeps the stations scrolling under it out of the way */
    background: var(--grain), color-mix(in srgb, var(--bg) 92%, transparent);
    background-blend-mode: soft-light, normal;
    /* (the grain fixed to the window, so it lines up with the page grain behind) */
    background-attachment: fixed, scroll;
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    padding: 0.375rem 0 0.5rem;
  }

  /* 1px under the top bar's rule (the bar paints above), so no slit can open between them */
  :global(html.js) .plan-wrap {
    position: sticky;
    top: calc(var(--top-bar-h, calc(var(--top-h) + 1.5px)) - 1px);
    z-index: 30;
  }
  /* faded out while the last station pushes it off (script, phones) */
  .plan-wrap.is-gone {
    pointer-events: none;
  }

  /* text below fades out under the chart instead of being sliced */
  :global(html.js) .plan-wrap::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 28px;
    margin-top: 1px;
    background: linear-gradient(var(--bg), color-mix(in srgb, var(--bg) 0%, transparent));
    pointer-events: none;
  }

  @media (min-width: 48rem) {
    .plan-wrap {
      --lbl: var(--col-meta);
      --bar: 8px;
      --lz: 1.25rem;
      --gap: 0.4rem;
      --drop: 0.85rem;
      --fx: 0.8rem;
      padding: 0.5rem 0 0.625rem;
    }
  }

  /* without JS the lines are packed from an estimate of the label widths, which only holds
     on wide screens (at 768-1279px labels collided): below 80rem the chart is left out, the
     station list below is the content */
  @media (max-width: 79.99rem) {
    :global(html:not(.js)) .plan-wrap {
      display: none;
    }
  }

  /* anchors and focus on a station land below the pinned chart (on top of the page's own
     scroll padding for the top bar); only the stations, the rest of the page is unaffected */
  :global(html.js) .stations > li {
    scroll-margin-top: var(--plan-h, 15rem);
  }

  .plan {
    position: relative;
  }

  .axis {
    display: grid;
    grid-template-columns: var(--lbl) minmax(0, 1fr);
    height: 1.125rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .axis-track {
    grid-column: 2;
    position: relative;
    height: 100%;
  }

  .year {
    position: absolute;
    bottom: 0.25rem;
    padding-left: 0.3rem;
    line-height: 1;
  }

  /* the top strip of the body holds the playhead's date tag and "heute" */
  .body {
    position: relative;
    border-top: 1.5px solid var(--ink);
    padding-top: calc(0.9rem + 4px);
  }

  /* year lines, "heute" and the playhead share the track column. The grid is no stacking
     context of its own, so its pieces layer with the lanes: year lines under the bars, the
     "heute" line and the playhead over the bars but under the labels (z 2, with a page-coloured
     backing), the date tag and "heute" on top of everything. */
  .grid {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--lbl);
    right: 0;
    pointer-events: none;
  }

  .grid i {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--line);
  }

  .today {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1.5px dashed var(--ink-2);
    z-index: 1;
  }

  .today-lbl,
  .head-tag {
    position: absolute;
    top: 0;
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* right-aligned to the dashed line, at its top end */
  .today-lbl {
    transform: translateX(calc(-100% - 4px));
    color: var(--ink);
    padding: 1px 0;
    z-index: 3;
  }
  .today-lbl.is-hidden {
    visibility: hidden;
  }

  /* the playhead's date, at the top of its line (clamped inside the track by the script) */
  .head-tag {
    transform: translateX(-50%);
    padding: 1px 5px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    z-index: 4;
    display: none;
  }

  .playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1.5px solid var(--ink);
    z-index: 1;
    display: none;
  }

  :global(html.js) .playhead,
  :global(html.js) .head-tag {
    display: block;
    transition: opacity 0.25s;
  }
  /* at rest (page top) the chart is a plain plan: no playhead */
  .scope.is-rest .playhead,
  .scope.is-rest .head-tag {
    opacity: 0;
  }

  /* ---------- lanes: the category on the left, its stations on as many lines as they need ---------- */
  .lane {
    display: grid;
    grid-template-columns: var(--lbl) minmax(0, 1fr);
    border-bottom: 1px solid var(--line);
  }

  /* while reading, only the current station's lane(s) show (script) */
  .lane.is-off {
    display: none;
  }

  /* the script keeps the text in place itself when the chart changes height (margin above
     the stations); the browser's own scroll anchoring would correct it a second time */
  :global(html) {
    overflow-anchor: none;
  }

  .lane:last-child {
    border-bottom: 0;
  }

  /* phones: the lane's name, small, at its start above its bars */
  .lane-lbl {
    grid-column: 1 / -1;
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    width: max-content;
    margin-top: 0.2rem;
    padding-right: 3px;
    background: var(--bg);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }
  .lane-lbl small {
    display: none;
  }

  .lane-lbl i {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--c);
  }

  @media (min-width: 48rem) {
    .lane-lbl {
      grid-column: 1;
      align-items: flex-start;
      gap: 0.55rem;
      width: auto;
      margin-top: 0;
      padding: 0.5rem 1rem 0.5rem 0;
      background: none;
      font-size: 0.875rem;
      font-weight: 700;
      line-height: 1.25;
    }
    .lane-lbl small {
      display: block;
      margin-top: 0.1rem;
      font-size: 0.75rem;
      font-weight: 400;
      color: var(--ink-2);
    }
    .lane-lbl i {
      width: 0.75rem;
      height: 0.75rem;
      margin-top: 0.15rem;
    }
  }

  /* Each station sits on a line (--line, set by the packing, --fb = lines with flags above it).
     A line is the label zone (--lz), the bar and a gap; a line with a flag gets --fx more room
     below for the flag and its name. */
  .lane-track {
    grid-column: 2;
    position: relative;
    min-width: 0;
    margin: 0.2rem 0;
    height: calc(var(--lines) * var(--pitch) + var(--flag-lines) * var(--fx));
  }

  /* the station: a link covering its label and bar */
  .seg {
    position: absolute;
    top: calc(var(--line) * var(--pitch) + var(--fb) * var(--fx));
