---
import { ratedSkills, otherCompetencies, certifications } from "../../data/cv";

// Ledger: the CV's own words are the scale, strongest first, so nothing is drawn that the
// CV doesn't say. The skills are what matters and are set large; the level word is the
// small row head.
const byLevel = (group: string) => {
  const rows = new Map<string, { level: number; names: string[] }>();
  for (const s of ratedSkills.filter((s) => s.group === group)) {
    const row = rows.get(s.levelLabel) ?? { level: s.level, names: [] };
    row.names.push(s.name);
    rows.set(s.levelLabel, row);
  }
  return [...rows.entries()].sort((a, b) => b[1].level - a[1].level);
};

const software = byLevel("Software & BI");
const languages = byLevel("Sprachen");
---

<section id="kenntnisse" class="sec" aria-labelledby="h-kenntnisse">
  <div class="wrap page">
    <h2 id="h-kenntnisse" class="display page-title">Kenntnisse</h2>

    <div class="ledger">
      <section aria-labelledby="k-sw">
        <h3 id="k-sw" class="h2">Software</h3>
        <dl class="levels">
          {
            software.map(([label, row]) => (
              <div>
                <dt>{label}</dt>
                <dd>{row.names.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="k-lang">
        <h3 id="k-lang" class="h2">Sprachen</h3>
        <dl class="levels">
          {
            languages.map(([label, row]) => (
              <div>
                <dt>{label}</dt>
                <dd>{row.names.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="wide" aria-labelledby="k-cert">
        <h3 id="k-cert" class="h2">Zertifikate</h3>
        <dl class="pairs">
          {
            certifications.map((c) => (
              <div id={c.id}>
                <dt>
                  {c.name} <span class="tnum year">{c.date}</span>
                </dt>
                <dd>{c.authority}</dd>
              </div>
            ))
          }
        </dl>
        <!-- the core skills and where they come from are the Kernkompetenzen panels above;
             only what has no panel of its own stays here -->
        <p class="others">Außerdem: {otherCompetencies.join(", ")}.</p>
      </section>
    </div>
  </div>
</section>

<style>
  .page {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-block);
  }

  /* one column grid for everything: Software | Sprachen on top, and the two-column rows
     of the wide blocks use the same 3fr / 2fr split, so their second column lines up
     with the Sprachen column and every rule runs the same width */
  .ledger {
    --cols: minmax(0, 3fr) minmax(0, 2fr);
    --col-gap: clamp(2.5rem, 1rem + 5vw, 5rem);
    margin-top: 2.5rem;
    display: grid;
    gap: var(--sp-block);
  }

  @media (min-width: 56rem) {
    .ledger {
      grid-template-columns: var(--cols);
      gap: var(--sp-block) var(--col-gap);
    }
    .wide {
      grid-column: 1 / -1;
    }
  }

  /* section heads: quiet grotesk labels, not display */
  .h2 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
    padding-bottom: 0.6rem;
    border-bottom: 1.5px solid var(--ink);
  }

  /* levels: small level word, large skill names */
  .levels > div {
    padding: 0.9rem 0 1rem;
    border-bottom: 1px solid var(--line);
  }

  .levels dt {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .levels dd {
    margin-top: 0.15rem;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.3;
  }

  @media (min-width: 40rem) {
    .levels > div {
      display: grid;
      grid-template-columns: clamp(8rem, 6rem + 3vw, 10rem) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: baseline;
    }
    .levels dd {
      margin-top: 0;
    }
  }

  /* name | where, name | issuer */
  .pairs > div {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .pairs dt {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.35;
  }

  .pairs dd {
    margin-top: 0.15rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .year {
    margin-left: 0.4rem;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  @media (min-width: 56rem) {
    .pairs > div {
      display: grid;
      grid-template-columns: var(--cols);
      column-gap: var(--col-gap);
      align-items: baseline;
    }
    .pairs dd {
      margin-top: 0;
    }
  }

  /* reached via a link from a Kernkompetenzen panel: mark the row it points to
     (an ink bar in the gutter, it doesn't shift the row) */
  .pairs > div {
    position: relative;
  }

  .pairs > div:target::before {
    content: "";
    position: absolute;
    left: -0.75rem;
    top: 0.6rem;
    bottom: 0.6rem;
    border-left: 4px solid var(--ink);
  }

  .others {
    margin-top: 2rem;
    color: var(--ink-2);
  }
</style>
