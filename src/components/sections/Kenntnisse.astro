---
import { ratedSkills, otherCompetencies, certifications } from "../../data/cv";

// Kenntnisse as pillars (owner 2026-10-03, "more creative, vertical or horizontal pillars"):
// every rated skill is a pillar of five blocks standing on a shared ground line, as many
// filled as the CV's own level (the empty ones stay outlined, so the scale reads); the CV's
// level word sits on top. Phones: the pillars lie down as bars. Only what the CV rates.
const groups = [
  { id: "sw", name: "Software", skills: ratedSkills.filter((s) => s.group === "Software & BI") },
  { id: "lang", name: "Sprachen", skills: ratedSkills.filter((s) => s.group === "Sprachen") },
];
const SLOTS = 5;
// each pillar's place in the build-up animation (Software first, then Sprachen)
const order = (g: (typeof groups)[number], i: number) => (g.id === "lang" ? groups[0].skills.length : 0) + i;
---

<section id="kenntnisse" class="sec" aria-labelledby="h-kenntnisse">
  <div class="wrap page">
    <h2 id="h-kenntnisse" class="display page-title">Kenntnisse</h2>

    <div class="yard" data-pillars>
      {
        groups.map((g) => (
          <section class:list={["grp", `grp-${g.id}`]} aria-labelledby={`k-${g.id}`}>
            <h3 id={`k-${g.id}`} class="grp-name">
              {g.name}
            </h3>
            <ul class="pillars">
              {g.skills.map((s, i) => (
                <li class="pillar" style={`--lv:${s.level};--p:${order(g, i)}`}>
                  <span class="lvl">{s.levelLabel.replace("Grundkenntnisse", "Grund\u00adkenntnisse")}</span>
                  <span class="blocks" aria-hidden="true">
                    {Array.from({ length: SLOTS }, (_, i) => (
                      <i class:list={[i < s.level && "on"]} style={`--i:${i}`} />
                    ))}
                  </span>
                  <span class="nm">{s.name}</span>
                  <span class="sr-only">
                    : {s.levelLabel}, {s.level} von {SLOTS}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <section class="certs" aria-labelledby="k-cert">
      <h3 id="k-cert" class="h2">Zertifikate</h3>
      <ul class="cert-list">
        {
          certifications.map((c) => (
            <li id={c.id} class="cert">
              <span class="cert-year tnum">{c.date}</span>
              <span class="cert-name">{c.name}</span>
              <span class="cert-by">{c.authority}</span>
            </li>
          ))
        }
      </ul>
      <!-- the core skills and where they come from are the Kernkompetenzen panels above;
           only what has no panel of its own stays here -->
      <p class="others-lbl">Außerdem</p>
      <ul class="others">
        {otherCompetencies.map((o) => <li>{o}</li>)}
      </ul>
    </section>
  </div>
</section>

<script>
  // the pillars are built when they scroll into view (owner 2026-10-03): the dashed scaffold
  // first, then the blocks drop onto the stack one by one, pillar by pillar; again each time
  // the reader comes back from above (not with reduced motion; without JS they just stand)
  const yard = document.querySelector<HTMLElement>("[data-pillars]");
  if (yard && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    yard.classList.add("is-waiting");
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.intersectionRatio >= 0.35) yard.classList.remove("is-waiting");
        // fully out of view below the window (scrolled back up): ready to build again
        else if (!e.isIntersecting && e.boundingClientRect.top > 0) yard.classList.add("is-waiting");
      },
      { threshold: [0, 0.35] },
    );
    io.observe(yard);
  }
</script>

<style>
  .page {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-block);
  }

  /* ---------- the pillar yard ---------- */
  .yard {
    --slot: clamp(2.1rem, 1.6rem + 1.6vw, 3.1rem); /* one block's height */
    --gap: 4px;
    display: grid;
    gap: var(--sp-block);
    margin-top: var(--sp-gap);
  }

  .grp-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .grp-sw {
    --c: var(--c-edu);
  }
  .grp-lang {
    --c: var(--c-work);
  }

  /* phones: the pillars lie down, one bar per skill */
  .pillars {
    display: grid;
    gap: 0.9rem;
  }

  .pillar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "nm lvl"
      "blocks blocks";
    gap: 0.3rem 1rem;
    align-items: baseline;
  }

  .nm {
    grid-area: nm;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.25;
  }

  .lvl {
    grid-area: lvl;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .blocks {
    grid-area: blocks;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gap);
    height: 0.9rem;
  }

  .blocks i {
    border: 1.5px dashed var(--line);
    border-radius: 2px;
    /* the scaffold appears with its pillar */
    transition: opacity 0.3s calc(var(--p) * 140ms);
  }

  .blocks i.on {
    border: 0;
    background: var(--c);
    /* one block after the other, pillar by pillar, landing with a slight bounce */
    --d: calc(var(--p) * 140ms + 200ms + var(--i) * 110ms);
    transition:
      transform 0.55s cubic-bezier(0.3, 1.45, 0.5, 1) var(--d),
      opacity 0.2s var(--d);
  }

  /* the level word once its pillar stands */
  .lvl {
    transition: opacity 0.35s calc(var(--p) * 140ms + 200ms + var(--lv) * 110ms + 250ms);
  }

  .is-waiting .blocks i,
  .is-waiting .lvl {
    opacity: 0;
    transition: none;
  }

  /* (phones: the bars are laid from the left) */
  .is-waiting .blocks i.on {
    transform: translateX(-1.5rem);
  }

  /* wide: the pillars stand on one ground line, Software and Sprachen side by side */
  @media (min-width: 48rem) {
    .yard {
      grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--sp-gap);
      padding-bottom: 0;
      border-bottom: 1.5px solid var(--ink);
    }

    /* top-aligned with a fixed-height level label, so every pillar's blocks start and end
       at the same height whatever its name's length; the ground line is drawn there */
    .pillars {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: clamp(0.75rem, 0.3rem + 1.4vw, 2rem);
      align-items: start;
    }

    .pillar {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "lvl"
        "blocks"
        "nm";
      gap: 0.5rem;
      justify-items: center;
      text-align: center;
    }

    .lvl {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      height: 2rem;
      font-size: 0.8125rem;
      line-height: 1.2;
      hyphens: manual;
    }

    .blocks {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: repeat(5, var(--slot));
      width: min(100%, 4.5rem);
      height: auto;
      /* bottom-up: the first block sits on the ground */
      transform: scaleY(-1);
    }

    /* each block drops onto the stack from above (the column is flipped, so a positive
       offset here is upward on screen) */
    .is-waiting .blocks i.on {
      transform: translateY(3rem);
    }

    /* the names under the ground line */
    .nm {
      order: 3;
      margin-top: 0.6rem;
      font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.125rem);
      hyphens: auto;
    }
  }

  /* the ground line runs under the blocks, above the names: the names hang below it */
  @media (min-width: 48rem) {
    .yard {
      border-bottom: 0;
    }
    .pillars {
      position: relative;
    }
    .pillars::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      /* label (2rem) + gap (0.5rem) + five blocks and their four gaps */
      top: calc(2rem + 0.5rem + 5 * var(--slot) + 4 * var(--gap) + 1px);
      border-bottom: 1.5px solid var(--ink);
    }
  }

  /* ---------- certificates and the rest ---------- */
  .certs {
    margin-top: var(--sp-block);
  }

  .h2 {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    padding-bottom: 0.6rem;
    border-bottom: 1.5px solid var(--ink);
  }

  .cert-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 48rem) {
    .cert-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cert {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 4px solid var(--c-thesis);
  }

  .cert-year {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  .cert-name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .cert-by {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  /* reached via a link from a Kernkompetenzen card: the card is outlined in ink */
  .cert:target {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .others-lbl {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .others li {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: 0.9375rem;
  }
</style>
