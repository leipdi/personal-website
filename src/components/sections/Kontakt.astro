---
import { profile } from "../../data/cv";
import { cvPdf } from "../../data/nav";

const [user, domain] = profile.email.split("@");
// break only after "linkedin.com/in/", never inside the handle (it has hyphens)
const liCut = profile.linkedin.lastIndexOf("/") + 1;
const liHost = profile.linkedin.slice(0, liCut);
const liPath = profile.linkedin.slice(liCut);

// "Stand" = the build date (a static site: rebuild to move it)
const months = ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"];
const now = new Date();
const stand = `${months[now.getMonth()]} ${now.getFullYear()}`;
---

<section id="kontakt" class="sec" aria-labelledby="h-kontakt">
  <div class="wrap page">
    <h2 id="h-kontakt" class="display page-title">Kontakt</h2>

    <!-- the page's one heavy grotesk moment: the e-mail, set apart from the serif titles -->
    <a class="mail" href={`mailto:${profile.email}`}>
      <span class="mail-u">{user}<wbr />@{domain}</span>
    </a>

    <div class="card-row">
      <!-- a letterhead, not a form: the details speak for themselves without labels -->
      <address class="letterhead">
        <strong>{profile.name}</strong>
        <span>{profile.role}</span>
        <span>{profile.location}</span>
        <a class="prose-link" href={`tel:${profile.phone.replace(/\s/g, "")}`}>{profile.phone}</a>
        <a class="prose-link" href={profile.linkedinUrl} target="_blank" rel="noreferrer"
          >{liHost}<wbr /><span class="nobr">{liPath}</span></a
        >
        <a class="cv" href={cvPdf} target="_blank" rel="noreferrer">Lebenslauf als PDF</a>
      </address>

    </div>
  </div>
  <!-- the page ends on one sign-off line (the field drawing that stood under it went, owner
       2026-10-09: "no function") -->
  <p class="wrap sign-off">
    <span>Stand: {stand}</span>
    <a class="prose-link" href="#top">Nach oben</a>
  </p>
</section>

<style>
  .page {
    padding-top: var(--sp-section);
  }

  .sign-off {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: var(--sp-block);
    padding-top: 1rem;
    padding-bottom: var(--sp-gap);
    /* the hairline over the content column only (a border spanned the gutters too) */
    background: linear-gradient(var(--line), var(--line)) no-repeat var(--gutter) 0 / calc(100% - 2 * var(--gutter)) 1px;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .mail {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--sans);
    font-weight: 800;
    letter-spacing: -0.045em;
    /* capped so it stays on one line in the 72rem column on the widest screens */
    font-size: clamp(2rem, 0.8rem + 4.6vw, 5.25rem);
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  /* the underline in the spectrum's dusk end (one of its two sprinkles, global.css), drawn as
     a background so it can be a gradient; on the inline text, cloned per line, so where the
     address wraps on phones each line is underlined to its own end (on the block it ran on
     into empty space); thicker on hover */
  .mail-u {
    background: var(--spectrum-dusk) no-repeat 0 100% / 100% 0.07em;
    padding-bottom: 0.1em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.15s;
  }

  .mail:hover .mail-u {
    background-size: 100% 0.14em;
  }

  .card-row {
    margin-top: var(--sp-block);
    display: grid;
    gap: var(--sp-block);
  }

  @media (min-width: 56rem) {
    .card-row {
      margin-top: calc(var(--sp-block) * 1.15);
      align-items: start;
    }
  }

  /* one type style for the whole block: grotesk, the name in 700, the rest 400 */
  .letterhead {
    font-family: var(--sans);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.5;
    font-style: normal;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.15rem;
  }

  .letterhead strong {
    font-weight: 700;
  }

  .nobr {
    white-space: nowrap;
  }

  .cv {
    margin-top: 1.5rem;
    font-family: var(--sans);
    font-size: 1rem;
    background: var(--ink);
    color: var(--paper);
    border: 2px solid var(--ink);
    padding: 0.8rem 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .cv:hover {
    background: var(--ink-2);
    border-color: var(--ink-2);
    color: var(--paper);
  }

  /* section head: a quiet grotesk label, not display */
  .h2 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
  }
</style>
