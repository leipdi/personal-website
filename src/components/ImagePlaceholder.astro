---
// Marks a spot where a real picture would help. Replace the whole component with an <img>
// (or <figure>) once the owner has the picture.
interface Props {
  label: string; // what the picture should show
  ratio?: string; // CSS aspect-ratio, e.g. "4 / 3"
  note?: string; // hint on source or cropping
}

const { label, ratio = "4 / 3", note } = Astro.props;
// role="img" hides the caption from screen readers, so the note goes into the name too
const name = `Bildplatzhalter: ${label}${note ? ` (${note})` : ""}`;
---

<figure class="img-ph" role="img" aria-label={name} style={`aspect-ratio:${ratio}`} data-placeholder="bild">
  <svg class="img-ph-x" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="0" x2="100" y2="100"></line>
    <line x1="100" y1="0" x2="0" y2="100"></line>
  </svg>
  <figcaption>
    <strong>Bildplatzhalter</strong>
    <span>{label}</span>
    {note && <span class="img-ph-note">{note}</span>}
  </figcaption>
</figure>

<style>
  .img-ph {
    position: relative;
    margin: 0;
    width: 100%;
    min-height: 9rem;
    border: 2px dashed var(--ph);
    background: #fff;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .img-ph-x {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .img-ph-x line {
    stroke: var(--ph);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.35;
  }

  figcaption {
    position: relative;
    display: grid;
    gap: 0.2rem;
    max-width: 22rem;
    margin: 1rem;
    padding: 0.6rem 0.8rem;
    background: #fff;
    text-align: center;
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--navy);
  }

  strong {
    color: var(--ph);
  }

  .img-ph-note {
    color: var(--ink-2);
    font-size: 0.8125rem;
  }
</style>
