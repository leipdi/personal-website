---
import type { RevisionEntry } from "../data/cv";

interface Props {
  entries: RevisionEntry[];
}

const { entries } = Astro.props;

const now = new Date();
const todayFrac = now.getFullYear() + now.getMonth() / 12;

const minYear = Math.min(...entries.map((e) => e.fromYear));
const maxYear = Math.ceil(Math.max(todayFrac + 0.6, ...entries.map((e) => e.toYear)));
const span = maxYear - minYear;

const rows = entries.map((e, i) => {
  const end = e.to === "heute" ? todayFrac : e.toYear;
  const left = ((e.fromYear - minYear) / span) * 100;
  const width = Math.max(((end - e.fromYear) / span) * 100, 1.2);
  return { ...e, left, width, gridRow: i + 2 };
});

const axisYears = Array.from({ length: Math.floor(span / 2) + 1 }, (_, i) => minYear + i * 2);
const lastAxisIndex = axisYears.length - 1;
const todayLeft = ((todayFrac - minYear) / span) * 100;
const totalRows = rows.length + 1;
---

<div class="relative sm:grid sm:grid-cols-[minmax(0,1fr)_18rem] sm:gap-x-3">
  <div class="font-ui relative mb-2 h-5 text-[11px] text-ink-muted sm:col-start-1" style={{ gridRow: 1 }}>
    {
      axisYears.map((y, i) => (
        <span
          class:list={[
            "absolute",
            i === 0 ? "translate-x-0" : i === lastAxisIndex ? "-translate-x-full" : "-translate-x-1/2",
          ]}
          style={{ left: `${((y - minYear) / span) * 100}%` }}
        >
          {y}
        </span>
      ))
    }
  </div>
  <div class="hidden sm:col-start-2 sm:block" style={{ gridRow: 1 }} aria-hidden="true" />

  <div
    class="absolute top-0 bottom-0 border-l border-dashed border-copper/60 sm:col-start-1"
    style={{ left: `${todayLeft}%`, gridRow: `1 / span ${totalRows}` }}
    aria-hidden="true"
  >
    <span class="font-ui absolute -top-5 -translate-x-full whitespace-nowrap text-[10px] text-copper">heute</span>
  </div>

  {
    rows.map((r) => (
      <div class="border-t border-line py-2.5 first:border-t-0 sm:contents">
        <div
          class="relative h-2 rounded-sm bg-surface-sunken sm:col-start-1 sm:self-center"
          style={{ gridRow: r.gridRow }}
        >
          <div
            class:list={["absolute top-0 h-2 rounded-sm", r.kind === "beruf" ? "bg-copper" : "bg-teal"]}
            style={{ left: `${r.left}%`, width: `${r.width}%` }}
            title={`${r.title} (${r.from}–${r.to})`}
          />
        </div>
        <div class="mt-1.5 sm:col-start-2 sm:mt-0 sm:self-center sm:text-right" style={{ gridRow: r.gridRow }}>
          <p class="text-sm text-ink">{r.title}</p>
          <p class="font-ui text-[10px] text-ink-muted">
            Rev. {r.rev} ({r.from}–{r.to})
          </p>
        </div>
      </div>
    ))
  }
</div>

<div class="font-ui mt-4 flex gap-5 text-[11px] text-ink-secondary">
  <span class="flex items-center gap-1.5">
    <span class="inline-block h-2 w-4 rounded-sm bg-teal" /> Ausbildung
  </span>
  <span class="flex items-center gap-1.5">
    <span class="inline-block h-2 w-4 rounded-sm bg-copper" /> Beruf
  </span>
</div>
