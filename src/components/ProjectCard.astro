---
import type { Project } from "../data/cv";

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
---

<article class="border border-line bg-surface p-5 sm:p-6">
  <p class="font-ui text-xs text-ink-muted">{p.period}</p>
  <h2 class="mt-2 font-display text-2xl leading-tight text-ink sm:text-[28px]">{p.title}</h2>
  <p class="text-sm text-ink-secondary">{p.org}</p>

  <div class="mt-4 space-y-3 text-sm leading-relaxed text-ink">
    <p>{p.context}</p>
    <p>{p.approach}</p>
    <p>{p.result}</p>
  </div>

  <ul class="font-ui mt-4 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-teal-ink">
    {p.tags.map((t) => <li class="border border-teal/40 px-1.5 py-0.5">{t}</li>)}
  </ul>

  {
    p.link && (
      <a
        class="mt-4 inline-block w-fit border-b border-teal text-sm text-teal-ink hover:text-ink hover:border-ink"
        href={p.link.href}
        target="_blank"
        rel="noreferrer"
      >
        {p.link.label}
      </a>
    )
  }
</article>
