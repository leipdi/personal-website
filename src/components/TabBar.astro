---
interface Props {
  active: string;
}

const { active } = Astro.props;

const tabs = [
  {
    href: "/",
    id: "uebersicht",
    label: "Übersicht",
    icon: "M3 13h6V3H3v10Zm0 8h6v-6H3v6Zm8 0h10V11H11v10Zm0-18v6h10V3H11Z",
  },
  {
    href: "/werdegang/",
    id: "werdegang",
    label: "Werdegang",
    icon: "M4 19h16M7 19V9l4-3 4 3v10M4 19V13l3-2M20 19V11l-3-2",
  },
  {
    href: "/projekte/",
    id: "projekte",
    label: "Projekte",
    icon: "M12 3 3 8l9 5 9-5-9-5Zm-9 9 9 5 9-5M3 8v8M21 8v8",
  },
  {
    href: "/kenntnisse/",
    id: "kenntnisse",
    label: "Kenntnisse",
    icon: "M4 20V10M10 20V4M16 20v-7M22 20H2",
  },
  {
    href: "/kontakt/",
    id: "kontakt",
    label: "Kontakt",
    icon: "M3 5h18v14H3V5Zm0 0 9 7 9-7",
  },
];
---

<nav class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-surface/95 backdrop-blur" aria-label="Hauptnavigation">
  <ul class="mx-auto flex max-w-3xl items-stretch justify-between px-2 sm:justify-center sm:gap-2">
    {
      tabs.map((t) => (
        <li class="flex-1 sm:flex-none">
          <a
            href={t.href}
            aria-current={active === t.id ? "page" : undefined}
            class:list={[
              "font-ui flex min-h-[56px] flex-col items-center justify-center gap-1 px-2 py-1.5 text-[11px] font-medium transition-colors sm:min-w-[92px]",
              active === t.id ? "text-teal-ink" : "text-ink-secondary hover:text-ink",
            ]}
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={t.icon} />
            </svg>
            <span>{t.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
