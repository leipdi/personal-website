---
import { nav, cvPdf } from "../data/nav";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f6f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap"
    />
  </head>
  <body id="top">
    <a href="#inhalt" class="skip">Zum Inhalt springen</a>


    <!-- remove once every Placeholder / ImagePlaceholder is replaced -->
    <p class="draft-note">
      Entwurf: Magenta markierte Stellen sind KI-Platzhalter (Texte, Daten, Bildideen) und werden noch ersetzt.
    </p>

    <header class="top">
      <div class="wrap top-in">
        <a href="#top" class="top-name">Daniel Lenski</a>
        <nav class="top-nav" aria-label="Hauptnavigation">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} data-nav={n.id}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <!-- phones: the sections and the CV behind one small menu (the bar has no room) -->
        <details class="top-menu" data-menu>
          <summary>Menü</summary>
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href}>{n.label}</a>
                </li>
              ))
            }
            <li class="top-menu-cv">
              <a href={cvPdf} target="_blank" rel="noreferrer">Lebenslauf (PDF)</a>
            </li>
          </ul>
        </details>
        <a href={cvPdf} target="_blank" rel="noreferrer" class="top-cv">Lebenslauf (PDF)</a>
      </div>
    </header>

    <main id="inhalt" class="content" tabindex="-1">
      <slot />
    </main>

    <script>
      // the section in view gets the ink bar in the top bar: the last section whose top has
      // passed a line a third of the way down the window (by position, not by the section
      // boxes, so content pushed past a section's box still counts as that section)
      const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")];
      const secs = links.map((a) => document.getElementById(a.dataset.nav!));
      let raf = 0;
      const mark = () => {
        const line = innerHeight / 3;
        let cur = -1;
        secs.forEach((el, i) => {
          if (el && el.getBoundingClientRect().top <= line) cur = i;
        });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) cur = secs.length - 1;
        links.forEach((a, i) => (i === cur ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      addEventListener(
        "scroll",
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(mark);
        },
        { passive: true },
      );
      addEventListener("resize", mark);
      mark();

      // the phone menu closes when a section is picked, on Escape, or on a tap elsewhere
      const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
      if (menu) {
        menu.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("a")) menu.open = false;
        });
        document.addEventListener("click", (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && menu.open) {
            menu.open = false;
            menu.querySelector("summary")?.focus();
          }
        });
        // also when focus leaves it, or the page scrolls on (it would cover the pinned chart)
        menu.addEventListener("focusout", (e) => {
          if (!menu.contains(e.relatedTarget as Node | null)) menu.open = false;
        });
        let openY = 0;
        menu.addEventListener("toggle", () => (openY = scrollY));
        addEventListener(
          "scroll",
          () => {
            if (menu.open && Math.abs(scrollY - openY) > 40) menu.open = false;
          },
          { passive: true },
        );
      }

      // the bar's name stays hidden while the hero's big name is on screen
      const top = document.querySelector<HTMLElement>(".top");
      const heroName = document.getElementById("name");
      if (top && heroName) {
        // (the last entry: after Back one batch can hold a stale "visible" before the real state)
        new IntersectionObserver((es) => top.classList.toggle("is-hero", es[es.length - 1].isIntersecting), {
          rootMargin: `-${top.offsetHeight}px 0px 0px 0px`,
        }).observe(heroName);
      }
    </script>
  </body>
</html>


<style>
  .draft-note {
    background: var(--ph);
    color: #fff;
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: 0.4rem 1.25rem;
    text-align: center;
  }

  /* fixed, so focusing it doesn't scroll the page to the top */
  .skip {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 0.75rem;
  }
  .skip:focus {
    top: 1rem;
  }

  /* the skip link moves focus to main (tabindex -1); no ring around the whole page */
  .content:focus {
    outline: none;
  }



  /* ---------- top bar: the page's own steel paper, closed by one ink rule ---------- */
  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1.5px solid var(--ink);
  }

  /* The bar sits inside the page's top scroll padding, so the browser took its own links as
     hidden and scrolled the page up to reveal them on keyboard focus. A negative scroll
     margin puts their scroll area below the padding: focus in the bar never moves the page. */
  .top :global(a),
  .top :global(summary) {
    scroll-margin-top: -6rem;
  }

  .top-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--top-h);
  }

  /* in the serif of the hero name; hidden while that big name is on screen (script), so
     the name doesn't show twice in the first screen */
  .top-name {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s, visibility 0.2s;
  }

  .top.is-hero .top-name {
    opacity: 0;
    visibility: hidden;
  }

  /* phones: the sections sit in the small menu below (four links do not fit the bar) */
  .top-nav {
    display: none;
  }

  .top-menu {
    position: relative;
    margin-left: auto;
  }

  .top-menu summary {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .top-menu summary::-webkit-details-marker {
    display: none;
  }

  /* a small chevron that turns when open */
  .top-menu summary::after {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    margin-top: -0.2rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.15s;
  }

  .top-menu[open] summary::after {
    margin-top: 0.15rem;
    transform: rotate(225deg);
  }

  .top-menu ul {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    min-width: 12rem;
    padding: 0.4rem 0;
    background: var(--paper);
    border: 1.5px solid var(--ink);
  }

  .top-menu a {
    display: block;
    padding: 0.65rem 1rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .top-menu a:hover,
  .top-menu a:focus-visible {
    background: var(--wash);
  }

  .top-menu-cv {
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
  }

  /* phones: the CV link lives in the menu */
  .top-cv {
    display: none;
  }

  .top-cv {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--steel);
    text-underline-offset: 0.2em;
    padding: 0.5rem 0;
    white-space: nowrap;
  }

  .top-cv:hover {
    text-decoration-thickness: 3px;
    text-decoration-color: var(--ink);
  }

  /* one page: the bar stays (sticky) on every size, so the section links are always there */
  @media (min-width: 64rem) {
    .top-in {
      min-height: 3.75rem;
    }

    .top-name {
      font-size: 1.5rem;
    }

    .top-nav {
      display: block;
      margin-left: auto;
    }

    .top-menu {
      display: none;
    }

    .top-cv {
      display: inline;
    }

    .top-nav ul {
      display: flex;
      gap: 2rem;
    }

    .top-nav a {
      display: block;
      padding: 0.4rem 0;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink-2);
      text-decoration: none;
      border-bottom: 3px solid transparent;
    }

    .top-nav a:hover {
      color: var(--ink);
      border-bottom-color: var(--line);
    }

    /* the section in view: ink and the bar (no bolder weight, that would reflow the row) */
    .top-nav a[aria-current="true"] {
      color: var(--ink);
      border-bottom-color: var(--ink);
    }

    .top-cv {
      margin-left: 1rem;
      padding-left: 2rem;
      border-left: 1.5px solid var(--line);
      line-height: 1.2;
    }
  }
</style>
