---
import { nav, cvPdf } from "../data/nav";
import { url } from "../lib/url";
import { profile } from "../data/cv";
import { DAY } from "../data/day";
import "../styles/fonts.css";
import "../styles/global.css";
// the two fonts the first screen needs, preloaded (the hero name and claim, the top bar)
import newsreaderLatin from "../assets/fonts/newsreader-latin.woff2?url";
import schibstedLatin from "../assets/fonts/schibsted-grotesk-latin.woff2?url";
import italicFont from "../assets/fonts/italic-text.json";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// the letters of the claim's *marked* words, the only italic on the site: the self-hosted
// Newsreader italic holds just these (scripts/fonts.mjs); a new letter needs a new subset
const italicText = [...new Set((profile.claim.match(/\*(.+?)\*/g) ?? []).join("").replace(/\*/g, ""))].join("");
const missing = [...italicText].filter((c) => !italicFont.italicText.includes(c));
if (missing.length)
  throw new Error(`The claim's italic words use letters not in the italic font subset (${missing.join("")}): run node scripts/fonts.mjs`);

// share previews (LinkedIn, messengers) and search engines need absolute URLs: the deploy
// sets SITE_URL (astro.config.mjs); locally they fall back to the dev server's address
const origin = Astro.site ?? Astro.url;
const canonical = new URL(url("/"), origin).href;
const ogImage = new URL(url("/og.jpg"), origin).href;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: "Wirtschaftsingenieur",
  url: canonical,
  image: new URL(url("/img/daniel-lenski.jpg"), origin).href,
  address: { "@type": "PostalAddress", addressLocality: "Langenfeld (Rheinland)", addressCountry: "DE" },
  sameAs: [profile.linkedinUrl],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={DAY[0].bg} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <!-- self-hosted fonts (styles/fonts.css, scripts/fonts.mjs); no request to a third party -->
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={schibstedLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta property="profile:first_name" content="Daniel" />
    <meta property="profile:last_name" content="Lenski" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body id="top">
    <a href="#inhalt" class="skip">Zum Inhalt springen</a>
    <!-- the day behind the page: its colour, two light spots and the grain (global.css .light) -->
    <div class="light" aria-hidden="true"><i data-light></i><i data-light></i></div>

    <header class="top frost is-hero">
      <div class="wrap top-in">
        <a href="#top" class="top-name">Daniel Lenski</a>
        <nav class="top-nav" aria-label="Hauptnavigation">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} data-nav={n.id}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <!-- phones: the sections and the CV behind one small menu (the bar has no room) -->
        <details class="top-menu" data-menu>
          <summary>Menü</summary>
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href}>{n.label}</a>
                </li>
              ))
            }
            <li class="top-menu-cv">
              <a href={cvPdf} target="_blank" rel="noreferrer">Lebenslauf (PDF)</a>
            </li>
          </ul>
        </details>
        <a href={cvPdf} target="_blank" rel="noreferrer" class="top-cv">Lebenslauf (PDF)</a>
      </div>
    </header>

    <main id="inhalt" class="content" tabindex="-1">
      <slot />
    </main>

    <script>
      import "../scripts/day";
      import "../scripts/topbar";
    </script>
  </body>
</html>


<style>
  /* fixed, so focusing it doesn't scroll the page to the top */
  .skip {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 0.75rem;
  }
  .skip:focus {
    top: 1rem;
  }

  /* the skip link moves focus to main (tabindex -1); no ring around the whole page */
  .content:focus {
    outline: none;
  }



  /* ---------- top bar: the page's own steel paper, closed by one ink rule ---------- */
  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    /* (frosted: global.css .frost) */
    border-bottom: 1.5px solid var(--ink);
  }

  /* The bar sits inside the page's top scroll padding, so the browser took its own links as
     hidden and scrolled the page up to reveal them on keyboard focus. A negative scroll
     margin puts their scroll area below the padding: focus in the bar never moves the page. */
  .top :global(a),
  .top :global(summary) {
    scroll-margin-top: -6rem;
  }

  .top-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--top-h);
  }

  /* in the serif of the hero name; hidden while that big name is on screen (script), so
     the name doesn't show twice in the first screen */
  .top-name {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s, visibility 0.2s;
  }

  :global(html.js) .top.is-hero .top-name {
    opacity: 0;
    visibility: hidden;
  }

  /* phones: the sections sit in the small menu below (four links do not fit the bar) */
  .top-nav {
    display: none;
  }

  .top-menu {
    position: relative;
    margin-left: auto;
  }

  .top-menu summary {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .top-menu summary::-webkit-details-marker {
    display: none;
  }

  /* a small chevron that turns when open */
  .top-menu summary::after {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    margin-top: -0.2rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.15s;
  }

  .top-menu[open] summary::after {
    margin-top: 0.15rem;
    transform: rotate(225deg);
  }

  .top-menu ul {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    min-width: 12rem;
    padding: 0.4rem 0;
    background: var(--paper);
    border: 1.5px solid var(--ink);
  }

  .top-menu a {
    display: block;
    padding: 0.65rem 1rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .top-menu a:hover,
  .top-menu a:focus-visible {
    background: var(--wash);
  }

  .top-menu-cv {
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
  }

  /* phones: the CV link lives in the menu */
  .top-cv {
    display: none;
  }

  .top-cv {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--steel);
    text-underline-offset: 0.2em;
    padding: 0.5rem 0;
    white-space: nowrap;
  }

  .top-cv:hover {
    text-decoration-thickness: 3px;
    text-decoration-color: var(--ink);
  }

  /* one page: the bar stays (sticky) on every size, so the section links are always there */
  @media (min-width: 64rem) {
    .top-in {
      min-height: 3.75rem;
    }

    .top-name {
      font-size: 1.5rem;
    }

    .top-nav {
      display: block;
      margin-left: auto;
    }

    .top-menu {
      display: none;
    }

    .top-cv {
      display: inline;
    }

    .top-nav ul {
      display: flex;
      gap: 2rem;
    }

    .top-nav a {
      display: block;
      padding: 0.4rem 0;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink-2);
      text-decoration: none;
      border-bottom: 3px solid transparent;
    }

    .top-nav a:hover {
      color: var(--ink);
      border-bottom-color: var(--line);
    }

    /* the section in view: ink and the bar (no bolder weight, that would reflow the row); the
       bar is one of the two spectrum sprinkles (global.css --spectrum) */
    .top-nav a[aria-current="true"] {
      color: var(--ink);
      border-image: var(--spectrum) 1;
    }

    .top-cv {
      margin-left: 1rem;
      padding-left: 2rem;
      border-left: 1.5px solid var(--line);
      line-height: 1.2;
    }
  }
</style>
