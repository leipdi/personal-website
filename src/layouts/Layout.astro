---
import { nav, cvPdf } from "../data/nav";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ebebf5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap"
    />
  </head>
  <body id="top">
    <a href="#inhalt" class="skip">Zum Inhalt springen</a>
    <!-- the day behind the page: its colour, two light spots and the grain (global.css .light) -->
    <div class="light" aria-hidden="true"><i data-light></i><i data-light></i></div>



    <header class="top is-hero">
      <div class="wrap top-in">
        <a href="#top" class="top-name">Daniel Lenski</a>
        <nav class="top-nav" aria-label="Hauptnavigation">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} data-nav={n.id}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <!-- phones: the sections and the CV behind one small menu (the bar has no room) -->
        <details class="top-menu" data-menu>
          <summary>Menü</summary>
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href}>{n.label}</a>
                </li>
              ))
            }
            <li class="top-menu-cv">
              <a href={cvPdf} target="_blank" rel="noreferrer">Lebenslauf (PDF)</a>
            </li>
          </ul>
        </details>
        <a href={cvPdf} target="_blank" rel="noreferrer" class="top-cv">Lebenslauf (PDF)</a>
      </div>
    </header>

    <main id="inhalt" class="content" tabindex="-1">
      <slot />
    </main>

    <script>
      // A day while scrolling (owner 2026-10-09, colour mockups "A + C"): each section has the
      // light of one time of day, dawn at the hero to dusk at Kontakt. The page colour (--bg,
      // so the top bar, the pinned chart and every label backing follow it) blends from one
      // section's colour to the next across a window height around their border; two soft light
      // spots (.light) take the colours of that hour and drift slowly with the scroll (not with
      // reduced motion). The colours keep --ink-2/--ink-3 at 4.5:1 or more, the spots included
      // (their strength is capped for that).
      // Retuned after a blunt critique: the arc must read (dawn and sunset were the same peach,
      // noon the dullest stop), and a spot never sits on the opposite side of the colour wheel
      // from its background (blue on peach mixed to grey mud). Dawn is a cool pale sky with the
      // warm light only low at the horizon, so the hero's sun stays the brightest warm thing;
      // noon has the day's whitest light; sunset is the deepest, hottest stop; dusk ends with a
      // last glow at the horizon.
      {
        const DAY: { sel: string; bg: string; a: string; b: string; k: number; pa: number[]; pb: number[] }[] = [
          // pa/pb: the spots' centres in % of the window (x, y)
          { sel: ".hero", bg: "#ebebf5", a: "#ffc8a2", b: "#f3d0e4", k: 1, pa: [45, 104], pb: [96, 6] },
          { sel: "#kompetenzen", bg: "#d9e8fb", a: "#a8cdfa", b: "#c4ecf0", k: 0.9, pa: [10, 30], pb: [90, 80] },
          { sel: "#werdegang", bg: "#e6f1fc", a: "#fff6d8", b: "#ffffff", k: 0.7, pa: [78, 22], pb: [15, 85] },
          { sel: "#kenntnisse", bg: "#fbeac4", a: "#ffc46b", b: "#ffad90", k: 0.9, pa: [85, 30], pb: [15, 85] },
          { sel: "#hobbys", bg: "#ffcdb5", a: "#ffae94", b: "#ffb3c7", k: 0.9, pa: [20, 25], pb: [85, 75] },
          { sel: "#kontakt", bg: "#e2d9f3", a: "#ffc0a8", b: "#c9b8f2", k: 0.8, pa: [70, 104], pb: [10, 20] },
        ];
        const STRENGTH = 0.35; // the spots' peak opacity (see the contrast note above)
        const els = DAY.map((d) => document.querySelector<HTMLElement>(d.sel));
        const spots = [...document.querySelectorAll<HTMLElement>("[data-light]")];
        const still = matchMedia("(prefers-reduced-motion: reduce)");
        const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
        const lerp = (a: number[], b: number[], t: number) => a.map((v, i) => v + (b[i] - v) * t);
        const rgb = (c: number[]) => `rgb(${c.map(Math.round).join(" ")})`;
        const root = document.documentElement;
        let lastBg = "";
        let raf = 0;
        let tops: number[] = [];
        let pageH = 0;
        const measure = () => {
          tops = els.map((el) => (el ? el.getBoundingClientRect().top + scrollY : Infinity));
          paint();
        };
        const paint = () => {
          // sections change height after load (the pile, the Werdegang padding): re-measure when
          // the page height changed. (Not with a ResizeObserver on the body: its callback's
          // layout reads made the Werdegang text jump a frame, npm run qa caught it.)
          const h = document.documentElement.scrollHeight;
          if (h !== pageH) {
            pageH = h;
            tops = els.map((el) => (el ? el.getBoundingClientRect().top + scrollY : Infinity));
          }
          // where we are: a line that runs from the window's top (page start) to its bottom (page
          // end), the middle in between, so the short first and last sections reach their own
          // colour too; a blend across one window height per border
          const max = Math.max(h - innerHeight, 1);
          const y = scrollY + innerHeight * Math.min(Math.max(scrollY / max, 0), 1);
          const z = innerHeight / 2;
          let i = 0;
          for (let j = 1; j < tops.length; j++) if (y >= tops[j] - z) i = j;
          // i = the section we're in or blending into; t = how far into it
          const t = i === 0 ? 1 : Math.min(Math.max((y - (tops[i] - z)) / (2 * z), 0), 1);
          const s = t * t * (3 - 2 * t);
          const p = DAY[Math.max(i - 1, 0)];
          const q = DAY[i];
          const bg = rgb(lerp(hex(p.bg), hex(q.bg), s));
          if (bg !== lastBg) {
            root.style.setProperty("--bg", bg);
            lastBg = bg;
          }
          const k = (p.k + (q.k - p.k) * s) * STRENGTH;
          // the drift: within a section the spots travel a little with the scroll
          const into = still.matches ? 0 : Math.min(Math.max((y - tops[i]) / innerHeight, -1), 2);
          [
            [p.a, q.a, p.pa, q.pa],
            [p.b, q.b, p.pb, q.pb],
          ].forEach(([c0, c1, p0, p1], n) => {
            const el = spots[n];
            if (!el) return;
            const cv = lerp(hex(c0 as string), hex(c1 as string), s).map(Math.round).join(" ");
            const at = (a: number) => `rgb(${cv} / ${a})`;
            const pos = lerp(p0 as number[], p1 as number[], s);
            const dx = (n ? -1 : 1) * into * 4;
            const dy = -into * 6;
            // (the spot's size, 80vmax, without reading layout)
            const w = 0.8 * Math.max(innerWidth, innerHeight);
            // (eased stops: a plain two-stop falloff showed rings on the wide, pale spots)
            el.style.background = `radial-gradient(closest-side, ${at(1)}, ${at(0.82)} 22%, ${at(0.5)} 48%, ${at(0.2)} 72%, ${at(0)})`;
            el.style.opacity = k.toFixed(3);
            el.style.transform = `translate(${((innerWidth * (pos[0] + dx)) / 100 - w / 2).toFixed(0)}px, ${((innerHeight * (pos[1] + dy)) / 100 - w / 2).toFixed(0)}px)`;
          });
        };
        addEventListener(
          "scroll",
          () => {
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(paint);
          },
          { passive: true },
        );
        addEventListener("resize", measure);
        document.fonts?.ready.then(measure);
        addEventListener("load", measure);
        measure();
      }

      // the section in view gets the ink bar in the top bar: the last section whose top has
      // passed a line a third of the way down the window (by position, not by the section
      // boxes, so content pushed past a section's box still counts as that section)
      const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")];
      const secs = links.map((a) => document.getElementById(a.dataset.nav!));
      let raf = 0;
      const mark = () => {
        const line = innerHeight / 3;
        let cur = -1;
        secs.forEach((el, i) => {
          if (el && el.getBoundingClientRect().top <= line) cur = i;
        });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) cur = secs.length - 1;
        links.forEach((a, i) => (i === cur ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      addEventListener(
        "scroll",
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(mark);
        },
        { passive: true },
      );
      addEventListener("resize", mark);
      mark();

      // the phone menu closes when a section is picked, on Escape, or on a tap elsewhere
      const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
      if (menu) {
        menu.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("a")) menu.open = false;
        });
        document.addEventListener("click", (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && menu.open) {
            menu.open = false;
            menu.querySelector("summary")?.focus();
          }
        });
        // also when focus leaves it, or the page scrolls on (it would cover the pinned chart)
        menu.addEventListener("focusout", (e) => {
          if (!menu.contains(e.relatedTarget as Node | null)) menu.open = false;
        });
        let openY = 0;
        menu.addEventListener("toggle", () => (openY = scrollY));
        addEventListener(
          "scroll",
          () => {
            if (menu.open && Math.abs(scrollY - openY) > 40) menu.open = false;
          },
          { passive: true },
        );
      }

      // the bar's name stays hidden while the hero's big name is on screen; the bar starts
      // hidden (class in the markup, only with JS), so the name doesn't flash twice on load
      const top = document.querySelector<HTMLElement>(".top");
      const heroName = document.getElementById("name");
      if (top && heroName) {
        // (the last entry: after Back one batch can hold a stale "visible" before the real state)
        new IntersectionObserver((es) => top.classList.toggle("is-hero", es[es.length - 1].isIntersecting), {
          rootMargin: `-${top.offsetHeight}px 0px 0px 0px`,
        }).observe(heroName);
      } else top?.classList.remove("is-hero");
    </script>
  </body>
</html>


<style>
  /* fixed, so focusing it doesn't scroll the page to the top */
  .skip {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 0.75rem;
  }
  .skip:focus {
    top: 1rem;
  }

  /* the skip link moves focus to main (tabindex -1); no ring around the whole page */
  .content:focus {
    outline: none;
  }



  /* ---------- top bar: the page's own steel paper, closed by one ink rule ---------- */
  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    /* the day shows through, blurred (the light spots would end at a flat band otherwise) */
    /* (92 %: at 80 % the blur showed content passing under it as smudges) */
    background: var(--grain), color-mix(in srgb, var(--bg) 92%, transparent);
    background-blend-mode: soft-light, normal;
    /* (the grain fixed to the window, so it lines up with the page grain behind) */
    background-attachment: fixed, scroll;
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1.5px solid var(--ink);
  }

  /* The bar sits inside the page's top scroll padding, so the browser took its own links as
     hidden and scrolled the page up to reveal them on keyboard focus. A negative scroll
     margin puts their scroll area below the padding: focus in the bar never moves the page. */
  .top :global(a),
  .top :global(summary) {
    scroll-margin-top: -6rem;
  }

  .top-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--top-h);
  }

  /* in the serif of the hero name; hidden while that big name is on screen (script), so
     the name doesn't show twice in the first screen */
  .top-name {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s, visibility 0.2s;
  }

  :global(html.js) .top.is-hero .top-name {
    opacity: 0;
    visibility: hidden;
  }

  /* phones: the sections sit in the small menu below (four links do not fit the bar) */
  .top-nav {
    display: none;
  }

  .top-menu {
    position: relative;
    margin-left: auto;
  }

  .top-menu summary {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .top-menu summary::-webkit-details-marker {
    display: none;
  }

  /* a small chevron that turns when open */
  .top-menu summary::after {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    margin-top: -0.2rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.15s;
  }

  .top-menu[open] summary::after {
    margin-top: 0.15rem;
    transform: rotate(225deg);
  }

  .top-menu ul {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    min-width: 12rem;
    padding: 0.4rem 0;
    background: var(--paper);
    border: 1.5px solid var(--ink);
  }

  .top-menu a {
    display: block;
    padding: 0.65rem 1rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .top-menu a:hover,
  .top-menu a:focus-visible {
    background: var(--wash);
  }

  .top-menu-cv {
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
  }

  /* phones: the CV link lives in the menu */
  .top-cv {
    display: none;
  }

  .top-cv {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--steel);
    text-underline-offset: 0.2em;
    padding: 0.5rem 0;
    white-space: nowrap;
  }

  .top-cv:hover {
    text-decoration-thickness: 3px;
    text-decoration-color: var(--ink);
  }

  /* one page: the bar stays (sticky) on every size, so the section links are always there */
  @media (min-width: 64rem) {
    .top-in {
      min-height: 3.75rem;
    }

    .top-name {
      font-size: 1.5rem;
    }

    .top-nav {
      display: block;
      margin-left: auto;
    }

    .top-menu {
      display: none;
    }

    .top-cv {
      display: inline;
    }

    .top-nav ul {
      display: flex;
      gap: 2rem;
    }

    .top-nav a {
      display: block;
      padding: 0.4rem 0;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink-2);
      text-decoration: none;
      border-bottom: 3px solid transparent;
    }

    .top-nav a:hover {
      color: var(--ink);
      border-bottom-color: var(--line);
    }

    /* the section in view: ink and the bar (no bolder weight, that would reflow the row); the
       bar is one of the two spectrum sprinkles (global.css --spectrum) */
    .top-nav a[aria-current="true"] {
      color: var(--ink);
      border-image: var(--spectrum) 1;
    }

    .top-cv {
      margin-left: 1rem;
      padding-left: 2rem;
      border-left: 1.5px solid var(--line);
      line-height: 1.2;
    }
  }
</style>
