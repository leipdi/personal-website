---
import { nav, cvPdf } from "../data/nav";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f6f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap"
    />
  </head>
  <body id="top">
    <a href="#inhalt" class="skip">Zum Inhalt springen</a>

    <!-- remove once every Placeholder / ImagePlaceholder is replaced -->
    <p class="draft-note">
      Entwurf: Magenta markierte Stellen sind KI-Platzhalter (Texte, Daten, Bildideen) und werden noch ersetzt.
    </p>

    <header class="top">
      <div class="wrap top-in">
        <a href="#top" class="top-name">Daniel Lenski</a>
        <nav class="top-nav" aria-label="Hauptnavigation">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} data-nav={n.id}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a href={cvPdf} target="_blank" rel="noreferrer" class="top-cv">Lebenslauf (PDF)</a>
      </div>
    </header>

    <main id="inhalt" class="content">
      <slot />
    </main>

    <script>
      // the section in view gets the ink bar in the top bar: the last section whose top has
      // passed a line a third of the way down the window (by position, not by the section
      // boxes, so content pushed past a section's box still counts as that section)
      const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")];
      const secs = links.map((a) => document.getElementById(a.dataset.nav!));
      let raf = 0;
      const mark = () => {
        const line = innerHeight / 3;
        let cur = -1;
        secs.forEach((el, i) => {
          if (el && el.getBoundingClientRect().top <= line) cur = i;
        });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) cur = secs.length - 1;
        links.forEach((a, i) => (i === cur ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      addEventListener(
        "scroll",
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(mark);
        },
        { passive: true },
      );
      addEventListener("resize", mark);
      mark();
    </script>
  </body>
</html>


<style>
  .draft-note {
    background: var(--ph);
    color: #fff;
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: 0.4rem 1.25rem;
    text-align: center;
  }

  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 0.75rem;
  }
  .skip:focus {
    top: 1rem;
  }



  /* ---------- top bar: the page's own steel paper, closed by one ink rule ---------- */
  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1.5px solid var(--ink);
  }

  .top-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--top-h);
  }

  .top-name {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  /* phones: just the name and the CV; the page is one scroll */
  .top-nav {
    display: none;
  }

  .top-cv {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--steel);
    text-underline-offset: 0.2em;
    padding: 0.5rem 0;
    white-space: nowrap;
  }

  .top-cv:hover {
    text-decoration-thickness: 3px;
    text-decoration-color: var(--ink);
  }

  @media (min-width: 64rem) {
    .top {
      position: static;
    }

    .top-in {
      min-height: 4.25rem;
    }

    .top-name {
      font-size: 1.5rem;
    }

    .top-nav {
      display: block;
      margin-left: auto;
    }

    .top-nav ul {
      display: flex;
      gap: 2rem;
    }

    .top-nav a {
      display: block;
      padding: 0.4rem 0;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink-2);
      text-decoration: none;
      border-bottom: 3px solid transparent;
    }

    .top-nav a:hover {
      color: var(--ink);
      border-bottom-color: var(--line);
    }

    /* the section in view: ink and the bar (no bolder weight, that would reflow the row) */
    .top-nav a[aria-current="true"] {
      color: var(--ink);
      border-bottom-color: var(--ink);
    }

    .top-cv {
      margin-left: 1rem;
      padding-left: 2rem;
      border-left: 1.5px solid var(--line);
      line-height: 1.2;
    }
  }
</style>
