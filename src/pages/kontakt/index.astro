---
import Layout from "../../layouts/Layout.astro";
import { profile, notes } from "../../data/cv";
import { cvPdf } from "../../data/nav";

const [user, domain] = profile.email.split("@");
// break only after "linkedin.com/in/", never inside the handle (it has hyphens)
const liCut = profile.linkedin.lastIndexOf("/") + 1;
const liHost = profile.linkedin.slice(0, liCut);
const liPath = profile.linkedin.slice(liCut);
---

<Layout
  title="Kontakt, Daniel Lenski"
  description="Kontaktmöglichkeiten und Lebenslauf von Daniel Lenski."
  active="kontakt"
>
  <div class="wrap page">
    <h1 class="sr-only">Kontakt</h1>

    <a class="display mail" href={`mailto:${profile.email}`}>
      {user}<wbr />@{domain}
    </a>

    <div class="card-row">
      <!-- a letterhead, not a form: the details speak for themselves without labels -->
      <address class="text letterhead">
        <strong>{profile.name}</strong>
        <span>{profile.role}</span>
        <span>{profile.location}</span>
        <a class="prose-link tnum" href={`tel:${profile.phone.replace(/\s/g, "")}`}>{profile.phone}</a>
        <a class="prose-link" href={profile.linkedinUrl} target="_blank" rel="noreferrer"
          >{liHost}<wbr /><span class="nobr">{liPath}</span></a
        >
        <a class="cv" href={cvPdf} target="_blank" rel="noreferrer">Lebenslauf als PDF</a>
      </address>

      <section class="off" aria-labelledby="h-off">
        <h2 id="h-off" class="h2">Neben dem Job</h2>
        <div class="text">
          {notes.map((n) => <p>{n}</p>)}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .page {
    padding-top: 2.5rem;
  }

  @media (min-width: 64rem) {
    .page {
      padding-top: 5rem;
    }
  }

  .mail {
    display: inline-block;
    font-size: clamp(2.25rem, 0.9rem + 5.6vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--navy);
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.1em;
    text-decoration-color: var(--sky);
    overflow-wrap: anywhere;
  }

  .mail:hover {
    text-decoration-color: var(--navy);
  }

  .card-row {
    margin-top: 3rem;
    display: grid;
    gap: 3.5rem;
  }

  @media (min-width: 56rem) {
    .card-row {
      margin-top: 4.5rem;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
    }
  }

  .letterhead {
    font-style: normal;
    display: grid;
    justify-items: start;
    gap: 0.15rem;
  }

  .letterhead strong {
    font-family: var(--sans);
    font-size: 1.25rem;
  }

  .nobr {
    white-space: nowrap;
  }

  .cv {
    margin-top: 1.5rem;
    font-family: var(--sans);
    font-size: 1rem;
    background: var(--navy);
    color: var(--paper);
    padding: 0.8rem 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .cv:hover {
    background: var(--ink-sky);
  }

  .h2 {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .off .text {
    margin-top: 0.5rem;
  }

  .off p + p {
    margin-top: 0.75rem;
  }
</style>
