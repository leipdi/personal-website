---
import Layout from "../../layouts/Layout.astro";
import AmModel from "../../components/figures/AmModel.astro";
import Heliostat from "../../components/figures/Heliostat.astro";
import Placeholder from "../../components/Placeholder.astro";
import ImagePlaceholder from "../../components/ImagePlaceholder.astro";
import { projects } from "../../data/cv";

// Where a real picture would help; shown as marked placeholders until the owner has them.
const pictures: Record<string, { label: string; note?: string }> = {
  luftfahrt: {
    label: "Das untersuchte 3D-gedruckte Bauteil, als Foto oder CAD-Rendering",
    note: "falls die Masterarbeit ein Beispielbauteil zeigt",
  },
  heliostat: { label: "Heliostatfeld am DLR in Jülich oder CAD-Modell der Stahlkonstruktion" },
  "bi-consulting": {
    label: "Ausschnitt eines Berichts aus Power BI oder Jedox",
    note: "anonymisiert, ohne Kundendaten",
  },
};

const featured = projects.filter((p) => p.figure);
const smaller = projects.filter((p) => !p.figure);
---

<Layout
  title="Projekte, Daniel Lenski"
  description="Abschlussarbeiten und Praxisprojekte: Ökobilanz additiver Fertigung, Heliostat-Kosten, BI Consulting."
  active="projekte"
>
  <div class="wrap page-head">
    <h1 class="display page-title">Projekte</h1>
  </div>

  {
    featured.map((p, i) => (
      <article
        class:list={["essay", i % 2 === 1 && "essay-wash"]}
        id={p.slug}
        aria-labelledby={`t-${p.slug}`}
      >
        <div class="wrap">
          <h2 id={`t-${p.slug}`} class="etitle">
            <Placeholder inline>{p.title}</Placeholder>
          </h2>
          <p class="byline">
            {p.org}, {p.period}
          </p>

          <div class:list={["essay-body", "has-aside", p.figure !== "am-model" && "aside-spans"]}>
            <div class="prose">
              <Placeholder>
                <p class="text">{p.context}</p>
                <p class="text">{p.approach}</p>
              </Placeholder>
            </div>
            <div class="aside">
              {p.figure === "heliostat" && (
                <Placeholder kind="data" note="KI-Skizze, besser durch echtes Bild ersetzen">
                  <Heliostat />
                </Placeholder>
              )}
              {pictures[p.slug] && <ImagePlaceholder {...pictures[p.slug]} />}
            </div>
            {p.figure === "am-model" && (
              <div class="full">
                <Placeholder kind="data" note="Rechenmodell mit gerundeten Literaturwerten, Texte und Fälle">
                  <AmModel />
                </Placeholder>
              </div>
            )}
            <div class="prose">
              <Placeholder>
                <p class="text result">
                  <strong>Ergebnis.</strong> {p.result}
                </p>
              </Placeholder>
            </div>
            {p.link && (
              <p class="link">
                <a class="prose-link" href={p.link.href} target="_blank" rel="noreferrer">
                  {p.link.label}
                </a>
              </p>
            )}
          </div>
        </div>
      </article>
    ))
  }

  <section class="wrap practice" aria-labelledby="h-praxis">
    <h2 id="h-praxis" class="h2">Aus der Praxis</h2>
    <div class="practice-grid">
      {
        smaller.map((p) => (
          <article id={p.slug} aria-labelledby={`t-${p.slug}`}>
            <h3 id={`t-${p.slug}`} class="ptitle">
              <Placeholder inline>{p.title}</Placeholder>
            </h3>
            <p class="byline">
              {p.org}, {p.period}
            </p>
            <Placeholder>
              <div class="text small">
                <p>{p.context}</p>
                <p>{p.approach}</p>
                <p>{p.result}</p>
              </div>
            </Placeholder>
            {pictures[p.slug] && (
              <div class="practice-pic">
                <ImagePlaceholder {...pictures[p.slug]} ratio="16 / 9" />
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding-top: 2.5rem;
  }

  .essay {
    padding: 3rem 0 3.5rem;
  }

  .essay-wash {
    background: var(--sky-wash);
  }

  @media (min-width: 64rem) {
    .page-head {
      padding-top: 4rem;
    }
    .essay {
      padding: 4.5rem 0 5rem;
    }
  }

  /* essay titles in the text face: the condensed cut is kept for page titles only */
  .etitle {
    font-family: var(--serif);
    font-weight: 600;
    font-optical-sizing: auto;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }

  /* byline after the title, like an article, not an eyebrow above it */
  .byline {
    margin-top: 0.6rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--ink-2);
  }

  .essay-body {
    margin-top: 2rem;
    display: grid;
    row-gap: 1.1rem;
  }

  .essay-body > * {
    max-width: var(--measure);
  }

  .essay-body > .full {
    max-width: none;
    margin: 1.5rem 0;
  }

  .prose p + p {
    margin-top: 1.1rem;
  }

  .aside {
    margin: 0.5rem 0;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .practice-pic {
    margin-top: 1.25rem;
  }

  /* wide screens: the explanatory figure sits beside the text instead of interrupting it.
     Only from 75rem, below that the side column is too narrow for legible labels. */
  @media (min-width: 75rem) {
    .has-aside {
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
      column-gap: 4rem;
      align-content: start;
    }
    .has-aside > .prose,
    .has-aside > .link {
      grid-column: 1;
    }
    .has-aside > .aside {
      grid-column: 2;
      grid-row: 1;
      margin: 0;
    }
    .has-aside > .full {
      grid-column: 1 / -1;
    }
    /* No full-width figure in between: the aside runs beside all the prose rows. The last
       row is 1fr, so if the aside is taller the extra height ends up below the text instead
       of opening a gap before "Ergebnis". */
    .aside-spans {
      grid-template-rows: auto auto minmax(0, 1fr);
    }
    .aside-spans > .aside {
      grid-row: 1 / 4;
    }
  }

  .result {
    font-size: 1.3125rem;
    line-height: 1.45;
  }

  .result strong {
    font-family: var(--sans);
    font-size: 0.85em;
  }

  .practice {
    padding-top: 4rem;
  }

  .h2 {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .practice-grid {
    margin-top: 1.75rem;
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48rem) {
    .practice-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .ptitle {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .practice .byline {
    margin-top: 0.3rem;
    font-size: 1rem;
  }

  .small {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
  }

  .small p + p {
    margin-top: 0.6rem;
  }
</style>
