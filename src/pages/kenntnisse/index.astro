---
import Layout from "../../layouts/Layout.astro";
import Placeholder from "../../components/Placeholder.astro";
import { ratedSkills, competencies, otherCompetencies, certifications, topSkills } from "../../data/cv";

// Ledger: the CV's own words are the scale, strongest first, so nothing is drawn that the
// CV doesn't say. The skills are what matters and are set large; the level word is the
// small row head.
const byLevel = (group: string) => {
  const rows = new Map<string, { level: number; names: string[] }>();
  for (const s of ratedSkills.filter((s) => s.group === group)) {
    const row = rows.get(s.levelLabel) ?? { level: s.level, names: [] };
    row.names.push(s.name);
    rows.set(s.levelLabel, row);
  }
  return [...rows.entries()].sort((a, b) => b[1].level - a[1].level);
};

const software = byLevel("Software & BI");
const languages = byLevel("Sprachen");
---

<Layout
  title="Kenntnisse, Daniel Lenski"
  description="Software- und Sprachkenntnisse in eigener Einschätzung, Kernkompetenzen mit Beleg, Zertifikate."
  active="kenntnisse"
>
  <div class="wrap page">
    <h1 class="display page-title">Kenntnisse</h1>

    <div class="ledger">
      <section aria-labelledby="k-sw">
        <h2 id="k-sw" class="h2">Software</h2>
        <dl class="levels">
          {
            software.map(([label, row]) => (
              <div>
                <dt>{label}</dt>
                <dd>{row.names.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="k-lang">
        <h2 id="k-lang" class="h2">Sprachen</h2>
        <dl class="levels">
          {
            languages.map(([label, row]) => (
              <div>
                <dt>{label}</dt>
                <dd>{row.names.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="wide" aria-labelledby="k-meth">
        <h2 id="k-meth" class="h2">Kernkompetenzen und wo sie herkommen</h2>
        <Placeholder kind="vorschlag" note="Kompetenzen wie auf der Startseite, Zuordnung von CV-Methoden und Stationen">
          <dl class="pairs">
            {
              topSkills.map((sk) => {
                const terms = competencies.filter((c) => c.skill === sk.id).map((c) => c.name);
                return (
                  <div>
                    <dt>
                      {sk.title}
                      {terms.length > 0 && <span class="terms">Im CV: {terms.join(", ")}</span>}
                    </dt>
                    <dd>
                      <ul class="where">
                        {sk.learned.map((l) => (
                          <li>
                            <a class="prose-link" href={l.href}>
                              {l.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                );
              })
            }
          </dl>
        </Placeholder>
        <p class="others">Außerdem: {otherCompetencies.join(", ")}.</p>
      </section>

      <section class="wide" aria-labelledby="k-cert">
        <h2 id="k-cert" class="h2">Zertifikate</h2>
        <dl class="pairs">
          {
            certifications.map((c) => (
              <div id={c.id}>
                <dt>
                  {c.name} <span class="tnum year">{c.date}</span>
                </dt>
                <dd>{c.authority}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</Layout>

<style>
  .page {
    padding-top: 2.5rem;
  }

  @media (min-width: 64rem) {
    .page {
      padding-top: 4rem;
    }
  }

  /* one column grid for everything: Software | Sprachen on top, and the two-column rows
     of the wide blocks use the same 3fr / 2fr split, so their second column lines up
     with the Sprachen column and every rule runs the same width */
  .ledger {
    --cols: minmax(0, 3fr) minmax(0, 2fr);
    --col-gap: 5rem;
    margin-top: 2.5rem;
    display: grid;
    gap: 3.5rem;
  }

  @media (min-width: 56rem) {
    .ledger {
      grid-template-columns: var(--cols);
      gap: 4rem var(--col-gap);
    }
    .wide {
      grid-column: 1 / -1;
    }
  }

  .h2 {
    font-size: 1.125rem;
    font-weight: 700;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--navy);
  }

  /* levels: small level word, large skill names */
  .levels > div {
    padding: 0.9rem 0 1rem;
    border-bottom: 1px solid var(--line);
  }

  .levels dt {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .levels dd {
    margin-top: 0.15rem;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.3;
  }

  @media (min-width: 40rem) {
    .levels > div {
      display: grid;
      grid-template-columns: 9.5rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: baseline;
    }
    .levels dd {
      margin-top: 0;
    }
  }

  /* name | where, name | issuer */
  .pairs > div {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .pairs dt {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.35;
  }

  .pairs dd {
    margin-top: 0.15rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .year {
    margin-left: 0.4rem;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  @media (min-width: 56rem) {
    .pairs > div {
      display: grid;
      grid-template-columns: var(--cols);
      column-gap: var(--col-gap);
      align-items: baseline;
    }
    .pairs dd {
      margin-top: 0;
    }
  }

  .terms {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .where li + li {
    margin-top: 0.15rem;
  }

  /* reached via a link from the home skill hub: mark the row it points to
     (a navy bar in the gutter, it doesn't shift the row) */
  .pairs > div {
    position: relative;
  }

  .pairs > div:target::before {
    content: "";
    position: absolute;
    left: -0.75rem;
    top: 0.6rem;
    bottom: 0.6rem;
    border-left: 4px solid var(--navy);
  }

  .others {
    margin-top: 1rem;
    color: var(--ink-2);
  }
</style>
