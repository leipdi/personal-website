---
import Layout from "../layouts/Layout.astro";
import Placeholder from "../components/Placeholder.astro";
import HeliostatField from "../components/figures/HeliostatField.astro";
import Werdegang from "../components/sections/Werdegang.astro";
import Kenntnisse from "../components/sections/Kenntnisse.astro";
import Kontakt from "../components/sections/Kontakt.astro";
import { profile, topSkills } from "../data/cv";
import { tool, uniqueSvg } from "../data/tools";

// Long German compounds get soft hyphens for display only (the data keeps the plain word),
// so a narrow box breaks "Bauteilkostenkalkulation" at a word joint instead of overflowing.
const titleBreaks: Record<string, string> = {
  Bauteilkostenkalkulation: "Bauteil­kosten­kalkulation",
};
const displayTitle = (t: string) => titleBreaks[t] ?? t;

// neutral and factual (name, role, fields named in the CV): the AI-drafted claim must not end up in search results
const description = `${profile.name}, ${profile.role}, ${profile.location}. Herstellkostenrechnung, Ökobilanz (LCA) und BI Consulting mit Power BI und Jedox.`;
---

<Layout title="Daniel Lenski, Wirtschaftsingenieur" description={description}>
  <section class="hero" aria-labelledby="name">
    <HeliostatField>
      <div class="wrap hero-text">
        <h1 id="name" class="hero-name">Daniel<br />Lenski</h1>
        <p class="hero-role">{profile.role}<br />{profile.location}</p>
        <p class="hero-claim">„{profile.claim}“</p>
        <div class="hero-photo">
          <img src="/img/daniel-lenski.jpg" alt="Porträt von Daniel Lenski" width="400" height="400" />
        </div>
      </div>
    </HeliostatField>
  </section>

  <!-- Kernkompetenzen: the four names as the heading (one per line), then one panel per skill. While
       scrolling, each panel pins and the next slides up over it (stacking cards); the covered
       one steps back. Panel: text on paper (title, proof lines, software, where it comes
       from, a link to the next) beside an uncovered photo in one steel treatment. -->
  <section id="kompetenzen" class="kk" aria-labelledby="h-kk">
    <div class="wrap">
      <h2 id="h-kk" class="kk-title">
        <span class="sr-only">Kernkompetenzen: </span>
        {
          topSkills.map((s, i) => (
            <>
              <a href={`#kk-${s.id}`}>{displayTitle(s.title)}</a>
              {i < topSkills.length - 1 && <span class="sr-only">, </span>}
            </>
          ))
        }
      </h2>
      <Placeholder
        kind="vorschlag"
        note="Belegzeilen und Zuordnung von Stationen und Software KI-abgeleitet; gestrichelte Logos sind Logo-Platzhalter; das Controlling-Bild ist ein Testbild"
      >
        <ol class="kk-stack" data-kk>
          {
            topSkills.map((s, i) => {
              const next = topSkills[i + 1];
              return (
                <li class="panel" id={`kk-${s.id}`} data-kk-panel aria-labelledby={`sk-${s.id}`}>
                  <div class="panel-in" data-kk-card>
                    <div class="panel-text">
                      <h3 id={`sk-${s.id}`} class="panel-title">
                        {displayTitle(s.title)}
                      </h3>
                      <ul class="text panel-proof">
                        {s.proof.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                      <div class="panel-meta">
                        {s.tools.length > 0 && (
                          <ul class="tools" aria-label="Software">
                            {s.tools.map((key) => {
                              const t = tool(key);
                              return t.svg ? (
                                <li class="tool">
                                  <span class="tool-logo" aria-hidden="true" set:html={uniqueSvg(t.svg, s.id)} />
                                  <span class="tool-name">{t.name}</span>
                                </li>
                              ) : (
                                <li class="tool tool-ph" data-placeholder="logo">
                                  <span class="tool-mono" aria-hidden="true">
                                    {t.mono}
                                  </span>
                                  <span class="tool-name">{t.name}</span>
                                  <span class="sr-only"> (Logo-Platzhalter)</span>
                                </li>
                              );
                            })}
                          </ul>
                        )}
                        {s.toolsQuestion && <p class="tools-open">{s.toolsQuestion}</p>}
                        <p class="skill-src">
                          <span class="lbl">Gelernt bei</span>{" "}
                          {s.learned.map((l, k) => (
                            <>
                              {k > 0 && ", "}
                              <a href={l.href}>{l.label}</a>
                            </>
                          ))}
                        </p>
                      </div>
                      <a class="panel-next" href={next ? `#kk-${next.id}` : "#werdegang"}>
                        <span>
                          Weiter: <span class="nobr">{next ? next.title : "Werdegang"}</span>
                        </span>
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                          <path d="M12 5v14m-6-6 6 6 6-6" />
                        </svg>
                      </a>
                    </div>
                    <div class="panel-photo">
                      {s.image ? (
                        <img src={s.image.src} alt="" width="500" height="333" loading="lazy" decoding="async" />
                      ) : (
                        <p class="panel-ph" data-placeholder="bild">
                          <strong>Bildplatzhalter</strong>
                          <span>{s.imageIdea}</span>
                        </p>
                      )}
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </Placeholder>
    </div>
  </section>

  <Werdegang />
  <Kenntnisse />
  <Kontakt />
</Layout>

<script>
  // Kernkompetenzen as stacking panels: each panel is sticky (CSS, JS only) and the next one
  // scrolls up over it. The script sets each panel's sticky top (the card pinned centred in
  // the space under the top bar; a card taller than that pins by its bottom edge, so none of
  // it is ever out of reach) and lets the covered card step back and fade out as the next
  // one comes up. Nothing moves with reduced motion.
  const stack = document.querySelector<HTMLElement>("[data-kk]");
  const panels = [...document.querySelectorAll<HTMLElement>("[data-kk-panel]")];
  if (stack && panels.length) {
    const cards = panels.map((p) => p.querySelector<HTMLElement>("[data-kk-card]")!);
    const topBar = document.querySelector<HTMLElement>(".top");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    let base = 0;
    let sticks: number[] = [];
    let heights: number[] = [];

    const layout = () => {
      // the sticky top bar on phones; static from 64rem
      base = topBar && getComputedStyle(topBar).position === "sticky" ? topBar.getBoundingClientRect().height : 0;
      const free = innerHeight - base;
      heights = panels.map((p) => p.offsetHeight);
      sticks = heights.map((h) => (h <= free ? base + (free - h) / 2 : innerHeight - h));
      // an anchor to a panel lands where it has just pinned (natural top at its sticky top),
      // not at the page's scroll padding, where the next card would already cover it
      const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      panels.forEach((p, i) => {
        p.style.setProperty("--stick", `${Math.round(sticks[i])}px`);
        p.style.scrollMarginTop = `${Math.max(0, Math.round(sticks[i] - pad))}px`;
      });
      update();
    };

    const natural = (i: number) =>
      stack.getBoundingClientRect().top + scrollY + heights.slice(0, i).reduce((a, h) => a + h, 0);

    // how far the next panel has come up over panel i: 0 when it meets i's bottom, 1 pinned
    const covered = (i: number) => {
      const next = panels[i + 1];
      if (!next) return 0;
      const from = sticks[i] + heights[i];
      const to = sticks[i + 1];
      const t = next.getBoundingClientRect().top;
      return Math.min(Math.max((from - t) / Math.max(from - to, 1), 0), 1);
    };

    const update = () => {
      cards.forEach((card, i) => {
        const k = reduce.matches ? 0 : covered(i);
        // the incoming card slides over an opaque card (like a sheet laid on top); it fades
        // over the last 40 %, so it is gone before its title strip is all that shows
        // (a half-transparent card cut by the incoming edge read as a rendering bug)
        const fade = Math.max((k - 0.6) / 0.4, 0);
        card.style.transform = k > 0 ? `scale(${(1 - 0.03 * k).toFixed(4)})` : "";
        card.style.opacity = k > 0 ? (1 - fade).toFixed(3) : "";
      });
    };

    // Focus in a card that a later one covers (Shift+Tab, or a link the browser thinks is
    // on screen because its panel is pinned): scroll back to where that panel has just
    // pinned and the next one still waits below it.
    // (keyboard focus only: a click or tap on a link focuses it too, and must be left to
    // scroll to its target)
    stack.addEventListener("focusin", (e) => {
      const el = e.target as HTMLElement;
      if (!el.matches(":focus-visible")) return;
      const p = el.closest<HTMLElement>("[data-kk-panel]");
      if (!p) return;
      const i = panels.indexOf(p);
      requestAnimationFrame(() => {
        const r = (e.target as HTMLElement).getBoundingClientRect();
        const next = panels[i + 1]?.getBoundingClientRect().top ?? Infinity;
        if (covered(i) === 0 && r.bottom <= next && r.top >= base) return;
        scrollTo({ top: natural(i) - sticks[i], behavior: "auto" });
      });
    });

    let raf = 0;
    addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(update);
      },
      { passive: true },
    );
    addEventListener("resize", layout);
    document.fonts?.ready.then(layout);
    new ResizeObserver(layout).observe(stack);
    layout();

    // a fresh visit to /#kk-…: the browser scrolled before the margins above existed
    // (a reload or Back restores its saved position instead, see Werdegang)
    const atLoad = panels.findIndex((p) => `#${p.id}` === location.hash);
    if (atLoad >= 0 && typeof history.state?.wdY !== "number") {
      document.fonts?.ready.then(() => {
        layout();
        scrollTo(0, natural(atLoad) - sticks[atLoad]);
      });
    }
  }
</script>


<style>
  /* ---------- hero: the heliostat field, name and role in its sky ---------- */
  .hero-text {
    padding-top: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }

  /* the name in the content serif (owner's pick 2026-10-01, the heavy grotesk read clunky) */
  .hero-name {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(3.5rem, 1.5rem + 9vw, 9rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-role {
    margin-top: 1rem;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .hero-claim {
    margin-top: 1.5rem;
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 24em;
    text-wrap: pretty;
  }

  /* The portrait in the same language as the Kernkompetenzen photos: a hard-edged square
     with the ink frame, greyscale multiplied onto the steel tone (a soft-masked colour
     circle read as an avatar). Phones: between the text and the field strip; wider: in
     the middle of the sky, between the text and the mirrors. */
  /* phones: top right, beside the name (between claim and field it pushed the field below
     the first screen) */
  .hero-photo {
    position: absolute;
    top: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    right: var(--gutter);
    isolation: isolate;
    width: min(6.5rem, 28vw);
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    border: 1.5px solid var(--ink);
    background: var(--steel-soft);
  }

  /* (the source JPEG has a light 1-2px column at its left edge: shifted out of the frame) */
  .hero-photo img {
    display: block;
    width: calc(100% + 3px);
    max-width: none;
    height: auto;
    margin-left: -3px;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
  }

  @media (min-width: 48rem) {
    /* the text stands on the ground line, like the field beside it */
    .hero-text {
      padding-bottom: 1.5rem;
    }
    /* ends left of the mirrors, which start at about 49% of the page width */
    .hero-claim {
      max-width: min(24em, calc(46vw - max(var(--gutter), (100vw - var(--wrap)) / 2)));
    }
    /* behind the field layer, so the pointer sun and its rays always draw over it */
    .hero-photo {
      z-index: -1;
      top: 50%;
      right: auto;
      left: 54%;
      width: clamp(10rem, 17vw, 16rem);
      transform: translate(-50%, -62%);
    }
  }

  /* 48-56rem: the role line and "Lenski" reach about 44% of the width */
  @media (min-width: 48rem) and (max-width: 55.99rem) {
    .hero-photo {
      left: 64%;
      width: 9rem;
    }
  }

  /* ---------- Kernkompetenzen: the names as heading, then stacking panels ---------- */
  .kk {
    /* no top rule: the field's ground line closes the hero */
    padding: 3rem 0 4rem;
  }

  @media (min-width: 48rem) {
    .kk {
      padding-top: 4rem;
    }
  }

  /* the four names are the heading, one per line: the content itself, each a link to its
     panel, underlined only on hover (four resting underlines read like a wiki paragraph) */
  .kk-title {
    margin-bottom: 2.5rem;
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: clamp(1.875rem, 1.2rem + 2.4vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .kk-title a {
    display: block;
    width: fit-content;
    max-width: 100%;
    color: var(--ink);
    text-decoration: none;
    text-underline-offset: 0.12em;
    hyphens: manual;
  }

  .kk-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--ink);
  }

  /* Without JS the panels simply follow each other. With JS each one is sticky at the
     top the script works out (--stick), and the next one slides up over it. */
  .kk-stack {
    display: grid;
    gap: 1.5rem;
  }

  :global(html.js) .kk-stack {
    gap: 0;
  }

  .panel {
    min-width: 0;
  }

  /* no background of its own: the incoming card itself slides over the pinned one */
  :global(html.js) .panel {
    position: sticky;
    top: var(--stick, 0px);
    padding: 0.75rem 0;
  }

  /* the card that steps back when the next panel covers it */
  .panel-in {
    display: grid;
    width: 100%;
    background: var(--paper);
    border: 1px solid var(--line);
    transform-origin: 50% 0;
    will-change: transform, opacity;
  }

  /* the edge of a card sliding up: the structure rule, not a shadow */
  :global(html.js) .panel-in {
    border-top: 1.5px solid var(--ink);
  }

  /* text on paper beside the uncovered photo (phones: photo on top) */
  .panel-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem 1.25rem 1.1rem;
  }

  .panel-photo {
    order: -1;
    position: relative;
    isolation: isolate;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--steel-soft);
    border-bottom: 1.5px solid var(--ink);
  }

  /* one treatment for every photo: greyscale, multiplied onto the steel tone, so four
     different pictures read as one set and stay inside the palette */
  .panel-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
  }

  /* no picture yet: magenta stripes with what it could show */
  .panel-ph {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.1rem;
    height: 100%;
    padding: 1rem;
    background: repeating-linear-gradient(135deg, #fbeaf4 0 10px, #fff 10px 20px);
    color: var(--ph);
    font-size: 0.8125rem;
    line-height: 1.35;
    text-align: center;
  }

  .panel-title {
    margin-bottom: 0.75rem;
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem);
    line-height: 1.1;
    color: var(--ink);
    hyphens: manual;
    overflow-wrap: anywhere;
  }

  .panel-proof {
    list-style: disc;
    padding-left: 1.15rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .panel-proof li + li {
    margin-top: 0.35rem;
  }

  .panel-proof li::marker {
    color: var(--ink-2);
  }

  /* software and where it comes from, folded into the text: small and left-aligned */
  .panel-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .panel-meta .tools {
    justify-content: flex-start;
    gap: 0.75rem 1rem;
  }

  .panel-meta .tools > li {
    flex: 0 0 auto;
    max-width: 6rem;
  }

  .panel-meta .tool {
    flex-direction: row;
    gap: 0.45rem;
    text-align: left;
  }

  /* single-colour logos: next to the grey photos the brand colours were the loudest thing
     in the section (the placeholder monograms keep their magenta) */
  .panel-meta .tool-logo {
    height: 1.75rem;
    filter: grayscale(1);
    opacity: 0.85;
  }

  .panel-meta .tool-mono {
    min-width: 1.75rem;
    height: 1.75rem;
    font-size: 0.6875rem;
  }

  .panel-meta .skill-src {
    padding-top: 0;
    border-top: 0;
    text-align: left;
  }

  /* the way on: a real link to the next panel (the last one leads to Werdegang) */
  .panel-next {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding: 0.35rem 0;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--steel);
    text-underline-offset: 0.2em;
  }

  .panel-next:hover {
    text-decoration-thickness: 3px;
    text-decoration-color: var(--ink);
  }

  .panel-next svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* small phones: keep "Bauteilkostenkalkulation" on one line */
  @media (max-width: 24.99rem) {
    .panel-title {
      font-size: 1.375rem;
    }
  }

  /* wide: text left (2 parts), photo right (3 parts), an ink rule between them */
  @media (min-width: 56rem) {
    .panel-in {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      min-height: min(26rem, calc(100svh - 6rem));
    }
    .panel-text {
      padding: 2.25rem 2.25rem 2rem;
    }
    .panel-photo {
      order: 0;
      aspect-ratio: auto;
      border-bottom: 0;
      border-left: 1.5px solid var(--ink);
    }
    .panel-proof {
      font-size: 1.125rem;
    }
  }

  .lbl {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  /* logos with their names centred in the box (owner, 2026-09-25) */
  .tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.1rem 0.5rem;
  }

  /* all logos of a box share one row (the fullest box set every footer's height
     through the subgrid when four logos wrapped to two rows) */
  .tools > li {
    flex: 1 1 0;
    min-width: 0;
    max-width: 6rem;
  }

  .tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    text-align: center;
  }

  .tool-name {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .tool-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    max-width: 100%;
  }

  .tool-logo :global(svg) {
    display: block;
    height: 100%;
    width: auto;
    max-width: 100%;
  }

  /* no free logo available: dashed magenta outline monogram = marked logo placeholder */
  .tool-mono {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.2rem;
    border: 1.5px dashed var(--ph);
    border-radius: 4px;
    color: var(--ph);
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .tools-open {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ph);
    background: var(--paper);
    border: 1.5px dashed var(--ph);
    border-radius: 3px;
    padding: 0.45rem 0.7rem;
    max-width: 30rem;
    overflow-wrap: anywhere;
  }

  .skill-src {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-2);
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .skill-src a:focus-visible {
    outline-offset: 1px;
  }

  .skill-src a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--steel);
  }

  .skill-src a:hover {
    color: var(--ink);
    text-decoration-thickness: 3px;
    text-decoration-color: var(--ink);
  }

</style>
