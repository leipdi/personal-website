---
import Layout from "../layouts/Layout.astro";
import Placeholder from "../components/Placeholder.astro";
import { profile, topSkills, type TopSkillId } from "../data/cv";
import { tool } from "../data/tools";
import { cvPdf } from "../data/nav";

// line icons for the box heads (24px grid, drawn at 28px with a 2px stroke)
const skillIcons: Record<TopSkillId, string> = {
  // calculator
  kosten:
    "M6 3h12a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm2 3h8v3H8V6Zm0 7h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01",
  // a data table feeding a report: plain, no AI sparkle trope
  data: "M3 4h11v16H3V4Zm0 5h11M3 14.5h11M8 9v11M17.5 20v-5M21 20V9",
  // two steps joined by a flow arrow
  prozesse: "M4 5h5v5H4V5Zm11 9h5v5h-5v-5ZM6.5 10v3a2 2 0 0 0 2 2H15m0 0-2-2m2 2-2 2",
  // bar chart on a baseline
  controlling: "M4 20h16M7 16v-5M11 16V8M15 16v-3M19 16V5",
};

// Long German compounds get soft hyphens for display only (the data keeps the plain word),
// so a narrow box breaks "Bauteilkostenkalkulation" at a word joint instead of overflowing.
const titleBreaks: Record<string, string> = {
  Bauteilkostenkalkulation: "Bauteil­kosten­kalkulation",
};
const displayTitle = (t: string) => titleBreaks[t] ?? t;

const [mailUser, mailDomain] = profile.email.split("@");
// neutral and factual (name, role, fields named in the CV): the AI-drafted claim must not end up in search results
const description = `${profile.name}, ${profile.role}, ${profile.location}. Herstellkostenrechnung, Ökobilanz (LCA) und BI Consulting mit Power BI und Jedox.`;
---

<Layout title="Daniel Lenski, Wirtschaftsingenieur" description={description} active="uebersicht">
  <section class="hero" aria-labelledby="name">
    <div class="wrap hero-in">
      <h1 id="name" class="display page-title hero-name">{profile.name}</h1>
      <p class="hero-role">{profile.role}, {profile.location}</p>
      <p class="hero-claim"><Placeholder inline>{profile.claim}</Placeholder></p>
      <div class="hero-photo">
        <img src="/img/daniel-lenski.jpg" alt="Porträt von Daniel Lenski" width="400" height="400" />
      </div>
    </div>
  </section>

  <!-- Skill hub: one box per core skill: what he did with it (proof), the software, where it comes from -->
  <section class="hub" aria-labelledby="h-hub">
    <div class="wrap">
      <h2 id="h-hub" class="display hub-title">Kernkompetenzen</h2>
      <Placeholder
        kind="vorschlag"
        note="Belegzeilen und Zuordnung von Stationen und Software KI-abgeleitet; gestrichelte Logos sind Logo-Platzhalter"
      >
        <ul class="hub-grid">
          {
            topSkills.map((s) => (
              <li class="skill" aria-labelledby={`sk-${s.id}`}>
                <div class="skill-body">
                  <div class="skill-head">
                    <svg
                      class="skill-ico"
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      width="28"
                      height="28"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={skillIcons[s.id]} />
                    </svg>
                    <h3 id={`sk-${s.id}`} class="display skill-title">
                      {displayTitle(s.title)}
                    </h3>
                  </div>
                  <div class="text skill-proof">
                    {s.proof.map((line) => (
                      <p>{line}</p>
                    ))}
                  </div>
                </div>
                <div class="skill-foot">
                  <p class="lbl" id={`sw-${s.id}`}>
                    Software
                  </p>
                  {s.tools.length > 0 && (
                    <ul class="tools">
                      {s.tools.map((key) => {
                        const t = tool(key);
                        return t.svg ? (
                          <li class:list={["tool", t.wordmark && "tool-wm"]}>
                            <span class="tool-logo" aria-hidden="true" set:html={t.svg} />
                            {t.wordmark ? <span class="sr-only">{t.name}</span> : t.name}
                          </li>
                        ) : (
                          <li class="tool tool-ph" data-placeholder="logo">
                            <span class="tool-mono" aria-hidden="true">
                              {t.mono}
                            </span>
                            {t.name}
                            <span class="sr-only"> (Logo-Platzhalter)</span>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                  {s.toolsQuestion && <p class="tools-open">{s.toolsQuestion}</p>}
                  <p class="skill-src">
                    <span class="lbl">Gelernt bei</span>{" "}
                    {s.learned.map((l, i) => (
                      <>
                        {i > 0 && ", "}
                        <a href={l.href}>{l.label}</a>
                      </>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </Placeholder>
    </div>
  </section>

  <section class="end" aria-labelledby="h-end">
    <div class="wrap end-in">
      <h2 id="h-end" class="end-line">
        Am einfachsten per <span class="nobr">E-Mail:</span>{" "}
        <a class="end-mail" href={`mailto:${profile.email}`}>{mailUser}<wbr />@{mailDomain}</a>
      </h2>
      <p class="end-links">
        <a class="prose-link" href={profile.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="prose-link" href={cvPdf} target="_blank" rel="noreferrer">Lebenslauf (PDF)</a>
        <a class="prose-link" href="/kontakt/">Alle Kontaktdaten</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ---------- hero: the portrait's own blue field. Name, role, claim; kept short so the
     first row of skills shows on the first screen ---------- */
  .hero {
    background: var(--sky);
  }

  /* phones: name and role full width, claim beside the (smaller) portrait */
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name name"
      "role role"
      "claim photo";
    column-gap: 1rem;
    padding-top: 1.75rem;
  }

  .hero-name {
    grid-area: name;
    font-size: clamp(3.25rem, 2rem + 5.5vw, 6rem);
    line-height: 0.9;
    color: var(--navy);
  }

  .hero-role {
    grid-area: role;
    margin-top: 0.6rem;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ink-sky);
  }

  .hero-claim {
    grid-area: claim;
    align-self: center;
    padding: 1.25rem 0 1.5rem;
    font-family: var(--serif);
    font-weight: 400;
    font-optical-sizing: auto;
    font-size: clamp(1.125rem, 0.9rem + 1.1vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 30em;
  }

  /* The portrait sits on the content grid, flush with the band's bottom edge, in a
     paper-white mat that joins the white page below. The mat gives it a deliberate
     edge, so the slightly different backdrop blue reads as a print, not a seam.
     Never wider than 260 CSS px: the source is 400px. */
  .hero-photo {
    grid-area: photo;
    justify-self: end;
    align-self: end;
    margin-top: 1.25rem;
    width: clamp(6.5rem, 30vw, 13rem);
    aspect-ratio: 1;
    box-sizing: content-box;
    border: 0.375rem solid var(--paper);
    border-bottom: 0;
    overflow: hidden;
  }

  /* the source JPEG has a light 1-2px column at its left edge: shift it out of the frame */
  .hero-photo img {
    display: block;
    width: calc(100% + 3px);
    max-width: none;
    height: auto;
    margin-left: -3px;
  }

  /* wider: the portrait gets its own column beside all three lines */
  @media (min-width: 48rem) {
    .hero-in {
      grid-template-areas:
        "name photo"
        "role photo"
        "claim photo";
      grid-template-rows: auto auto 1fr;
      column-gap: 3rem;
      padding-top: 2.75rem;
    }
    .hero-claim {
      align-self: start;
      padding: 1.5rem 0 2.5rem;
    }
    .hero-photo {
      margin-top: 0;
      border-width: 0.5rem;
      border-bottom: 0;
    }
  }

  /* ---------- skill hub: real boxes (owner request), drawn in the site's own language:
     paper-white page (the portrait's white mat joins it), square-ish boxes with a 1px rule
     border and a heavy navy top edge like the Kenntnisse section rules, no blur shadow.
     Each box = body (icon + title, proof) over a tinted footer (Software, Gelernt bei). ---------- */
  .hub {
    background: var(--paper);
    padding: 2rem 0 3.5rem;
  }

  .hub-title {
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    line-height: 1;
    color: var(--navy);
    margin-bottom: 1rem;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem 1.5rem;
  }

  @media (min-width: 44rem) {
    .hub-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* each box is a 2-row subgrid (body, footer): across a row the footers start at the same
     height, so a shorter proof shows as white space in the body above a level footer.
     minmax(0, 1fr): a long title can never widen the box past its grid cell */
  .skill {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 4px solid var(--navy);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-body {
    min-width: 0;
    padding: 1.1rem 1.1rem 1.25rem;
  }

  .skill-foot {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--sky-wash);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 44rem) {
    .skill-body {
      padding: 1.35rem 1.5rem 1.5rem;
    }
    .skill-foot {
      padding: 1.1rem 1.5rem 1.2rem;
    }
  }

  .skill-head {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }

  .skill-ico {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--navy);
  }

  /* only the soft hyphens set in the markup may break the title; overflow-wrap is the
     last resort for a future title without them */
  .skill-title {
    min-width: 0;
    font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2rem);
    line-height: 1;
    padding-top: 0.1rem;
    color: var(--navy);
    hyphens: manual;
    overflow-wrap: anywhere;
  }

  .skill-proof {
    font-size: 1.0625rem;
    line-height: 1.5;
    max-width: 36rem;
  }

  .skill-proof p + p {
    margin-top: 0.4rem;
  }

  .lbl {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  .skill-foot .lbl {
    margin-bottom: -0.35rem;
  }

  /* software: logo + name, no pill chrome; logos sized by height so a wordmark keeps its width */
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
  }

  .tool-logo {
    display: flex;
    align-items: center;
    height: 1.375rem;
  }

  .tool-logo :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }

  /* no free logo available: dashed magenta outline monogram = marked logo placeholder */
  .tool-mono {
    display: grid;
    place-items: center;
    min-width: 1.375rem;
    height: 1.375rem;
    padding: 0 0.15rem;
    border: 1.5px dashed var(--ph);
    border-radius: 3px;
    color: var(--ph);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  /* an open question for the owner, not a design element: scaffolding colour */
  .tools-open {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ph);
    background: var(--paper);
    border: 1.5px dashed var(--ph);
    border-radius: 3px;
    padding: 0.45rem 0.7rem;
    max-width: 30rem;
    overflow-wrap: anywhere;
  }

  /* quiet source line, not a stack of links */
  .skill-src {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-2);
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  /* inline links a space away from the label: a tight focus ring keeps neighbours readable */
  .skill-src a:focus-visible {
    outline-offset: 1px;
  }

  .skill-src a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--steel);
  }

  .skill-src a:hover {
    color: var(--navy);
    text-decoration-color: var(--navy);
  }

  /* ---------- ending: back to the sky field, one line to get in touch ---------- */
  /* the ending runs to the bottom of the page, so the home page drops the layout's
     bottom padding and the band itself keeps clear of the phone tab bar */
  :global(main.content#inhalt) {
    padding-bottom: 0;
  }

  .end {
    background: var(--sky);
    padding: 2.75rem 0 calc(2.25rem + 4.75rem + env(safe-area-inset-bottom));
  }

  @media (min-width: 64rem) {
    .end {
      padding: 3.5rem 0 3rem;
    }
  }

  .end-line {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    line-height: 1.25;
    max-width: 30ch;
  }

  .nobr {
    white-space: nowrap;
  }

  /* inline-block: the address moves to its own line as a whole and only breaks at the @ when even that is too narrow */
  .end-mail {
    display: inline-block;
    color: var(--navy);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }

  .end-mail:hover {
    text-decoration-thickness: 2px;
  }

  .end-links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  .end-links .prose-link {
    text-decoration-color: var(--ink-sky);
  }
</style>
