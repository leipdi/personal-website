---
import Layout from "../layouts/Layout.astro";
import Placeholder from "../components/Placeholder.astro";
import HeliostatField from "../components/figures/HeliostatField.astro";
import Werdegang from "../components/sections/Werdegang.astro";
import Kenntnisse from "../components/sections/Kenntnisse.astro";
import Hobbys from "../components/sections/Hobbys.astro";
import Kontakt from "../components/sections/Kontakt.astro";
import { profile, topSkills, type TopSkillId } from "../data/cv";
import { tool, uniqueSvg } from "../data/tools";

// Long German compounds get soft hyphens for display only (the data keeps the plain word),
// so a narrow box breaks "Bauteilkostenkalkulation" at a word joint instead of overflowing.
const titleBreaks: Record<string, string> = {
  Bauteilkostenkalkulation: "Bauteil­kosten­kalkulation",
};
const displayTitle = (t: string) => titleBreaks[t] ?? t;

// the card pictures: generated by the owner (AI, marked in the picture), cut from one sheet
const arts: Record<TopSkillId, { src: string; alt: string }> = {
  kosten: { src: "/img/kompetenzen/kosten.webp", alt: "Gezeichneter Heliostat zwischen Bauteilen, daneben Taschenrechner, Kalkulationsblatt und Münzstapel" },
  data: { src: "/img/kompetenzen/data.webp", alt: "Dokumente, ein Server und eine Tabelle fließen in einen Baustein und werden zu einem Balkendiagramm" },
  prozesse: { src: "/img/kompetenzen/prozesse.webp", alt: "Prozessdiagramm mit zwei Bahnen, einer Entscheidung und einer abgehakten Checkliste" },
  controlling: { src: "/img/kompetenzen/controlling.webp", alt: "Aufgeschlagenes Kassenbuch, Belegstapel, Balkendiagramm, Taschenrechner und Münzen" },
};

// neutral and factual (name, role, fields named in the CV): the AI-drafted claim must not end up in search results
const description = `${profile.name}, ${profile.role}, ${profile.location}. Herstellkostenrechnung, Ökobilanz (LCA) und BI Consulting mit Power BI und Jedox.`;

// the claim with its *marked* words in italics (odd parts of the split)
const claimParts = profile.claim.split(/\*(.+?)\*/);
---

<Layout title="Daniel Lenski, Wirtschaftsingenieur" description={description}>
  <section class="hero" aria-labelledby="name">
    <HeliostatField>
      <div class="wrap hero-text">
        <div class="hero-head">
          <h1 id="name" class="hero-name">Daniel<br />Lenski</h1>
          <div class="hero-photo">
            <img src="/img/daniel-lenski-cutout.png" alt="Porträt von Daniel Lenski" width="400" height="400" />
          </div>
        </div>
        <p class="hero-role">{profile.role}<br />{profile.location}</p>
        <p class="hero-claim">„{claimParts.map((part, i) => (i % 2 ? <em>{part}</em> : part))}“</p>
      </div>
    </HeliostatField>
  </section>

  <!-- Kernkompetenzen as a pile of sheets (owner 2026-10-08, "Blattstapel", after the stacked
       cards of anjaliagrawal.framer.website and devanshuchauhan.in): one sheet per skill, a
       title strip with "n / 4" on top, main points with sub-points | software and where it was
       learned, the picture on the right. While scrolling each sheet pins one strip lower than
       the last, so the covered ones stay as a pile of leaning title tabs above the open one. -->
  <section id="kompetenzen" class="kk" aria-labelledby="h-kk">
    <div class="wrap">
      <h2 id="h-kk" class="display page-title kk-head">Kern&shy;kompetenzen</h2>
      <Placeholder
        kind="vorschlag"
        note="Punkte, Unterpunkte und Zuordnung von Stationen und Software KI-abgeleitet; gestrichelte Logos sind Logo-Platzhalter"
      >
        <ol class="pile" data-kk>
          {
            topSkills.map((s, i) => (
              <li class="sheet" id={`kk-${s.id}`} data-kk-panel data-kk-card aria-labelledby={`sk-${s.id}`} style={`--i: ${i}`}>
                <div class="sheet-head">
                  <h3 id={`sk-${s.id}`} class="sheet-title">
                    <a href={`#kk-${s.id}`}>{displayTitle(s.title)}</a>
                  </h3>
                  <span class="sheet-of" aria-label={`${i + 1} von ${topSkills.length}`}>
                    {i + 1} / {topSkills.length}
                  </span>
                </div>
                <div class="sheet-text" data-kk-fade>
                  <ul class="proof">
                    {s.proof.map((p) => (
                      <li>
                        <span class="proof-main text">{p.text}</span>
                        {p.sub && (
                          <ul class="proof-sub">
                            {p.sub.map((line) => (
                              <li>{line}</li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="sheet-meta" data-kk-fade>
                  {s.tools.length > 0 && (
                    <div class="sw">
                      <p class="lbl" id={`sw-${s.id}`}>Software</p>
                      <ul class="tools" aria-labelledby={`sw-${s.id}`}>
                        {s.tools.map((key) => {
                          const t = tool(key);
                          return t.svg ? (
                            <li class="tool">
                              <span class="tool-logo" aria-hidden="true" set:html={uniqueSvg(t.svg, s.id)} />
                              <span class="tool-name">{t.name}</span>
                            </li>
                          ) : (
                            <li class="tool tool-ph" data-placeholder="logo">
                              <span class="tool-mono" aria-hidden="true">
                                {t.mono}
                              </span>
                              <span class="tool-name">{t.name}</span>
                              <span class="sr-only"> (Logo-Platzhalter)</span>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}
                  {s.toolsQuestion && <p class="tools-open">{s.toolsQuestion}</p>}
                </div>
                <div class="sheet-pic" data-kk-fade>
                  <img src={arts[s.id].src} alt={arts[s.id].alt} width="520" height="351" loading="lazy" decoding="async" />
                  <span class="ai-tag">Generiert mit KI</span>
                </div>
              </li>
            ))
          }
        </ol>
      </Placeholder>
    </div>
  </section>

  <Werdegang />
  <Kenntnisse />
  <Hobbys />
  <Kontakt />
</Layout>

<script>
  // Kernkompetenzen as a pile of sheets (from 56rem, with JS, where it fits): every sheet is
  // sticky one title strip lower than the one before, so a covered sheet keeps its strip in
  // view as a tab. All sheets get the tallest content's height. Each sheet's bottom margin
  // shrinks by one strip per sheet, so all margin boxes end on one line: the pile holds while
  // the last sheet is read (the dwell after it, `.pile::after`) and then leaves as one. A covered
  // sheet steps back a little, leans about its title's corner like loose paper, and its content
  // fades before the incoming edge reaches it (a half-faded body sliced by an edge read as a
  // glitch). Where four strips plus a sheet don't fit under the top bar (short windows), the
  // sheets just follow each other: slivers of tabs read as broken. A covered sheet is a tab: a
  // click on it brings it back. No movement with reduced motion.
  const pile = document.querySelector<HTMLElement>("[data-kk]");
  const sheets = [...document.querySelectorAll<HTMLElement>("[data-kk-panel]")];
  if (pile && sheets.length) {
    const fades = sheets.map((s) => [...s.querySelectorAll<HTMLElement>("[data-kk-fade]")]);
    const metas = sheets.map((s) => s.querySelector<HTMLElement>(".sheet-meta")!);
    const topBar = document.querySelector<HTMLElement>(".top");
    const wide = matchMedia("(min-width: 56rem)");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    // the lean of a covered sheet in degrees, alternating (more ate the strips' right ends)
    const LEAN = [-0.6, 0.5, -0.45, 0.6];
    const n = sheets.length;
    // the pile's spacing steps, roomy to tight (CSS `.is-pile[data-fit]`)
    const FITS = ["", "snug", "tight"];
    let on = false;
    let H = 0;
    let tab = 0;
    let tops: number[] = [];
    let gaps: number[] = [];

    const off = () => {
      on = false;
      pile.classList.remove("is-pile");
      delete pile.dataset.fit;
      pile.style.removeProperty("--kk-h");
      pile.style.removeProperty("--kk-meta");
      sheets.forEach((s) => {
        s.style.removeProperty("--stick");
        s.style.removeProperty("--gap");
        s.style.scrollMarginTop = "";
      });
    };

    const layout = () => {
      off();
      if (wide.matches) {
        const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
        const base = topBar ? topBar.getBoundingClientRect().height : 0;
        // measure the natural heights in pile style, roomy first, then tighter (`data-fit`) until
        // the pile fits: laptop windows are often only 600-730px tall under the browser's bars.
        // No transitions while measuring: with reduced motion global.css gives every element a
        // 0.01ms one, and the old spacing would be measured.
        pile.classList.add("is-pile", "is-measuring");
        let air = rem;
        for (const fit of FITS) {
          if (fit) pile.dataset.fit = fit;
          else delete pile.dataset.fit;
          air = fit ? rem / 2 : rem;
          // the software block one height on every sheet, so "Software" stands at one place
          pile.style.removeProperty("--kk-meta");
          const metaH = Math.max(...metas.map((m) => m.offsetHeight));
          pile.style.setProperty("--kk-meta", `${metaH}px`);
          tab =sheets[0].querySelector<HTMLElement>(".sheet-head")!.offsetHeight;
          H = Math.ceil(Math.max(...sheets.map((s) => s.offsetHeight)));
          if (base + air + (n - 1) * tab + H <= innerHeight - air) {
            on = true;
            break;
          }
        }
        pile.classList.remove("is-measuring");
        if (on) {
          pile.style.setProperty("--kk-h", `${H}px`);
          const sp = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
          tops = sheets.map((_, i) => Math.round(base + air + i * tab));
          // the way the next sheet travels before it touches this one, plus the strips still to come
          gaps = sheets.map((_, i) => Math.round(2 * rem + (n - 1 - i) * tab));
          sheets.forEach((s, i) => {
            s.style.setProperty("--stick", `${tops[i]}px`);
            s.style.setProperty("--gap", `${gaps[i]}px`);
            // an anchor to a sheet lands where it has just pinned
            s.style.scrollMarginTop = `${tops[i] - sp}px`;
          });
        } else {
          pile.classList.remove("is-pile");
          delete pile.dataset.fit;
        }
      }
      update();
    };

    const natural = (i: number) =>
      pile.getBoundingClientRect().top + scrollY + i * H + gaps.slice(0, i).reduce((a, g) => a + g, 0);
    const pinnedAt = (i: number) => natural(i) - tops[i];

    // how far sheet j has come up onto sheet j-1: 0 while it is a gap below it, 1 pinned
    const arrived = (j: number) => {
      const from = tops[j - 1] + H + gaps[j - 1];
      const to = tops[j];
      const t = sheets[j].getBoundingClientRect().top;
      return Math.min(Math.max((from - t) / Math.max(from - to, 1), 0), 1);
    };

    const update = () => {
      const still = !on || reduce.matches;
      sheets.forEach((s, i) => {
        let depth = 0;
        if (on) for (let j = i + 1; j < n; j++) depth += arrived(j);
        s.classList.toggle("is-under", on && depth > 0.95);
        const d = Math.min(depth, 1);
        if (still || d < 0.002) {
          s.style.transform = "";
          fades[i].forEach((f) => (f.style.opacity = ""));
          return;
        }
        // scale and lean about the title strip's top-left corner, so the strip stays put
        const scale = 1 - 0.03 * d - 0.01 * Math.max(depth - 1, 0);
        s.style.transform = `scale(${scale.toFixed(4)}) rotate(${(LEAN[i % LEAN.length] * d).toFixed(3)}deg)`;
        // the body is gone by 55 % of the cover, before the incoming edge slices much of it
        const fade = Math.min(Math.max((d - 0.1) / 0.45, 0), 1);
        fades[i].forEach((f) => (f.style.opacity = (1 - fade).toFixed(3)));
      });
    };

    const toSheet = (i: number) => scrollTo({ top: pinnedAt(i), behavior: reduce.matches ? "auto" : "smooth" });

    // a covered sheet is a tab: a click anywhere on it brings it back (its title link too)
    document.addEventListener("click", (e) => {
      if (!on || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      const target = e.target as HTMLElement;
      const a = target.closest<HTMLAnchorElement>('a[href^="#kk-"]');
      const tabbed = target.closest<HTMLElement>(".sheet.is-under");
      let i = a ? sheets.findIndex((s) => `#${s.id}` === a.getAttribute("href")) : -1;
      if (i < 0 && tabbed && !target.closest("a")) i = sheets.indexOf(tabbed);
      if (i < 0) return;
      e.preventDefault();
      const hash = `#${sheets[i].id}`;
      if (location.hash !== hash) history.pushState(null, "", hash);
      toSheet(i);
    });
    const fromHash = () => {
      const i = sheets.findIndex((s) => `#${s.id}` === location.hash);
      if (i >= 0 && on) toSheet(i);
    };
    addEventListener("hashchange", fromHash);
    addEventListener("popstate", fromHash);

    // keyboard focus in a covered sheet (Shift+Tab): bring that sheet back
    pile.addEventListener("focusin", (e) => {
      const el = e.target as HTMLElement;
      if (!on || !el.matches(":focus-visible")) return;
      const s = el.closest<HTMLElement>("[data-kk-panel]");
      if (!s) return;
      const i = sheets.indexOf(s);
      requestAnimationFrame(() => {
        const r = el.getBoundingClientRect();
        const next = sheets[i + 1]?.getBoundingClientRect().top ?? Infinity;
        if (r.bottom <= next && r.top >= tops[i] && !s.classList.contains("is-under")) return;
        scrollTo({ top: pinnedAt(i), behavior: "auto" });
      });
    });

    let raf = 0;
    addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(update);
      },
      { passive: true },
    );
    addEventListener("resize", layout);
    wide.addEventListener("change", layout);
    document.fonts?.ready.then(layout);
    layout();

    // a fresh visit to /#kk-…: the browser scrolled before the sticky tops existed
    // (a reload or Back restores its saved position instead, see Werdegang)
    const atLoad = sheets.findIndex((s) => `#${s.id}` === location.hash);
    if (atLoad >= 0 && typeof history.state?.wdY !== "number") {
      document.fonts?.ready.then(() => {
        layout();
        if (on) scrollTo(0, pinnedAt(atLoad));
      });
    }
  }
</script>


<style>
  /* ---------- hero: the heliostat field, name and role in its sky ---------- */
  .hero-text {
    /* the name's size and the top padding, shared with the portrait that lines up with it */
    --fs: clamp(3.25rem, 1.4rem + 8vw, 8rem);
    --pt: clamp(1.5rem, 0.8rem + 2.6vw, 3rem);
    padding-top: var(--pt);
  }

  /* the name in the content serif (owner's pick 2026-10-01, the heavy grotesk read clunky) */
  .hero-name {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: var(--fs);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-role {
    margin-top: 1rem;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .hero-claim {
    margin-top: 1.1rem;
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.125rem, 0.95rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 24em;
    text-wrap: pretty;
  }

  /* The portrait directly beside the name (owner 2026-10-02): cut out of its studio
     background, exactly as tall as the name, with a hard foot. Behind
     the drawing layer (z-index -1 in the isolated field), so the sun passes over it. */
  .hero-head {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.5rem, 0.2rem + 1.5vw, 1.75rem);
  }

  .hero-photo {
    position: relative;
    z-index: -1;
    flex: none;
    /* from the cap height of "Daniel" to the baseline of "Lenski" (measured on the glyphs) */
    width: calc(1.59 * var(--fs));
    aspect-ratio: 1;
    margin-top: calc(-0.04 * var(--fs));
    /* no fade at the foot any more (owner 2026-10-06: a hard edge); clipped, so the intro
       moves the picture up out of its own bottom edge */
    overflow: hidden;
  }

  .hero-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The intro (owner 2026-10-06): the portrait comes up out of its bottom edge while the sun rises
     over the field (HeliostatField), both at about 0.3 s; name, role and claim stay still
     (a critic found their reveals the stock page-load intro). Once, not with reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo img {
      animation: hero-up 1.1s cubic-bezier(0.2, 0.7, 0.1, 1) 0.3s both;
    }
  }

  @keyframes hero-up {
    from {
      transform: translateY(20%);
      opacity: 0;
    }
  }

  @media (min-width: 48rem) {
    .hero-claim {
      max-width: 30em;
    }
  }

  /* From 64rem the text is one row of one height (owner 2026-10-06: everything lined up,
     filling the first screen): name and portrait on the left; role and claim on the right,
     the role's first line on the cap height of "Daniel", the claim's last line on the
     baseline of "Lenski". The drawing below lines up with the same column (HeliostatField
     fit()). The name's size follows the window height too, so text and drawing share the
     first screen. (Until 2026-10-06 the claim stood in the sky over the drawing from 80rem.) */
  @media (min-width: 64rem) {
    .hero-text {
      --fs: clamp(5rem, min(1.4rem + 8vw, 20svh), 12rem);
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 6rem);
    }
    .hero-head {
      grid-row: 1 / 3;
    }
    .hero-role {
      grid-column: 2;
      align-self: start;
      /* the first line's cap height on the name's (0.04 fs above the h1's box; 0.42em: this
         line's own half-leading and space above the caps) */
      margin-top: calc(-0.04 * var(--fs) - 0.42em);
    }
    .hero-claim {
      grid-column: 2;
      align-self: end;
      /* the last line's baseline on the name's (0.21 fs above the h1's box bottom; 0.36em:
         this line's descent and half-leading) */
      margin: 0 0 calc(0.21 * var(--fs) - 0.36em);
      /* large enough to own the column between the role and the name's baseline (a critic
         found a normal-sized claim there left a hole, "two leftovers") */
      font-size: clamp(1.5rem, 0.2 * var(--fs), 2.75rem);
      line-height: 1.22;
      max-width: 20em;
    }
  }


  /* ---------- Kernkompetenzen: a pile of sheets ---------- */
  .kk {
    /* no top rule: the field's ground line closes the hero */
    padding: var(--sp-section) 0 var(--sp-block);
    /* a jump here puts the section right under the top bar: the root scroll padding (4.5 / 5rem)
       is taller than the bar (3.5 / 3.75rem + its rule), which left a strip of the hero's ground
       line and mirror posts showing under the bar like a second rule */
    scroll-margin-top: calc(1.5px - 1rem);
  }

  @media (min-width: 64rem) {
    .kk {
      scroll-margin-top: calc(1.5px - 1.25rem);
    }
  }

  .kk-head {
    margin-bottom: var(--sp-gap);
  }

  /* Without the pile (phones, short windows, no JS) the skills simply follow each other on the
     page, no box: each opens with the 1.5px ink rule over its title strip (a stack of boxed
     cards was the v2 tell) */
  .pile {
    display: grid;
    gap: var(--sp-block);
  }

  .sheet {
    --pad: clamp(1.25rem, 0.8rem + 1.5vw, 2.25rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    border-top: 1.5px solid var(--ink);
  }

  /* the title strip: the part of a covered sheet that stays in view; the counter right after
     the title, on its baseline (at the far end the lean of the pile swung it under the next tab) */
  .sheet-head {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .sheet-title {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: clamp(1.5rem, 1rem + 1.2vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    hyphens: manual;
    overflow-wrap: anywhere;
  }

  .sheet-title a {
    color: inherit;
    text-decoration: none;
  }

  .sheet-title a:hover {
    text-decoration: underline 2px;
    text-underline-offset: 0.15em;
  }

  .sheet-of {
    flex: none;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .sheet-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-top: 1.25rem;
  }

  /* main points in the serif with an ink disc; their sub-points smaller in the grotesk, the
     steel tick hanging in the disc's gutter, so markers and text keep two edges */
  .proof {
    display: grid;
    gap: 1.1rem;
  }

  .proof > li {
    position: relative;
    padding-left: 1.1rem;
  }

  .proof > li::before {
    content: "";
    position: absolute;
    left: 0.1rem;
    top: 0.56em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .proof-main {
    display: block;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.4;
    text-wrap: pretty;
  }

  .proof-sub {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.45rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .proof-sub li {
    position: relative;
    text-wrap: pretty;
  }

  .proof-sub li::before {
    content: "";
    position: absolute;
    left: -1.1rem;
    top: 0.72em;
    width: 0.55rem;
    border-top: 1.5px solid var(--steel);
  }

  /* software and where it comes from, under the points (in the tightest pile: under the picture) */
  .sheet-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    margin-top: var(--sp-gap);
    padding: 1rem 0 1.25rem;
    border-top: 1px solid var(--line);
  }

  /* "Software" over the logos */
  .sw {
    display: grid;
    gap: 0.4rem;
  }

  /* the picture on its own light ground, a panel set off by a hairline; its edges fade into
     that ground (owner 2026-10-03: no hard edge around the drawing) */
  .sheet-pic {
    --pic-bg: #f0f2f4;
    position: relative;
    isolation: isolate;
    aspect-ratio: 520 / 351;
    max-height: 14rem;
    background: var(--pic-bg);
    overflow: hidden;
  }

  /* the whole picture, never cropped (the drawings have their subject everywhere), at most
     42rem wide (they are only ~520px and go soft when blown up) */
  .sheet-pic img {
    position: absolute;
    inset: 1rem;
    display: block;
    width: min(100% - 2rem, 42rem);
    height: calc(100% - 2rem);
    margin-inline: auto;
