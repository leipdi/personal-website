---
import Layout from "../layouts/Layout.astro";
import Placeholder from "../components/Placeholder.astro";
import HeliostatField from "../components/figures/HeliostatField.astro";
import { profile, topSkills, type TopSkillId } from "../data/cv";
import { tool, uniqueSvg } from "../data/tools";
import { cvPdf } from "../data/nav";

// line icons for the box heads (24px grid, drawn at 28px with a 2px stroke)
const skillIcons: Record<TopSkillId, string> = {
  // calculator
  kosten:
    "M6 3h12a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm2 3h8v3H8V6Zm0 7h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01",
  // a data table feeding a report: plain, no AI sparkle trope
  data: "M3 4h11v16H3V4Zm0 5h11M3 14.5h11M8 9v11M17.5 20v-5M21 20V9",
  // two steps joined by a flow arrow
  prozesse: "M4 5h5v5H4V5Zm11 9h5v5h-5v-5ZM6.5 10v3a2 2 0 0 0 2 2H15m0 0-2-2m2 2-2 2",
  // bar chart on a baseline
  controlling: "M4 20h16M7 16v-5M11 16V8M15 16v-3M19 16V5",
};

// Long German compounds get soft hyphens for display only (the data keeps the plain word),
// so a narrow box breaks "Bauteilkostenkalkulation" at a word joint instead of overflowing.
const titleBreaks: Record<string, string> = {
  Bauteilkostenkalkulation: "Bauteil­kosten­kalkulation",
};
const displayTitle = (t: string) => titleBreaks[t] ?? t;

const [mailUser, mailDomain] = profile.email.split("@");
// neutral and factual (name, role, fields named in the CV): the AI-drafted claim must not end up in search results
const description = `${profile.name}, ${profile.role}, ${profile.location}. Herstellkostenrechnung, Ökobilanz (LCA) und BI Consulting mit Power BI und Jedox.`;
---

<Layout title="Daniel Lenski, Wirtschaftsingenieur" description={description} active="uebersicht">
  <section class="hero" aria-labelledby="name">
    <HeliostatField>
      <div class="wrap hero-text">
        <h1 id="name" class="display hero-name">Daniel<br />Lenski</h1>
        <p class="hero-role">{profile.role}<br />{profile.location}</p>
      </div>
    </HeliostatField>
    <div class="wrap intro">
      <p class="intro-claim"><Placeholder inline>{profile.claim}</Placeholder></p>
      <div class="intro-photo">
        <img src="/img/daniel-lenski.jpg" alt="Porträt von Daniel Lenski" width="400" height="400" />
      </div>
    </div>
  </section>

  <!-- Skill hub: one box per core skill: what he did with it (proof), the software, where it comes from -->
  <section class="hub" aria-labelledby="h-hub">
    <div class="wrap">
      <h2 id="h-hub" class="hub-title">Kernkompetenzen</h2>
      <Placeholder
        kind="vorschlag"
        note="Belegzeilen und Zuordnung von Stationen und Software KI-abgeleitet; gestrichelte Logos sind Logo-Platzhalter"
      >
        <ul class="hub-grid">
          {
            topSkills.map((s) => (
              <li class="skill" aria-labelledby={`sk-${s.id}`}>
                <div class="skill-body">
                  <div class="skill-head">
                    <svg
                      class="skill-ico"
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      width="28"
                      height="28"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={skillIcons[s.id]} />
                    </svg>
                    <h3 id={`sk-${s.id}`} class="skill-title">
                      {displayTitle(s.title)}
                    </h3>
                  </div>
                  <div class="text skill-proof">
                    {s.proof.map((line) => (
                      <p>{line}</p>
                    ))}
                  </div>
                </div>
                <div class="skill-foot">
                  <p class="lbl">
                    Software
                  </p>
                  {s.tools.length > 0 && (
                    <ul class="tools">
                      {s.tools.map((key) => {
                        const t = tool(key);
                        return t.svg ? (
                          <li class="tool">
                            <span class="tool-logo" aria-hidden="true" set:html={uniqueSvg(t.svg, s.id)} />
                            <span class="tool-name">{t.name}</span>
                          </li>
                        ) : (
                          <li class="tool tool-ph" data-placeholder="logo">
                            <span class="tool-mono" aria-hidden="true">
                              {t.mono}
                            </span>
                            <span class="tool-name">{t.name}</span>
                            <span class="sr-only"> (Logo-Platzhalter)</span>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                  {s.toolsQuestion && <p class="tools-open">{s.toolsQuestion}</p>}
                  <p class="skill-src">
                    <span class="lbl">Gelernt bei</span>{" "}
                    {s.learned.map((l, i) => (
                      <>
                        {i > 0 && ", "}
                        <a href={l.href}>{l.label}</a>
                      </>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </Placeholder>
    </div>
  </section>

  <section class="end" aria-labelledby="h-end">
    <div class="wrap end-in">
      <h2 id="h-end" class="end-line">
        Am einfachsten per <span class="nobr">E-Mail:</span>{" "}
        <a class="end-mail" href={`mailto:${profile.email}`}>{mailUser}<wbr />@{mailDomain}</a>
      </h2>
      <p class="end-links">
        <a class="prose-link" href={profile.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="prose-link" href={cvPdf} target="_blank" rel="noreferrer">Lebenslauf (PDF)</a>
        <a class="prose-link" href="/kontakt/">Alle Kontaktdaten</a>
      </p>
    </div>
  </section>
</Layout>


<style>
  /* ---------- hero: the heliostat field, name and role in its sky ---------- */
  .hero-text {
    padding-top: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }

  .hero-name {
    font-size: clamp(3.5rem, 1.5rem + 9vw, 9rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
    color: var(--ink);
  }

  .hero-role {
    margin-top: 1rem;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-2);
  }

  /* ---------- intro under the ground line: claim and portrait side by side ---------- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "claim photo";
    align-items: start;
    gap: 1.25rem;
    padding-top: 1.75rem;
    padding-bottom: 2.5rem;
  }

  /* small phones: a claim squeezed beside the portrait ran to 12 lines; stack them */
  @media (max-width: 25.99rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "claim"
        "photo";
    }
  }

  .intro-claim {
    grid-area: claim;
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    /* short measure, and no single word left hanging on the last line */
    max-width: 22em;
    text-wrap: pretty;
  }

  .intro-photo {
    grid-area: photo;
    width: clamp(6.5rem, 26vw, 12.5rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1.5px solid var(--ink);
    background: var(--paper);
  }

  /* the source JPEG has a light 1-2px column at its left edge: shift it out of the frame */
  .intro-photo img {
    display: block;
    width: calc(100% + 3px);
    max-width: none;
    height: auto;
    margin-left: -3px;
  }

  @media (min-width: 48rem) {
    /* close under the ground line, so name, field and claim read as one screen */
    .intro {
      column-gap: 3rem;
      padding-top: 1.25rem;
      padding-bottom: 3.5rem;
    }
  }

  /* ---------- skill hub: white boxes on the steel page, just an even frame ---------- */
  .hub {
    padding: 3rem 0 4rem;
    border-top: 1.5px solid var(--ink);
  }

  /* section head: a quiet grotesk label, not display */
  .hub-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem 1.5rem;
  }

  @media (min-width: 44rem) {
    .hub-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* each box is a 2-row subgrid (body, footer): footers start level across a row;
     minmax(0, 1fr): a long title can never widen the box past its grid cell */
  .skill {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .skill:hover,
  .skill:focus-within {
    border-color: var(--ink);
  }

  .skill-body {
    min-width: 0;
    padding: 1.1rem 1.1rem 1.25rem;
  }

  .skill-foot {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem 1.1rem 1.1rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 44rem) {
    .skill-body {
      padding: 1.35rem 1.5rem 1.5rem;
    }
    .skill-foot {
      padding: 1.1rem 1.5rem 1.2rem;
    }
  }

  .skill-head {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }

  .skill-ico {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--ink);
  }

  .skill-title {
    min-width: 0;
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: normal;
    line-height: 1.15;
    padding-top: 0;
    color: var(--ink);
    hyphens: manual;
    overflow-wrap: anywhere;
  }

  .skill-proof {
    font-size: 1.0625rem;
    line-height: 1.5;
    max-width: 36rem;
  }

  .skill-proof p + p {
    margin-top: 0.4rem;
  }

  .lbl {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  .skill-foot > .lbl {
    margin-bottom: -0.35rem;
    text-align: center;
  }

  /* logos with their names centred in the box (owner, 2026-09-25) */
  .tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.1rem 0.5rem;
  }

  .tools > li {
    flex: 0 0 6rem;
  }

  .tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    text-align: center;
  }

  .tool-name {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .tool-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.25rem;
    max-width: 100%;
  }

  .tool-logo :global(svg) {
    display: block;
    height: 100%;
    width: auto;
    max-width: 100%;
  }

  /* no free logo available: dashed magenta outline monogram = marked logo placeholder */
  .tool-mono {
    display: grid;
    place-items: center;
    min-width: 3.25rem;
    height: 3.25rem;
    padding: 0 0.2rem;
    border: 1.5px dashed var(--ph);
    border-radius: 4px;
    color: var(--ph);
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .tools-open {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ph);
    background: var(--paper);
    border: 1.5px dashed var(--ph);
    border-radius: 3px;
    padding: 0.45rem 0.7rem;
    max-width: 30rem;
    overflow-wrap: anywhere;
  }

  .skill-src {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-2);
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .skill-src a:focus-visible {
    outline-offset: 1px;
  }

  .skill-src a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--steel);
  }

  .skill-src a:hover {
    color: var(--ink);
    text-decoration-thickness: 3px;
    text-decoration-color: var(--ink);
  }

  /* ---------- ending: one line to get in touch, on the quiet wash band ---------- */
  :global(main.content#inhalt) {
    padding-bottom: 0;
  }

  .end {
    background: var(--wash);
    border-top: 1.5px solid var(--ink);
    padding: 2.75rem 0 calc(2.25rem + 4.75rem + env(safe-area-inset-bottom));
  }

  @media (min-width: 64rem) {
    .end {
      padding: 3.5rem 0;
    }
  }

  .end-line {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    line-height: 1.25;
    max-width: 30ch;
  }

  .nobr {
    white-space: nowrap;
  }

  .end-mail {
    display: inline-block;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--steel);
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }

  .end-mail:hover {
    text-decoration-thickness: 5px;
    text-decoration-color: var(--ink);
  }

  .end-links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
</style>
